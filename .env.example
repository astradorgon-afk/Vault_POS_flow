# Copy to .env and replace every value. .env is git-ignored and must never be
# committed; production supplies these through Docker secrets instead.

# Owning database role. Used only by the migration job.
POSTGRES_PASSWORD=change-me-migrator

# Least-privilege application role. Has no DDL rights and cannot update or
# delete ledger rows.
POS_APP_PASSWORD=change-me-app

# Reporting role. Read-only.
POS_READONLY_PASSWORD=change-me-readonly

ASPNETCORE_ENVIRONMENT=Development
ORGANIZATION_TIMEZONE=Asia/Manila
ORGANIZATION_CURRENCY=PHP
