@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session

<div class="term-row">
    <label class="term-picker">
        <span>Register</span>
        <select value="@(selectedRegisterId?.ToString() ?? string.Empty)"
                @onchange="OnRegisterChangedAsync"
                disabled="@(registers.Count == 0 || startingShift)">
            <option value="">Select a register</option>
            @foreach (PosRegister register in registers)
            {
                <option value="@register.Id">@register.Name</option>
            }
        </select>
    </label>

    @if (terminalSession is not null && openShift is not null)
    {
        <span class="term-live" role="status">
            <strong>Shift open</strong>
            <em>@openShift.Number</em>
            <small>@openShift.CashierName · @openShift.BusinessDate.ToString("ddd, MMM d", CultureInfo.InvariantCulture) · Opening @Money(openShift.OpeningFloat)</small>
        </span>
    }
    else if (terminalSession is not null)
    {
        <label class="term-start">
            <span>Start shift · business date <strong>@terminalSession.BusinessDate.ToString("ddd, MMM d", CultureInfo.InvariantCulture)</strong></span>
            <div>
                <input type="number" min="0" step="0.01" value="@openingFloat" aria-label="Opening float"
                       @onchange="e => openingFloat = e.Value?.ToString() ?? string.Empty" />
                <button type="button" @onclick="StartShiftAsync" disabled="@startingShift">
                    @(startingShift ? "Opening…" : "Start shift")
                </button>
            </div>
        </label>
    }

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <span class="term-error" role="alert">@Error</span>
    }
</div>

@code {
    private readonly List<PosRegister> registers = [];
    private Guid? selectedRegisterId;
    private PosTerminalSession? terminalSession;
    private PosOpenShift? openShift;
    private string openingFloat = "0";
    private bool startingShift;
    private Guid lastLocationId;
    private string? Error { get; set; }

    /// <summary>Gets the store this bar operates registers for.</summary>
    [Parameter, EditorRequired]
    public Guid LocationId { get; set; }

    /// <summary>Raised whenever the selected register or shift changes, so the
    /// host can refresh its action enablement from the session.</summary>
    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (LocationId != lastLocationId)
        {
            lastLocationId = LocationId;
            await LoadContextAsync();
        }
    }

    private async Task LoadContextAsync()
    {
        Error = null;
        try
        {
            ApiResult<List<PosRegister>> response = await Api.GetRegistersAsync(LocationId, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { Error = response.Error; return; }

            registers.Clear();
            registers.AddRange(response.Value);

            PosRegister? current = registers.FirstOrDefault(register => Session.DeviceId == register.Id);
            if (current is not null)
            {
                // The circuit is already registered here; refresh its terminal state.
                await SelectRegisterAsync(current);
            }
            else
            {
                if (Session.DeviceId is not null)
                {
                    Session.ClearRegister();
                    selectedRegisterId = null;
                    terminalSession = null;
                    openShift = null;
                }

                if (registers.Count == 1)
                {
                    await SelectRegisterAsync(registers[0]);
                }
                else
                {
                    await OnStateChanged.InvokeAsync();
                }
            }
        }
        catch (HttpRequestException) { Error = "The register service is unavailable. Try again shortly."; }
    }

    private async Task OnRegisterChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out Guid id)) return;
        PosRegister? register = registers.FirstOrDefault(r => r.Id == id);
        if (register is not null) { await SelectRegisterAsync(register); }
    }

    private async Task SelectRegisterAsync(PosRegister register)
    {
        Session.SetRegister(register);
        selectedRegisterId = register.Id;
        await LoadSessionAsync();
        await OnStateChanged.InvokeAsync();
    }

    private async Task LoadSessionAsync()
    {
        if (Session.DeviceId is null)
        {
            terminalSession = null;
            openShift = null;
            return;
        }

        try
        {
            ApiResult<PosTerminalSession> response = await Api.GetTerminalSessionAsync(LocationId, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { Error = response.Error; return; }

            terminalSession = response.Value;
            openShift = response.Value.OpenShift;
            Session.SetTerminal(response.Value);
        }
        catch (HttpRequestException) { Error = "The terminal session is unavailable. Try again shortly."; }
    }

    private async Task StartShiftAsync()
    {
        if (terminalSession is null) return;
        if (!decimal.TryParse(openingFloat, out decimal floatAmount) || floatAmount < 0m)
        {
            Error = "Enter a valid opening float.";
            return;
        }

        startingShift = true;
        Error = null;
        try
        {
            ApiResult<PosNextNumber> number = await Api.PostNextNumberAsync(
                LocationId, "SHF", CancellationToken.None);
            if (!number.IsSuccess || number.Value is null) { Error = number.Error; return; }

            ApiResult<PosShiftReference> opened = await Api.OpenShiftAsync(
                LocationId, number.Value.Number, terminalSession.BusinessDate, floatAmount, CancellationToken.None);
            if (!opened.IsSuccess || opened.Value is null) { Error = opened.Error; return; }

            await LoadSessionAsync();
            await OnStateChanged.InvokeAsync();
        }
        catch (HttpRequestException) { Error = "The shift service is unavailable. Try again shortly."; }
        finally { startingShift = false; }
    }

    private static string Money(decimal value)
        => value.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-PH"));
}