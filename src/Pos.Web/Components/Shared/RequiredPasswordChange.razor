@inject VaultFlowApiClient Api

@* Opens over the sign-in form when the account is still on its default
   password. The API issues no session until this succeeds. *@
<div class="offline-setup-backdrop" style="position:fixed;inset:0;z-index:2147483647;display:grid;place-items:center;overflow-y:auto;padding:12px;background:rgba(13,35,24,.64)">
    <section class="offline-setup-dialog" style="box-sizing:border-box;width:min(100%,480px);max-height:calc(100dvh - 24px);overflow-y:auto;padding:24px;border:1px solid #dce3dc;border-radius:18px;background:#f7f8f5;color:#17211c;box-shadow:0 24px 80px rgba(10,27,18,.26)" role="dialog" aria-modal="true" aria-labelledby="new-password-title" aria-describedby="new-password-description">
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <span class="eyebrow">First sign-in</span>
            <h2 id="new-password-title">Set a new password</h2>
            <p id="new-password-description"><strong>@UserName</strong> is still using the default password. Choose your own before you continue.</p>
            @if (!string.IsNullOrWhiteSpace(error)) { <div class="form-error" role="alert">@error</div> }
            <label for="new-password">New password</label>
            <div class="password-field">
                <input id="new-password" name="new-password" type="@(showPassword ? "text" : "password")" autocomplete="new-password" autocapitalize="off" spellcheck="false" required autofocus @bind="newPassword" @bind:event="oninput" disabled="@busy" />
                <button type="button" class="password-toggle" title="@(showPassword ? "Hide password" : "Show password")" aria-pressed="@showPassword" aria-label="@(showPassword ? "Hide password" : "Show password")" @onclick="() => showPassword = !showPassword">
                    @if (showPassword)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18" /><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" /><path d="M9.4 5.2A9.4 9.4 0 0 1 12 5c6.4 0 10 7 10 7a17.8 17.8 0 0 1-3.2 4.1" /><path d="M6.2 6.2A17.4 17.4 0 0 0 2 12s3.6 7 10 7a9.3 9.3 0 0 0 3.9-.8" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    }
                </button>
            </div>
            <label for="confirm-password">Confirm new password</label>
            <input id="confirm-password" name="confirm-password" type="@(showPassword ? "text" : "password")" autocomplete="new-password" autocapitalize="off" spellcheck="false" required @bind="confirmPassword" @bind:event="oninput" disabled="@busy" />
            <button type="submit" class="offline-setup-submit" disabled="@busy">@(busy ? "Saving…" : "Save password and sign in")</button>
            <button type="button" class="login-continue" @onclick="OnCancel" disabled="@busy">Back to sign in</button>
        </form>
    </section>
</div>

@code {
    /// <summary>The account being changed.</summary>
    [Parameter, EditorRequired] public string UserName { get; set; } = string.Empty;

    /// <summary>The default password the account signed in with.</summary>
    [Parameter, EditorRequired] public string CurrentPassword { get; set; } = string.Empty;

    /// <summary>Called with the new password once the API has accepted it.</summary>
    [Parameter] public EventCallback<string> OnChanged { get; set; }

    /// <summary>Called when the operator goes back to the sign-in form.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool busy;
    private bool showPassword;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? error;

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        error = null;
        if (!string.Equals(newPassword, confirmPassword, StringComparison.Ordinal))
        {
            error = "The two passwords do not match.";
            return;
        }

        busy = true;
        try
        {
            ApiResult<bool> result = await Api.ChangeRequiredPasswordAsync(UserName, CurrentPassword, newPassword, CancellationToken.None);
            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }
        }
        finally
        {
            busy = false;
        }

        await OnChanged.InvokeAsync(newPassword);
    }
}
