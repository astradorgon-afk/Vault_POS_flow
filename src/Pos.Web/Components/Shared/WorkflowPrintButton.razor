@using System.Net
@using System.Text
@inject IJSRuntime Js

<button type="button" class="workflow-print-button" @onclick="PrintAsync" disabled="@Disabled">
    @ButtonLabel
</button>

@code {
    [Parameter, EditorRequired] public WorkflowReceipt Document { get; set; } = default!;
    [Parameter] public string ButtonLabel { get; set; } = "Print receipt";
    [Parameter] public bool Disabled { get; set; }

    private async Task PrintAsync()
    {
        if (Disabled || Document is null)
        {
            return;
        }

        await Js.InvokeVoidAsync("vaultflowPrintReceipt", BuildHtml(Document));
    }

    private static string BuildHtml(WorkflowReceipt document)
    {
        StringBuilder html = new();
        html.Append("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>");
        html.Append(Encode(document.Title));
        html.Append(" - VaultFlow</title><style>");
        html.Append("""
            :root { color-scheme: light; }
            * { box-sizing: border-box; }
            html, body { margin: 0; padding: 0; }
            @page { size: 80mm auto; margin: 4mm; }
            body { background: #fff; color: #111; font: 12px/1.4 'Courier New', Courier, monospace; }
            .receipt { width: 72mm; margin: 0 auto; }
            .receipt-head { margin-bottom: 3mm; text-align: center; }
            .brand { font-size: 13px; font-weight: bold; }
            .receipt-head h1 { margin: 1mm 0; font-size: 14px; letter-spacing: .06em; line-height: 1.3; text-transform: uppercase; overflow-wrap: anywhere; }
            .number { margin-bottom: 1mm; font-weight: bold; overflow-wrap: anywhere; }
            .meta span { display: block; overflow-wrap: anywhere; }
            .route span { display: block; overflow-wrap: anywhere; }
            .route strong { font-weight: bold; }
            .seal { margin: 2.5mm 0; border: 0; border-top: 1px dashed #333; }
            .line { padding: 1mm 0; break-inside: avoid; }
            .product { font-weight: bold; overflow-wrap: anywhere; }
            .code { color: #333; font-size: 10px; overflow-wrap: anywhere; }
            .quantities { display: grid; gap: .5mm; margin-top: 1mm; }
            .quantity { display: flex; justify-content: space-between; gap: 2mm; font-size: 11px; }
            .quantity span { min-width: 0; overflow-wrap: anywhere; }
            .quantity strong { flex: 0 0 auto; text-align: right; }
            .empty { padding: 3mm 0; text-align: center; }
            footer { margin-top: 3mm; text-align: center; }
            @media print { .receipt { width: 72mm; margin: 0 auto; } }
            """);
        html.Append("</style></head><body><main class=\"receipt\"><header class=\"receipt-head\"><div class=\"brand\">VaultFlow</div><div>Operations ledger</div><h1>");
        html.Append(Encode(document.Title));
        html.Append("</h1><div class=\"number\">");
        html.Append(Encode(document.Number));
        html.Append("</div><div class=\"meta\"><span>Status: ");
        html.Append(Encode(document.Status));
        html.Append("</span><span>");
        html.Append(Encode(document.PrimaryDateHeading));
        html.Append(": ");
        html.Append(Encode(document.PrimaryDate));
        html.Append("</span>");
        if (!string.IsNullOrWhiteSpace(document.SecondaryDateHeading))
        {
            html.Append("<span>");
            html.Append(Encode(document.SecondaryDateHeading));
            html.Append(": ");
            html.Append(Encode(document.SecondaryDate));
            html.Append("</span>");
        }

        html.Append("</div></header><hr class=\"seal\"><section class=\"route\" aria-label=\"Movement route\"><span><strong>");
        html.Append(Encode(document.SourceHeading));
        html.Append(":</strong> ");
        html.Append(Encode(document.SourceName));
        html.Append("</span><span><strong>");
        html.Append(Encode(document.DestinationHeading));
        html.Append(":</strong> ");
        html.Append(Encode(document.DestinationName));
        html.Append("</span></section><hr class=\"seal\"><section class=\"items\" aria-label=\"Products\">");
        if (document.Lines.Count == 0)
        {
            html.Append("<div class=\"empty\">No product lines are recorded.</div>");
        }
        else
        {
            foreach (WorkflowReceiptLine line in document.Lines)
            {
                html.Append("<article class=\"line\"><div class=\"product\">");
                html.Append(Encode(line.ProductName));
                html.Append("</div>");
                if (!string.IsNullOrWhiteSpace(line.ProductCode))
                {
                    html.Append("<div class=\"code\">");
                    html.Append(Encode(line.ProductCode));
                    html.Append("</div>");
                }

                html.Append("<div class=\"quantities\">");
                for (int index = 0; index < document.QuantityHeadings.Count; index++)
                {
                    html.Append("<div class=\"quantity\"><span>");
                    html.Append(Encode(document.QuantityHeadings[index]));
                    html.Append("</span><strong>");
                    html.Append(Encode(index < line.Quantities.Count ? line.Quantities[index] : "—"));
                    html.Append("</strong></div>");
                }

                html.Append("</div></article><hr class=\"seal\">");
            }
        }

        html.Append("</section><footer>VaultFlow inventory copy</footer></main></body></html>");
        return html.ToString();
    }

    private static string Encode(string? value) => WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "—" : value);
}
