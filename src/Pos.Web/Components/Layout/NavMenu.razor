@inject VaultFlowAuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject NotificationStore Notifications

<div class="brand-block">
    <a class="brand" href=""><span class="brand-glyph" aria-hidden="true">V</span><span><strong>VaultFlow</strong><small>Inventory command</small></span></a>
</div>

<nav class="nav-stack" aria-label="Primary navigation">
    <span class="nav-heading">Workspace</span>
    <NavLink class="nav-link" href="notifications"><span aria-hidden="true">!</span> Notifications @if (Notifications.UnreadCount > 0) { <small>@Notifications.UnreadCount</small> }</NavLink>
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span aria-hidden="true">⌂</span> Overview</NavLink>
    <span class="nav-heading">Point of sale</span>
    @if (CanCreateSale)
    {
        <NavLink class="nav-link" href="pos"><span aria-hidden="true">▤</span> New sale</NavLink>
    }
    else
    {
        <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">▤</span> New sale</span>
    }
    @if (CanViewSales)
    {
        <NavLink class="nav-link" href="sales"><span aria-hidden="true">◫</span> Sales</NavLink>
    }
    else
    {
        <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">◫</span> Sales</span>
    }
    @if (CanViewReceipts)
    {
        <NavLink class="nav-link" href="receipts"><span aria-hidden="true">☷</span> Receipts</NavLink>
    }
    else
    {
        <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">☷</span> Receipts</span>
    }
    <span class="nav-heading">Catalogue</span>
    @if (CanViewCatalog)
    {
        <NavLink class="nav-link" href="catalog/prices"><span aria-hidden="true">$</span> Prices</NavLink>
    }
    else
    {
        <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">$</span> Prices</span>
    }
    <span class="nav-heading">Operations</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">◇</span> Inventory</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">↧</span> Purchasing</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">⇄</span> Transfers <small>3</small></span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">⚠</span> Quarantine <small>2</small></span>
    <span class="nav-heading">Administration</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">◎</span> Locations</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">☰</span> People &amp; roles</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">▤</span> Devices</span>
</nav>

<AuthorizeView><Authorized><button class="sign-out" type="button" @onclick="SignOutAsync">Sign out</button></Authorized></AuthorizeView>

@code {
    [Inject] private UserSession Session { get; set; } = null!;
    private bool CanCreateSale => Session.Current?.User.Permissions.Contains("sale.create", StringComparer.Ordinal) == true;
    private bool CanViewSales => Session.Current?.User.Permissions.Contains("sale.view", StringComparer.Ordinal) == true;
    private bool CanViewCatalog => Session.Current?.User.Permissions.Contains("catalog.view", StringComparer.Ordinal) == true;
    private bool CanViewReceipts => Session.Current?.User.Permissions.Contains("receipt.view", StringComparer.Ordinal) == true;

    private async Task SignOutAsync()
    {
        await Notifications.StopAsync();
        Authentication.SignOut();
        Navigation.NavigateTo("/login");
    }
}
