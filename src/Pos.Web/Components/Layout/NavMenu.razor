@inject VaultFlowAuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject NotificationStore Notifications
@inject UserSession Session
@inject IJSRuntime JS
@implements IDisposable

<div class="brand-block">
    <a class="brand" href="" @onclick="NotifyNavigation">
        <span class="brand-glyph" aria-hidden="true">V</span>
        <span><strong>VaultFlow</strong><small>Operations ledger</small></span>
    </a>
    <button class="sidebar-close" type="button" aria-label="Close navigation" @onclick="NotifyNavigation"><AppIcon Name="close" /></button>
</div>

<nav class="nav-stack" aria-label="Primary navigation">
    <div class="nav-group">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="NotifyNavigation"><AppIcon Name="home" /> <span>Overview</span></NavLink>
        <NavLink class="nav-link" href="notifications" @onclick="NotifyNavigation">
            <AppIcon Name="bell" /> <span>Notifications</span>
            @if (Notifications.UnreadCount > 0)
            {
                <small>@Notifications.UnreadCount</small>
            }
        </NavLink>
    </div>

    @if (CanViewInventory || CanReceivePurchasing || CanViewExceptions)
    {
        <div class="nav-group">
            <span class="nav-heading">Stock</span>
            @if (CanViewInventory)
            {
                <NavLink class="nav-link" href="inventory/stock" @onclick="NotifyNavigation"><AppIcon Name="box" /> <span>Stock levels</span></NavLink>
                <NavLink class="nav-link" href="inventory/counts" @onclick="NotifyNavigation"><AppIcon Name="count" /> <span>Stock counts</span></NavLink>
            }
            @if (CanReceivePurchasing)
            {
                <NavLink class="nav-link" href="receiving" @onclick="NotifyNavigation"><AppIcon Name="receipt" /> <span>Goods receiving</span></NavLink>
            }
            @if (CanViewExceptions)
            {
                <NavLink class="nav-link" href="inventory/exceptions" @onclick="NotifyNavigation"><AppIcon Name="alert" /> <span>Failed attempts</span></NavLink>
            }
        </div>
    }

    @if (CanViewTransfers || CanApproveRestock || CanFulfillRestock || CanRequestRestock)
    {
        @* The role's own restock task comes first; Transfers is the full record. *@
        <div class="nav-group">
            <span class="nav-heading">Movement</span>
            @if (CanApproveRestock)
            {
                <NavLink class="nav-link" href="restock/approvals" @onclick="NotifyNavigation"><AppIcon Name="check" /> <span>Restock approvals</span></NavLink>
            }
            @if (CanFulfillRestock)
            {
                <NavLink class="nav-link" href="restock/fulfillment" @onclick="NotifyNavigation"><AppIcon Name="box-out" /> <span>Restock fulfillment</span></NavLink>
            }
            @if (CanRequestRestock && !CanApproveRestock)
            {
                <SectionNavLink class="nav-link" href="restock" Except="RestockSiblings" @onclick="NotifyNavigation"><AppIcon Name="box-in" /> <span>@RestockRequestLabel</span></SectionNavLink>
            }
            @if (CanViewTransfers)
            {
                <NavLink class="nav-link" href="transfers" @onclick="NotifyNavigation"><AppIcon Name="transfer" /> <span>All transfers</span></NavLink>
            }
        </div>
    }

    @if (CanViewSales || CanViewReports || CanViewTransfers)
    {
        <div class="nav-group">
            <span class="nav-heading">Sales &amp; reports</span>
            @if (CanViewSales)
            {
                <NavLink class="nav-link" href="sales" @onclick="NotifyNavigation"><AppIcon Name="ledger" /> <span>Sales ledger</span></NavLink>
            }
            @if (CanViewReports)
            {
                <NavLink class="nav-link" href="reports" @onclick="NotifyNavigation"><AppIcon Name="report" /> <span>Daily reports</span></NavLink>
            }
            @if (CanViewSales)
            {
                <NavLink class="nav-link" href="analytics/products" @onclick="NotifyNavigation"><AppIcon Name="trend-up" /> <span>Product analytics</span></NavLink>
            }
            @if (CanViewTransfers)
            {
                <NavLink class="nav-link" href="stores" @onclick="NotifyNavigation"><AppIcon Name="location" /> <span>Store movement</span></NavLink>
            }
        </div>
    }

    @if (CanViewCatalog || CanViewPurchasing)
    {
        <div class="nav-group">
            <span class="nav-heading">Catalogue &amp; buying</span>
            @if (CanViewCatalog)
            {
                <SectionNavLink class="nav-link" href="catalog" Except="CatalogSiblings" @onclick="NotifyNavigation"><AppIcon Name="list" /> <span>Products &amp; barcodes</span></SectionNavLink>
                <NavLink class="nav-link" href="catalog/change-requests" @onclick="NotifyNavigation"><AppIcon Name="check" /> <span>Catalogue approvals</span></NavLink>
            }
            @if (CanViewPurchasing)
            {
                <NavLink class="nav-link" href="purchasing" @onclick="NotifyNavigation"><AppIcon Name="receipt" /> <span>Purchase orders</span></NavLink>
            }
        </div>
    }

    @if (CanViewLocations || CanViewAdministration || CanManageDevices || CanManageSync || CanViewAudit)
    {
        <div class="nav-group">
            <span class="nav-heading">Administration</span>
            @if (CanViewAdministration)
            {
                <NavLink class="nav-link" href="admin/users" @onclick="NotifyNavigation"><AppIcon Name="people" /> <span>People &amp; roles</span></NavLink>
            }
            @if (CanViewLocations)
            {
                <NavLink class="nav-link" href="admin/locations" @onclick="NotifyNavigation"><AppIcon Name="location" /> <span>Locations</span></NavLink>
            }
            @if (CanManageDevices)
            {
                <NavLink class="nav-link" href="admin/devices" @onclick="NotifyNavigation"><AppIcon Name="device" /> <span>Devices</span></NavLink>
            }
            @if (CanManageSync)
            {
                <NavLink class="nav-link" href="sync/failures" @onclick="NotifyNavigation"><AppIcon Name="sync" /> <span>Sync failures</span></NavLink>
            }
            @if (CanViewAudit)
            {
                <NavLink class="nav-link" href="admin/audit" @onclick="NotifyNavigation"><AppIcon Name="clock" /> <span>Activity log</span></NavLink>
            }
        </div>
    }
</nav>

<AuthorizeView>
    <Authorized>
        <div class="sidebar-footer">
            <div><span>Signed in as</span><strong>@Session.Current?.User.DisplayName</strong></div>
            <button class="sign-out" type="button" @onclick="SignOutAsync"><AppIcon Name="logout" /> Sign out</button>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>Raised after a navigation choice so a mobile parent can close the drawer.</summary>
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    /// <summary>
    /// The unread pill reads the shared feed, so this menu has to repaint when
    /// the feed refreshes. Without the subscription the pill renders once at
    /// first paint — before the feed loads — and then either stays missing or
    /// keeps a stale number until something else happens to re-render it.
    /// </summary>
    protected override void OnInitialized() => Notifications.Changed += OnNotificationsChanged;

    private void OnNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    private bool CanViewSales => Session.HasPermission("sale.view");
    private bool CanViewInventory => Session.HasPermission("inventory.view");
    private bool CanViewTransfers => Session.HasPermission("transfer.view");

    private bool CanViewCatalog => Session.HasPermission("product.view");
    private bool CanApproveRestock => Session.HasPermission("transfer.approve") &&
        Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true;
    // Kind 1 is a store asking the warehouse for stock; kind 0 is the warehouse
    // asking the owner to buy. Different documents, same page, same right.
    private bool CanRequestRestock => Session.WorkLocationKind is 0 or 1 &&
        Session.HasPermission("transfer.request") && Session.HasPermission("transfer.view");
    private bool CanFulfillRestock => Session.WorkLocationKind == 0 &&
        Session.HasPermission("transfer.pick") && Session.HasPermission("transfer.dispatch") &&
        Session.Current?.User.Roles.Any(role => role is "MainInventoryManager" or "InventoryStaff") == true;
    private bool CanViewPurchasing => Session.HasPermission("purchase.view") &&
        Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true;
    private bool CanReceivePurchasing => Session.HasPermission("purchase.view") && Session.HasPermission("purchase.receive");
    private bool CanViewReports => Session.HasPermission("report.view");
    private bool CanViewExceptions => Session.HasPermission("inventory.view.all");
    private bool CanViewLocations => Session.HasPermission("location.manage");
    private bool CanManageDevices => Session.HasPermission("device.manage");
    private bool CanManageSync => Session.HasPermission("sync.manage");
    private bool CanViewAdministration => Session.HasAnyPermission("user.manage", "role.manage");
    // The permission alone, matching the page policy and the API. A role
    // shortcut here would show a link that the audit endpoint then refuses.
    private bool CanViewAudit => Session.HasPermission("audit.view");

    private static readonly string[] RestockSiblings = ["restock/approvals", "restock/fulfillment"];
    private static readonly string[] CatalogSiblings = ["catalog/change-requests"];

    // At the warehouse the same page asks the owner to buy from a supplier,
    // which is a different job from the store-supply requests it fulfils.
    private string RestockRequestLabel => Session.WorkLocationKind == 0 ? "Supply requests" : "Restock requests";

    private Task NotifyNavigation() => OnNavigate.InvokeAsync();

    private async Task SignOutAsync()
    {
        await Notifications.StopAsync();
        Authentication.SignOut();
        try
        {
            // Drops the cookie too; the server session is already gone.
            await JS.InvokeVoidAsync("vaultflowSession.end");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        await OnNavigate.InvokeAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => Notifications.Changed -= OnNotificationsChanged;
}
