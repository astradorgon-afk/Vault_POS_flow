@inject VaultFlowAuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject NotificationStore Notifications
@inject UserSession Session

<div class="brand-block">
    <a class="brand" href="" @onclick="NotifyNavigation">
        <span class="brand-glyph" aria-hidden="true">V</span>
        <span><strong>VaultFlow</strong><small>Operations ledger</small></span>
    </a>
    <button class="sidebar-close" type="button" aria-label="Close navigation" @onclick="NotifyNavigation"><AppIcon Name="close" /></button>
</div>

<nav class="nav-stack" aria-label="Primary navigation">
    <div class="nav-group">
        <span class="nav-heading">Workspace</span>
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="NotifyNavigation"><AppIcon Name="home" /> <span>Overview</span></NavLink>
        <NavLink class="nav-link" href="notifications" @onclick="NotifyNavigation">
            <AppIcon Name="bell" /> <span>Notifications</span>
            @if (Notifications.UnreadCount > 0)
            {
                <small>@Notifications.UnreadCount</small>
            }
        </NavLink>
    </div>

    @if (CanViewInventory || CanViewTransfers || CanReceivePurchasing || CanViewExceptions)
    {
        <div class="nav-group">
            <span class="nav-heading">Inventory</span>
            @if (CanViewInventory)
            {
                <NavLink class="nav-link" href="inventory/stock" @onclick="NotifyNavigation"><AppIcon Name="box" /> <span>Stock levels</span></NavLink>
                <NavLink class="nav-link" href="inventory/counts" @onclick="NotifyNavigation"><AppIcon Name="ledger" /> <span>Stock counts</span></NavLink>
            }
            @if (CanViewTransfers)
            {
                <NavLink class="nav-link" href="transfers" @onclick="NotifyNavigation"><AppIcon Name="location" /> <span>Transfers</span></NavLink>
            }
            @if (CanApproveRestock)
            {
                <NavLink class="nav-link" href="restock/approvals" @onclick="NotifyNavigation"><AppIcon Name="ledger" /> <span>Restock approvals</span></NavLink>
            }
            @if (CanFulfillRestock)
            {
                <NavLink class="nav-link" href="restock/fulfillment" @onclick="NotifyNavigation"><AppIcon Name="box" /> <span>Restock fulfillment</span></NavLink>
            }
            @if (CanRequestRestock && !CanApproveRestock && !CanFulfillRestock)
            {
                <NavLink class="nav-link" href="restock" @onclick="NotifyNavigation"><AppIcon Name="ledger" /> <span>Restock requests</span></NavLink>
            }
            @if (CanReceivePurchasing)
            {
                <NavLink class="nav-link" href="receiving" @onclick="NotifyNavigation"><AppIcon Name="receipt" /> <span>Goods receiving</span></NavLink>
            }
            @if (CanViewExceptions)
            {
                <NavLink class="nav-link" href="inventory/exceptions" @onclick="NotifyNavigation"><AppIcon Name="alert" /> <span>Exceptions</span></NavLink>
            }
        </div>
    }

    @if (CanViewSales || CanViewReports)
    {
        <div class="nav-group">
            <span class="nav-heading">Stores</span>
            @if (CanViewSales)
            {
                <NavLink class="nav-link" href="stores" @onclick="NotifyNavigation"><AppIcon Name="coins" /> <span>Store performance</span></NavLink>
                <NavLink class="nav-link" href="sales" @onclick="NotifyNavigation"><AppIcon Name="ledger" /> <span>Sales ledger</span></NavLink>
                <NavLink class="nav-link" href="analytics/products" @onclick="NotifyNavigation"><AppIcon Name="trend-up" /> <span>Product analytics</span></NavLink>
            }
            @if (CanViewReports)
            {
                <NavLink class="nav-link" href="reports" @onclick="NotifyNavigation"><AppIcon Name="report" /> <span>Daily reports</span></NavLink>
            }
        </div>
    }

    @if (CanViewPurchasing)
    {
        <div class="nav-group">
            <span class="nav-heading">Purchasing</span>
            <NavLink class="nav-link" href="purchasing" @onclick="NotifyNavigation"><AppIcon Name="receipt" /> <span>Purchase orders</span></NavLink>
        </div>
    }

    @if (CanViewLocations || CanViewAdministration || CanManageDevices || CanManageSync)
    {
        <div class="nav-group">
            <span class="nav-heading">Administration</span>
            @if (CanViewLocations)
            {
                <NavLink class="nav-link" href="admin/locations" @onclick="NotifyNavigation"><AppIcon Name="location" /> <span>Locations</span></NavLink>
            }
            @if (CanViewAdministration)
            {
                <NavLink class="nav-link" href="admin/users" @onclick="NotifyNavigation"><AppIcon Name="people" /> <span>People &amp; roles</span></NavLink>
            }
            @if (CanManageDevices)
            {
                <NavLink class="nav-link" href="admin/devices" @onclick="NotifyNavigation"><AppIcon Name="device" /> <span>Devices</span></NavLink>
            }
            @if (CanManageSync)
            {
                <NavLink class="nav-link" href="sync/failures" @onclick="NotifyNavigation"><AppIcon Name="sync" /> <span>Sync failures</span></NavLink>
            }
        </div>
    }
</nav>

<AuthorizeView>
    <Authorized>
        <div class="sidebar-footer">
            <div><span>Signed in as</span><strong>@Session.Current?.User.DisplayName</strong></div>
            <button class="sign-out" type="button" @onclick="SignOutAsync"><AppIcon Name="logout" /> Sign out</button>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>Raised after a navigation choice so a mobile parent can close the drawer.</summary>
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool CanViewSales => Session.HasPermission("sale.view");
    private bool CanViewInventory => Session.HasPermission("inventory.view");
    private bool CanViewTransfers => Session.HasPermission("transfer.view");
    private bool CanApproveRestock => Session.HasPermission("transfer.approve") &&
        Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true;
    private bool CanRequestRestock => Session.HasPermission("transfer.request") && Session.HasPermission("transfer.view");
    private bool CanFulfillRestock => Session.HasPermission("transfer.pick") && Session.HasPermission("transfer.dispatch") &&
        Session.Current?.User.Roles.Contains("MainInventoryManager", StringComparer.Ordinal) == true;
    private bool CanViewPurchasing => Session.HasPermission("purchase.view") &&
        Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true;
    private bool CanReceivePurchasing => Session.HasPermission("purchase.view") && Session.HasPermission("purchase.receive");
    private bool CanViewReports => Session.HasPermission("report.view");
    private bool CanViewExceptions => Session.HasPermission("inventory.view.all");
    private bool CanViewLocations => Session.HasPermission("location.manage");
    private bool CanManageDevices => Session.HasPermission("device.manage");
    private bool CanManageSync => Session.HasPermission("sync.manage");
    private bool CanViewAdministration => Session.HasAnyPermission("user.manage", "role.manage");

    private Task NotifyNavigation() => OnNavigate.InvokeAsync();

    private async Task SignOutAsync()
    {
        await Notifications.StopAsync();
        Authentication.SignOut();
        await OnNavigate.InvokeAsync();
        Navigation.NavigateTo("/login");
    }
}
