@inject VaultFlowAuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<div class="brand-block">
    <a class="brand" href=""><span class="brand-glyph" aria-hidden="true">V</span><span><strong>VaultFlow</strong><small>Inventory command</small></span></a>
</div>

<nav class="nav-stack" aria-label="Primary navigation">
    <span class="nav-heading">Workspace</span>
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span aria-hidden="true">⌂</span> Overview</NavLink>
    <span class="nav-heading">Point of sale</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">▤</span> New sale <small>Next</small></span>
    <span class="nav-heading">Operations</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">◇</span> Inventory</span>
    <span class="nav-link disabled" aria-disabled="true"><span aria-hidden="true">⇄</span> Transfers</span>
</nav>

<AuthorizeView><Authorized><button class="sign-out" type="button" @onclick="SignOut">Sign out</button></Authorized></AuthorizeView>

@code {
    private void SignOut()
    {
        Authentication.SignOut();
        Navigation.NavigateTo("/login");
    }
}
