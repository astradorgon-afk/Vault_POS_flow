@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject NotificationStore Notifications
@inject UserSession Session

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="app-shell">
    <aside id="primary-navigation" class="sidebar @(navigationOpen ? "is-open" : string.Empty)">
        <NavMenu OnNavigate="CloseNavigation" />
    </aside>

    @if (navigationOpen)
    {
        <button class="nav-scrim" type="button" aria-label="Close navigation" @onclick="CloseNavigation"></button>
    }

    <main class="app-main">
        <header class="top-row">
            <button class="menu-button" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="@navigationOpen" @onclick="ToggleNavigation">
                <AppIcon Name="menu" />
            </button>

            <div class="workspace-context">
                <span>@WorkspaceSection</span>
                <strong>@WorkspaceTitle</strong>
            </div>

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="top-actions">
                        <a class="notification-bell @(Notifications.UnreadCount > 0 ? "has-unread" : string.Empty)" href="notifications" aria-label="Notifications, @Notifications.UnreadCount unread">
                            <AppIcon Name="bell" />
                            @if (Notifications.UnreadCount > 0)
                            {
                                <b>@BadgeCount</b>
                            }
                        </a>
                        <div class="operator">
                            <span class="operator-mark" aria-hidden="true">@Initials(auth.User.Identity?.Name)</span>
                            <span>
                                <strong>@auth.User.Identity?.Name</strong>
                                <small>@RoleLabel(auth.User) · @ScopeLabel</small>
                            </span>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <article id="main-content" class="content" tabindex="-1">@Body</article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    VaultFlow lost its connection. <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool navigationOpen;

    private string BadgeCount => Notifications.UnreadCount > 99
        ? "99+"
        : Notifications.UnreadCount.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string ScopeLabel => Session.Current?.User.HasAllLocations == true
        ? "All locations"
        : Session.Current?.User.Locations.Count switch
        {
            1 => "1 location",
            int count => $"{count} locations",
            _ => "No location",
        };

    private string WorkspaceSection => CurrentPath switch
    {
        var path when path.StartsWith("admin/", StringComparison.Ordinal) => "Administration",
        var path when path.StartsWith("catalog/", StringComparison.Ordinal) => "Catalogue",
        var path when path.StartsWith("sales", StringComparison.Ordinal) || path.StartsWith("returns", StringComparison.Ordinal) || path is "stores" or "inventory/stock" or "reports" or "inventory/exceptions" => "Stores",
        var path when path.StartsWith("sync/", StringComparison.Ordinal) => "System operations",
        "notifications" => "Activity",
        _ => "Your workspace",
    };

    private string WorkspaceTitle => CurrentPath switch
    {
        "" => "Overview",
        "notifications" => "Notifications",
        "stores" => "Store performance",
        "inventory/stock" => "Store inventory",
        "sales" => "Sales ledger",
        var path when path.StartsWith("sales/", StringComparison.Ordinal) => "Sale detail",
        var path when path.StartsWith("returns/", StringComparison.Ordinal) => "Return detail",
        "reports" => "Daily reports",
        "inventory/exceptions" => "Inventory exceptions",
        "admin/locations" => "Locations",
        "admin/users" => "People & roles",
        "admin/devices" => "Devices",
        "sync/failures" => "Sync failures",
        _ => "VaultFlow",
    };

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    protected override void OnInitialized()
    {
        Notifications.Changed += OnNotificationsChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Notifications.InitializeAsync();
        }
    }

    private void ToggleNavigation() => navigationOpen = !navigationOpen;
    private void CloseNavigation() => navigationOpen = false;
    private void OnNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        navigationOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string Initials(string? name) => string.Concat((name ?? "VF")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user)
        => SplitWords(user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Team member");

    private static string SplitWords(string value)
        => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");

    public void Dispose()
    {
        Notifications.Changed -= OnNotificationsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
