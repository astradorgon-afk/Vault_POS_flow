@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject NotificationStore Notifications
@inject OfflineReadinessNotice OfflineNotice
@inject UserSession Session
@inject PageTrail Trail
@inject KeyboardScanListener Scanner

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="app-shell">
    <aside id="primary-navigation" class="sidebar @(navigationOpen ? "is-open" : string.Empty)">
        <NavMenu OnNavigate="CloseNavigation" />
    </aside>

    @if (navigationOpen)
    {
        <button class="nav-scrim" type="button" aria-label="Close navigation" @onclick="CloseNavigation"></button>
    }

    <main class="app-main">
        <header class="top-row">
            <button class="menu-button" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="@(navigationOpen ? "true" : "false")" @onclick="ToggleNavigation">
                <AppIcon Name="menu" />
            </button>

            @{ PagePlace place = Trail.Current; }
            <div class="workspace-context">
                @if (place.Parent is { } parent)
                {
                    <a class="page-back" href="@parent.Href" title="Back to @parent.Label" aria-label="Back to @parent.Label">
                        <span aria-hidden="true">←</span><em>Back</em>
                    </a>
                }
                <div class="page-trail">
                    <nav aria-label="Breadcrumb">
                        <ol>
                            <li>@place.Section</li>
                            @if (place.Parent is { } up && up.Label != place.Section)
                            {
                                <li><a href="@up.Href">@up.Label</a></li>
                            }
                        </ol>
                    </nav>
                    <strong aria-current="page">@place.Title</strong>
                </div>
            </div>

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="top-actions">
                        <a class="notification-bell @(Notifications.UnreadCount > 0 ? "has-unread" : string.Empty)" href="notifications" aria-label="Notifications, @Notifications.UnreadCount unread">
                            <AppIcon Name="bell" />
                            @if (Notifications.UnreadCount > 0)
                            {
                                <b>@BadgeCount</b>
                            }
                        </a>
                        <div class="operator">
                            <span class="operator-mark" aria-hidden="true">@Initials(auth.User.Identity?.Name)</span>
                            <span>
                                <strong>@auth.User.Identity?.Name</strong>
                                <small>@RoleLabel(auth.User) · @ScopeLabel</small>
                            </span>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        @if (OfflineNotice.IsVisible)
        {
            <section class="offline-ready-banner" role="status" aria-label="Offline access notice">
                <span class="offline-ready-icon" aria-hidden="true"><AppIcon Name="check" /></span>
                <div class="offline-ready-copy">
                    <strong>Offline access is ready on this device.</strong>
                    <small>@(OfflineNotice.IsInstalled
                        ? "You can open your saved workspace from the sign-in page without a connection."
                        : "Install VaultFlow to open it from your home screen.")</small>
                    <p id="offline-install-status"></p>
                    @if (!OfflineNotice.IsInstalled)
                    {
                        <p id="offline-install-steps">If no install prompt opens, use your browser menu and choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</p>
                    }
                </div>
                <div class="offline-ready-actions">
                    @if (!OfflineNotice.IsInstalled)
                    {
                        <button type="button" class="offline-ready-install" data-vaultflow-install>Install VaultFlow</button>
                    }
                    <button type="button" class="offline-ready-dismiss" aria-label="Dismiss offline notice" @onclick="DismissOfflineNotice">
                        <AppIcon Name="close" />
                    </button>
                </div>
            </section>
        }

        <article id="main-content" class="content" tabindex="-1">@Body</article>
        <ScanFeedback Hint="Open an inventory page to use it." />
    </main>

    <AuthorizeView>
        <Authorized>
            <nav class="tabbar" aria-label="Main">
                @foreach (Tab tab in Tabs)
                {
                    <NavLink class="tab-item" href="@tab.Href" Match="@(tab.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <AppIcon Name="@tab.Icon" />
                        <span>@tab.Label</span>
                    </NavLink>
                }
                <button type="button" class="tab-item @(navigationOpen ? "active" : null)" aria-expanded="@(navigationOpen ? "true" : "false")" aria-controls="primary-navigation" @onclick="ToggleNavigation">
                    <AppIcon Name="menu" />
                    <span>More</span>
                    @if (Notifications.UnreadCount > 0)
                    {
                        <b class="tab-badge" aria-label="@Notifications.UnreadCount unread">@BadgeCount</b>
                    }
                </button>
            </nav>
        </Authorized>
    </AuthorizeView>
</div>

<div id="blazor-error-ui" data-nosnippet>
    VaultFlow lost its connection. <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private bool navigationOpen;

    private string BadgeCount => Notifications.UnreadCount > 99
        ? "99+"
        : Notifications.UnreadCount.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string ScopeLabel => Session.WorkLocationName is { Length: > 0 } chosen
        ? chosen
        : Session.Current?.User.HasAllLocations == true
        ? "All locations"
        : Session.Current?.User.Locations.Count switch
        {
            1 => "1 location",
            int count => $"{count} locations",
            _ => "No location",
        };

    protected override void OnInitialized()
    {
        Notifications.Changed += OnNotificationsChanged;
        OfflineNotice.Changed += OnNotificationsChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Trail.Changed += OnNotificationsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Notifications.InitializeAsync();
            try
            {
                await Scanner.StartAsync();
            }
            catch (JSException)
            {
                // Scanning is a convenience; the page works without it.
            }
        }
    }

    private void ToggleNavigation() => navigationOpen = !navigationOpen;

    // The four places this person uses most, by what they may do; the rest sit under More.
    private IEnumerable<Tab> Tabs
    {
        get
        {
            List<Tab> tabs = [new(string.Empty, "home", "Home")];
            if (Session.HasPermission("transfer.view"))
            {
                tabs.Add(new("stores", "location", "Movement"));
            }

            if (Session.HasPermission("sale.view"))
            {
                tabs.Add(new("analytics/products", "trend-up", "Analytics"));
            }

            if (Session.HasPermission("inventory.view"))
            {
                tabs.Add(new("inventory/stock", "box", "Stock"));
            }

            if (Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true &&
                Session.HasPermission("transfer.approve"))
            {
                tabs.Add(new("restock/approvals", "ledger", "Approvals"));
            }
            else if (Session.WorkLocationKind == 0 &&
                Session.Current?.User.Roles.Any(role => role is "MainInventoryManager" or "InventoryStaff") == true &&
                Session.HasPermission("transfer.pick") && Session.HasPermission("transfer.dispatch"))
            {
                tabs.Add(new("restock/fulfillment", "box", "Fulfill"));
            }
            else if (Session.WorkLocationKind == 1 &&
                Session.HasPermission("transfer.request") && Session.HasPermission("transfer.view"))
            {
                tabs.Add(new("restock", "ledger", "Restock"));
            }

            if (Session.HasPermission("purchase.view") && Session.HasPermission("purchase.receive"))
            {
                tabs.Add(new("receiving", "receipt", "Receiving"));
            }

            if (Session.HasPermission("purchase.view") &&
                Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true)
            {
                tabs.Add(new("purchasing", "receipt", "Orders"));
            }

            if (Session.HasAnyPermission("user.manage", "role.manage"))
            {
                tabs.Add(new("admin/users", "people", "People"));
            }

            tabs.Add(new("notifications", "bell", "Alerts"));
            return tabs.Take(4);
        }
    }

    private sealed record Tab(string Href, string Icon, string Label);
    private void CloseNavigation() => navigationOpen = false;
    private void DismissOfflineNotice() => OfflineNotice.Dismiss();
    private void OnNotificationsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        navigationOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string Initials(string? name) => string.Concat((name ?? "VF")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user)
        => SplitWords(user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Team member");

    private static string SplitWords(string value)
        => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");

    public void Dispose()
    {
        Notifications.Changed -= OnNotificationsChanged;
        OfflineNotice.Changed -= OnNotificationsChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Trail.Changed -= OnNotificationsChanged;
    }
}
