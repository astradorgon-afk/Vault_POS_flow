@page "/not-found"
@layout MainLayout
@inject IHttpContextAccessor Http

@* A page the account is not allowed to open is re-executed here by the
   status-code middleware, which keeps the operator signed in but would
   otherwise tell them the page does not exist. *@
@if (Http.HttpContext?.Response.StatusCode == StatusCodes.Status403Forbidden)
{
    <section class="route-message access-denied" role="alert">
        <span>Access restricted</span>
        <h1>This workspace is not assigned to you.</h1>
        <p>Your navigation only shows tools included in your current permission set.</p>
        <a href="/">Return to your overview</a>
    </section>
}
else
{
    <h3>Not Found</h3>
    <p>Sorry, the content you are looking for does not exist.</p>
}
