@page "/transfers/replenishment"
@using System.Globalization
@attribute [Authorize(Policy = "transfer.request")]
@rendermode InteractiveServer
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>Replenishment · VaultFlow</PageTitle>

<div class="office-head">
    <div>
        <p class="office-kicker">Getting stock into a store</p>
        <h1 class="office-title">Replenishment</h1>
        <p class="office-lead">What each store needs restocking and where the stock could come from, most urgent first.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="pos-message" role="status">@message</div>
}

<section class="results-panel" aria-live="polite">
    @if (loading)
    {
        <div class="results-empty">Loading recommendations…</div>
    }
    else if (recommendations.Count == 0)
    {
        <div class="results-empty"><strong>Nothing needs restocking.</strong><span>Every product is at or above its target level at your locations.</span></div>
    }
    else
    {
        <table class="sales-table">
            <thead>
                <tr><th>Location</th><th>Product</th><th>Available</th><th>Deficit</th><th>Urgency</th><th>Suggested from</th><th>Suggested qty</th></tr>
            </thead>
            <tbody>
                @foreach (PosReplenishmentRecommendation row in recommendations)
                {
                    <tr @key="@((row.LocationId, row.ProductId))">
                        <td>@LocationName(row.LocationId)</td>
                        <td>
                            <div class="product-name">@ProductDisplayName(row.ProductId)</div>
                            @if (ProductSku(row.ProductId) is { } sku)
                            {
                                <div class="product-sku">@sku</div>
                            }
                        </td>
                        <td class="sheet-number">@row.Available.ToString("0.######", CultureInfo.InvariantCulture)</td>
                        <td class="sheet-number sheet-loss">@row.Deficit.ToString("0.######", CultureInfo.InvariantCulture)</td>
                        <td><span class="@UrgencyChipClass(row.Urgency)">@row.Urgency</span></td>
                        <td>@(row.SuggestedSourceLocationId is { } source ? LocationName(source) : "—")</td>
                        <td class="sheet-number">@row.SuggestedQuantity.ToString("0.######", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private readonly List<PosLocation> locations = [];
    private readonly Dictionary<Guid, (string Sku, string Name)> productNames = [];
    private readonly List<PosReplenishmentRecommendation> recommendations = [];

    private bool loading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        ApiResult<List<PosLocation>> locationResponse = await Api.GetAsync<List<PosLocation>>("/api/v1/locations", CancellationToken.None);
        if (locationResponse.IsSuccess && locationResponse.Value is not null)
        {
            locations.AddRange(locationResponse.Value);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        message = null;
        try
        {
            ApiResult<List<PosReplenishmentRecommendation>> response = await Api.GetReplenishmentRecommendationsAsync(CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            recommendations.Clear();
            // Urgency is text; ranking it alphabetically put High above Critical.
            recommendations.AddRange(response.Value.OrderBy(r => UrgencyRank(r.Urgency)).ThenByDescending(r => r.Deficit));
            await LoadProductNamesAsync(recommendations.Select(r => r.ProductId).Distinct().ToArray());
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadProductNamesAsync(IReadOnlyCollection<Guid> ids)
    {
        HashSet<Guid> wanted = [.. ids];
        foreach (Guid id in wanted)
        {
            productNames[id] = (ShortId(id), "Product");
        }

        try
        {
            for (int offset = 0; offset < 2000 && wanted.Count > 0; offset += 200)
            {
                ApiResult<List<PosProductSummary>> response = await Api.GetProductsAsync(null, offset, 200, CancellationToken.None);
                if (!response.IsSuccess || response.Value is null || response.Value.Count == 0)
                {
                    break;
                }

                foreach (PosProductSummary product in response.Value)
                {
                    if (wanted.Remove(product.Id))
                    {
                        productNames[product.Id] = (product.Sku, product.Name);
                    }
                }

                if (response.Value.Count < 200)
                {
                    break;
                }
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    private string LocationName(Guid locationId)
        => locations.FirstOrDefault(location => location.Id == locationId)?.Name ?? "location";

    private string ProductDisplayName(Guid productId)
        => productNames.TryGetValue(productId, out (string Sku, string Name) product)
            ? product.Name
            : $"Product {ShortId(productId)}";

    private string? ProductSku(Guid productId)
        => productNames.TryGetValue(productId, out (string Sku, string Name) product) && !string.IsNullOrWhiteSpace(product.Sku)
            ? product.Sku
            : null;

    private static string ShortId(Guid value) => value.ToString("D", CultureInfo.InvariantCulture)[..8];

    private static int UrgencyRank(string urgency) => urgency switch
    {
        "Critical" => 0,
        "High" => 1,
        _ => 2,
    };

    private static string UrgencyChipClass(string urgency) => urgency switch
    {
        "Critical" => "status-chip sc-rejected",
        "High" => "status-chip sc-issue",
        "Normal" => "status-chip sc-draft",
        _ => "status-chip",
    };
}
