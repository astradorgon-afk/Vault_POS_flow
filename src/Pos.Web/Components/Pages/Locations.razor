@page "/admin/locations"
@attribute [Authorize(Policy = "location.manage")]
@rendermode InteractiveServer
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>Locations · VaultFlow</PageTitle>

<nav class="lx-crumbs" aria-label="Breadcrumb">
    <span>Administration</span><i aria-hidden="true"></i><span>Operating rules</span><i aria-hidden="true"></i><span>Locations</span>
</nav>

<header class="lx-top">
    <div>
        <h1>Locations</h1>
        <p>Manage your warehouses, stores, and the stock rules that keep them running.</p>
    </div>
    @if (CanManageLocations)
    {
        <button class="lx-primary" type="button" @onclick="OpenCreate">
            <span class="lx-btn-icon" aria-hidden="true"><AppIcon Name="plus" /></span><span>Add location</span>
        </button>
    }
</header>

@if (!CanViewLocations)
{
    <section class="lx-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view locations.</h2>
        <p>Ask an administrator for catalogue or location administration access.</p>
    </section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message) && !ModalOpen)
    {
        <div class="lx-message" role="status">@message</div>
    }

    <section class="lx-stats" aria-label="Location overview">
        <article>
            <div>
                <span class="lx-stat-title">Total locations</span>
                <strong>@locations.Count</strong>
                <small>@ActiveCount active · @ClosedCount closed</small>
            </div>
            <span class="lx-stat-icon" aria-hidden="true"><AppIcon Name="location" /></span>
        </article>
        <article>
            <div>
                <span class="lx-stat-title">Strict stock policy</span>
                <strong>@StrictCount</strong>
                <small>locations prohibit negative stock</small>
            </div>
            <span class="lx-stat-icon" aria-hidden="true"><AppIcon Name="void" /></span>
        </article>
        <article>
            <div>
                <span class="lx-stat-title">Direct delivery</span>
                <strong>@DirectDeliveryCount</strong>
                <small>locations receive straight from suppliers</small>
            </div>
            <span class="lx-stat-icon" aria-hidden="true"><AppIcon Name="box-in" /></span>
        </article>
    </section>

    @if (loading)
    {
        <section class="lx-placeholder">Loading operating policy…</section>
    }
    else if (locations.Count == 0)
    {
        <section class="lx-placeholder"><strong>No physical locations found.</strong></section>
    }
    else
    {
        <div class="lx-workspace">
            <aside class="lx-side" aria-label="Location navigation">
                <div class="lx-side-top">
                    <div class="lx-side-head">
                        <h2>Your locations</h2>
                        <span class="lx-pill">@locations.Count total</span>
                    </div>
                    <div class="lx-search">
                        <span class="lx-search-icon" aria-hidden="true"><AppIcon Name="search" /></span>
                        <input type="search" aria-label="Search locations" placeholder="Search by name or code…"
                               value="@search" @oninput="OnSearchChanged" />
                    </div>
                    @* Live locations are the working set; closed ones are kept for
                       their record. The list opens on live so a long-retired store
                       never sits between two shops somebody is actually running. *@
                    <div class="lx-filters" role="group" aria-label="Filter location status">
                        <button type="button" class="@(scope == "all" ? "active" : null)" @onclick='() => SetScope("all")'>All <span>@locations.Count</span></button>
                        <button type="button" class="@(scope == "live" ? "active" : null)" @onclick='() => SetScope("live")'>Active <span>@ActiveCount</span></button>
                        <button type="button" class="@(scope == "closed" ? "active" : null)" @onclick='() => SetScope("closed")'>Closed <span>@ClosedCount</span></button>
                    </div>
                </div>
                <nav class="lx-list" aria-label="Select a location">
                    @if (Visible.Count == 0)
                    {
                        <p class="lx-list-empty">@EmptyListText</p>
                    }
                    @foreach (PosLocationAdmin item in Visible)
                    {
                        <button type="button" @key="item.Id" @onclick="() => SelectLocation(item)"
                                class="lx-row @(selected?.Id == item.Id ? "selected" : null) @(item.IsActive ? null : "is-closed")"
                                aria-current="@(selected?.Id == item.Id ? "true" : "false")">
                            <span class="lx-row-icon" aria-hidden="true"><AppIcon Name="@(item.Kind == 0 ? "box" : "sale")" /></span>
                            <span class="lx-row-body">
                                <span class="lx-row-code">@item.Code</span>
                                <span class="lx-row-name">@item.Name</span>
                                <span class="lx-row-meta">@(item.IsActive ? KindName(item.Kind) : "Closed location")</span>
                            </span>
                            <span class="lx-row-arrow" aria-hidden="true"><AppIcon Name="arrow" /></span>
                        </button>
                    }
                </nav>
                <p class="lx-side-foot">@SideFootText</p>
            </aside>

            @if (selected is { } location)
            {
                <article class="lx-editor" aria-label="Location settings">
                    <div class="lx-editor-top">
                        <p class="lx-overline">@location.Code · @KindName(location.Kind)</p>
                        <div class="lx-editor-title">
                            <h2>@location.Name</h2>
                            <span class="lx-badge @(location.IsActive ? null : "is-closed")">@(location.IsActive ? "Active" : "Closed")</span>
                        </div>
                        <p class="lx-editor-sub">
                            <span class="lx-sub-icon" aria-hidden="true"><AppIcon Name="location" /></span>
                            <span>@TimelineLine(location)</span>
                            @if (Dirty)
                            {
                                <span class="lx-unsaved">Unsaved changes</span>
                            }
                        </p>
                    </div>

                    <section class="lx-section">
                        <div class="lx-section-head">
                            <span class="lx-section-icon" aria-hidden="true"><AppIcon Name="location" /></span>
                            <div>
                                <h3>Location details</h3>
                                <p>The code, name, kind and timezone that reports, receipts and transfers refer to.</p>
                            </div>
                        </div>
                        <div class="lx-fields">
                            <label class="lx-field">
                                <span>Location code</span>
                                <input class="lx-control" maxlength="16" placeholder="STORE3" disabled="@DetailsReadOnly" @bind="editCode" @bind:event="oninput" />
                                <small>Unique identifier used in inventory records.</small>
                            </label>
                            <label class="lx-field">
                                <span>Location name</span>
                                <input class="lx-control" maxlength="64" placeholder="Quezon Avenue" disabled="@DetailsReadOnly" @bind="editName" @bind:event="oninput" />
                            </label>
                            <label class="lx-field">
                                <span>Location type</span>
                                <select class="lx-control" disabled="@DetailsReadOnly" @bind="editKind">
                                    <option value="1">Retail store</option>
                                    <option value="0">Main warehouse</option>
                                </select>
                            </label>
                            <label class="lx-field">
                                <span>IANA timezone</span>
                                <input class="lx-control" placeholder="Asia/Manila" disabled="@DetailsReadOnly" @bind="editTimeZone" @bind:event="oninput" />
                                <small>The clock every stock movement here is stamped with.</small>
                            </label>
                        </div>
                    </section>

                    <section class="lx-section">
                        <div class="lx-section-head">
                            <span class="lx-section-icon" aria-hidden="true"><AppIcon Name="settings" /></span>
                            <div>
                                <h3>Inventory rules</h3>
                                <p>How stock is controlled here: negative balances, expiry warnings and direct deliveries.</p>
                            </div>
                        </div>
                        <div class="lx-fields">
                            <label class="lx-field">
                                <span>Negative-stock policy</span>
                                <select class="lx-control" disabled="@SettingsReadOnly" @bind="editNegativePolicy">
                                    <option value="0">Prohibit negative stock</option>
                                    <option value="1">Allow with permission</option>
                                    <option value="2">Offline only, central review</option>
                                </select>
                                <small>Prohibit refuses any posting that would take this location below zero.</small>
                            </label>
                            <label class="lx-field">
                                <span>Expiry warning</span>
                                <span class="lx-suffixed">
                                    <input class="lx-control" type="number" min="0" max="3650" disabled="@SettingsReadOnly" @bind="editExpiryDays" />
                                    <i>days</i>
                                </span>
                                <small>Warn this many days before a batch expires.</small>
                            </label>
                        </div>
                        <div class="lx-switch-row">
                            <div>
                                <strong>Allow direct supplier delivery</strong>
                                <p>Stock may arrive here from a supplier without first passing through MAIN.</p>
                            </div>
                            <button type="button" role="switch" aria-label="Allow direct supplier delivery"
                                    class="lx-switch @(editDirectDelivery ? "on" : null)"
                                    aria-checked="@(editDirectDelivery ? "true" : "false")"
                                    disabled="@SettingsReadOnly" @onclick="ToggleDirectDelivery"></button>
                        </div>
                    </section>

                    @* A closed location is kept for its record, not for day-to-day
                       work, so the only thing on offer here is the record itself. *@
                    @if (!location.IsActive)
                    {
                        <section class="lx-zone">
                            <div>
                                <h3>This location is retired</h3>
                                <p>It takes no new sales, transfers, counts or receipts. Everything it did stays on the record and in the reports for the periods it was open.</p>
                            </div>
                            <a class="lx-secondary" href="@($"/locations/{location.Id:D}/history")">View its full record</a>
                        </section>
                    }
                    else if (CanManageLocations)
                    {
                        <section class="lx-zone is-danger">
                            <div>
                                <h3>Close this location</h3>
                                <p>Stop new operations here while keeping inventory history, receipts and transfers available for audit. Locations are retired rather than deleted.</p>
                            </div>
                            <button class="lx-danger" type="button" @onclick="OpenCloseConfirm">Close location</button>
                        </section>
                    }

                    <footer class="lx-actions">
                        <span>@Caption</span>
                        <div>
                            <button class="lx-secondary" type="button" disabled="@(!Dirty || working)" @onclick="DiscardChanges">Discard</button>
                            <button class="lx-primary" type="button" disabled="@(!CanSave)" @onclick="SaveAsync">
                                <span class="lx-btn-icon" aria-hidden="true"><AppIcon Name="check" /></span><span>@(working ? "Saving…" : "Save changes")</span>
                            </button>
                        </div>
                    </footer>
                </article>
            }
        </div>
    }
}

@if (showCreate && CanManageLocations)
{
    <div class="lx-scrim" @onclick="TryDismissCreate"></div>
    <div class="lx-modal" role="dialog" aria-modal="true" aria-labelledby="lx-create-title"
         tabindex="-1" @ref="createRef" @onkeydown="OnCreateKey">
        <header class="lx-modal-head">
            <span class="lx-modal-mark" aria-hidden="true"><AppIcon Name="plus" /></span>
            <div>
                <h2 id="lx-create-title">Add a location</h2>
                <p>Set up a new warehouse or retail store. New locations start on VaultFlow's conservative defaults.</p>
            </div>
            <button type="button" class="lx-modal-close" aria-label="Close" @onclick="CloseCreate">&times;</button>
        </header>
        <div class="lx-modal-body">
            <label class="lx-field">
                <span>Location code</span>
                <input class="lx-control" maxlength="16" placeholder="STORE3" @bind="newCode" @bind:event="oninput" />
                <small>Letters, numbers, underscores and hyphens.</small>
            </label>
            <label class="lx-field">
                <span>Location name</span>
                <input class="lx-control" maxlength="64" placeholder="Quezon Avenue" @bind="newName" @bind:event="oninput" />
            </label>
            <div class="lx-fields">
                <label class="lx-field">
                    <span>Location type</span>
                    <select class="lx-control" @bind="newKind">
                        <option value="1">Retail store</option>
                        <option value="0">Main warehouse</option>
                    </select>
                </label>
                <label class="lx-field">
                    <span>IANA timezone</span>
                    <input class="lx-control" placeholder="Asia/Manila" @bind="newTimeZone" @bind:event="oninput" />
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="lx-error" role="alert">@message</p>
            }
        </div>
        <footer class="lx-modal-foot">
            <button class="lx-secondary" type="button" disabled="@working" @onclick="CloseCreate">Cancel</button>
            <button class="lx-primary" type="button" disabled="@(!CanCreate || working)" @onclick="CreateLocationAsync">@(working ? "Creating…" : "Create location")</button>
        </footer>
    </div>
}

@if (showCloseConfirm && CanManageLocations && selected is { IsActive: true } closing)
{
    <div class="lx-scrim" @onclick="TryDismissClose"></div>
    <div class="lx-modal" role="alertdialog" aria-modal="true" aria-labelledby="lx-close-title"
         tabindex="-1" @ref="closeRef" @onkeydown="OnCloseKey">
        <header class="lx-modal-head">
            <span class="lx-modal-mark is-danger" aria-hidden="true"><AppIcon Name="warning" /></span>
            <div>
                <h2 id="lx-close-title">Close @closing.Name?</h2>
                <p>Review the impact before continuing.</p>
            </div>
            <button type="button" class="lx-modal-close" aria-label="Close" @onclick="ToggleCloseConfirm">&times;</button>
        </header>
        <div class="lx-modal-body">
            <p class="lx-warning">@closing.Name stops accepting sales, transfers, counts and receipts from the effective date. Existing stock and documents stay on the record, so review pending transfers before you continue.</p>
            <label class="lx-field">
                <span>Effective closing date</span>
                <input class="lx-control" type="date" value="@closeDate" @onchange="OnCloseDateChanged" />
            </label>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="lx-error" role="alert">@message</p>
            }
        </div>
        <footer class="lx-modal-foot">
            <button class="lx-secondary" type="button" disabled="@working" @onclick="ToggleCloseConfirm">Cancel</button>
            <button class="lx-danger" type="button" disabled="@(working || !CanClose)" @onclick="CloseLocationAsync">@(working ? "Closing…" : "Close this location")</button>
        </footer>
    </div>
}
