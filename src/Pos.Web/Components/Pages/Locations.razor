@page "/admin/locations"
@attribute [Authorize(Policy = "location.manage")]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>Locations · VaultFlow</PageTitle>

<section class="locations-head">
    <div>
        <span class="eyebrow">Administration · operating rules</span>
        <h1>Locations</h1>
        <p>Manage warehouses, stores, and the rules that protect their stock.</p>
    </div>
    @if (CanManageLocations)
    {
        <button class="location-primary" type="button" @onclick="ToggleCreate">@(showCreate ? "Close form" : "Add location")</button>
    }
</section>

@if (!CanViewLocations)
{
    <section class="locations-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view locations.</h2>
        <p>Ask an administrator for catalogue or location administration access.</p>
    </section>
}
else
{
    @if (showCreate)
    {
        <section class="location-create" aria-labelledby="create-location-title">
            <header><div><span>New operating unit</span><h2 id="create-location-title">Add a physical location</h2></div><p>New locations start on VaultFlow's conservative defaults. Tune the policy after creation.</p></header>
            <div class="location-create-grid">
                <label><span>Code</span><input maxlength="16" @bind="newCode" placeholder="STORE3" /></label>
                <label><span>Name</span><input maxlength="64" @bind="newName" placeholder="Quezon Avenue" /></label>
                <label><span>Kind</span><select @bind="newKind"><option value="1">Retail store</option><option value="0">Main warehouse</option></select></label>
                <label><span>IANA timezone</span><input @bind="newTimeZone" placeholder="Asia/Manila" /></label>
            </div>
            <footer><span>Give the location a clear code and timezone for stock activity.</span><button class="location-primary" type="button" @onclick="CreateLocationAsync" disabled="@(!CanCreate || working)">@(working ? "Creating…" : "Create location")</button></footer>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="locations-message" role="status">@message</div>
    }

    <section class="location-summary" aria-label="Location summary">
        <article><span>Physical locations</span><strong>@locations.Count</strong><small>@locations.Count(location => location.Kind == 1) stores · @locations.Count(location => location.Kind == 0) warehouse</small></article>
        <article><span>Strict stock policy</span><strong>@locations.Count(location => location.Settings.NegativeStockPolicy == 0)</strong><small>locations prohibit negative stock</small></article>
        <article><span>Direct delivery</span><strong>@locations.Count(location => location.Settings.AllowsDirectSupplierDelivery)</strong><small>locations permit supplier-to-store receipts</small></article>
    </section>

    @if (loading)
    {
        <section class="locations-empty">Loading operating policy…</section>
    }
    else if (locations.Count == 0)
    {
        <section class="locations-empty"><strong>No physical locations found.</strong></section>
    }
    else
    {
        <div class="location-workspace">
            <section class="location-list" aria-label="Locations">
                @foreach (PosLocationAdmin location in locations)
                {
                    <button type="button" class="location-card @(selected?.Id == location.Id ? "selected" : "")" @onclick="() => SelectLocation(location)" @key="location.Id">
                        <span class="location-code">@location.Code</span>
                        <strong>@location.Name</strong>
                        <small>@KindName(location.Kind) · @location.TimeZoneId</small>
                        <i>@PolicyName(location.Settings.NegativeStockPolicy)</i>
                    </button>
                }
            </section>

            @if (selected is not null)
            {
                <section class="policy-editor" aria-labelledby="policy-editor-title">
                    <header>
                        <div><span>@selected.Code · @KindName(selected.Kind)</span><h2 id="policy-editor-title">@selected.Name</h2><p>Open since @selected.OpenedOn.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) · @selected.TimeZoneId</p></div>
                        <span class="location-kind-badge">@KindName(selected.Kind)</span>
                    </header>

                    @if (CanManageLocations)
                    {
                        <div class="policy-section">
                            <div class="policy-section-title"><span>Details</span><div><strong>Identity</strong><small>The code, name, kind and timezone reports, receipts and transfers refer to.</small></div></div>
                            <div class="policy-fields two-columns">
                                <label><span>Code</span><input maxlength="16" @bind="editCode" placeholder="STORE3" /></label>
                                <label><span>Name</span><input maxlength="64" @bind="editName" placeholder="Quezon Avenue" /></label>
                                <label><span>Kind</span><select @bind="editKind"><option value="1">Retail store</option><option value="0">Main warehouse</option></select></label>
                                <label><span>IANA timezone</span><input @bind="editTimeZone" placeholder="Asia/Manila" /></label>
                            </div>
                            <footer class="policy-actions">
                                <span>@(CanSaveDetails ? "Details save across the whole organization." : "Enter a code, name and IANA timezone to save.")</span>
                                <button class="location-primary" type="button" @onclick="SaveDetailsAsync" disabled="@(!CanSaveDetails || working)">@(working ? "Saving…" : "Save details")</button>
                            </footer>
                        </div>
                    }

                    <div class="policy-section">
                        <div class="policy-section-title"><span>Stock</span><div><strong>Inventory rules</strong><small>Control negative stock, expiry alerts, and direct deliveries.</small></div></div>
                        <div class="policy-fields two-columns">
                            <label><span>Negative-stock policy</span><select @bind="editNegativePolicy" disabled="@(!CanManageSettings)"><option value="0">Prohibit</option><option value="1">Allow with permission</option><option value="2">Offline only, central review</option></select></label>
                            <label><span>Expiry warning</span><div class="unit-input"><input type="number" min="0" max="3650" @bind="editExpiryDays" disabled="@(!CanManageSettings)" /><i>days</i></div></label>
                            <label class="policy-check"><input type="checkbox" @bind="editDirectDelivery" disabled="@(!CanManageSettings)" /><span><strong>Allow direct supplier delivery</strong><small>Stock may arrive at this location without first passing through MAIN.</small></span></label>
                        </div>
                        <footer class="policy-actions">
                            <span>@(CanManageSettings ? "Changes to stock rules take effect for this location after saving." : "You can review this location's inventory rules.")</span>
                            @if (CanManageSettings)
                            {
                                <button class="location-primary" type="button" @onclick="SaveSettingsAsync" disabled="@working">@(working ? "Saving…" : "Save stock rules")</button>
                            }
                        </footer>
                    </div>

                    @if (CanManageLocations)
                    {
                        <div class="policy-section location-danger">
                            <div class="policy-section-title"><span>Close</span><div><strong>Retire this location</strong><small>Closing stops new sales, transfers and receipts here. History stays intact.</small></div></div>
                            @if (!showCloseConfirm)
                            {
                                <footer class="policy-actions">
                                    <span>Close @selected.Name to stop new operations here. Existing stock and documents stay on the record.</span>
                                    <button class="location-danger-button" type="button" @onclick="ToggleCloseConfirm">Close location</button>
                                </footer>
                            }
                            else
                            {
                                <div class="close-confirm" role="alertdialog" aria-label="Confirm closing this location">
                                    <label><span>Effective closing date</span><input type="date" value="@closeDate" @onchange="OnCloseDateChanged" /></label>
                                    <p>@selected.Name stops accepting operations from that date. Locations are retired rather than deleted, so their ledger history remains.</p>
                                    <div>
                                        <button class="location-secondary" type="button" @onclick="ToggleCloseConfirm" disabled="@working">Cancel</button>
                                        <button class="location-danger-button" type="button" @onclick="CloseLocationAsync" disabled="@(working || !CanClose)">@(working ? "Closing…" : "Close this location")</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    }
}

@code {
    private readonly List<PosLocationAdmin> locations = [];
    private PosLocationAdmin? selected;
    private bool loading = true;
    private bool working;
    private bool showCreate;
    private string? message;
    private string newCode = string.Empty;
    private string newName = string.Empty;
    private int newKind = 1;
    private string newTimeZone = "Asia/Manila";
    private int editNegativePolicy;
    private bool editDirectDelivery;
    private int editExpiryDays;
    private string editCode = string.Empty;
    private string editName = string.Empty;
    private int editKind = 1;
    private string editTimeZone = "Asia/Manila";
    private bool showCloseConfirm;
    private string closeDate = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private bool CanViewLocations => Session.HasPermission("location.manage");
    private bool CanManageLocations => Session.Current?.User.Permissions.Contains("location.manage", StringComparer.Ordinal) == true;
    private bool CanManageSettings => Session.Current?.User.Permissions.Contains("settings.manage", StringComparer.Ordinal) == true;
    private bool CanCreate => !string.IsNullOrWhiteSpace(newCode) && !string.IsNullOrWhiteSpace(newName) && !string.IsNullOrWhiteSpace(newTimeZone);
    private bool CanSaveDetails => !string.IsNullOrWhiteSpace(editCode) && !string.IsNullOrWhiteSpace(editName) && !string.IsNullOrWhiteSpace(editTimeZone);
    private bool CanClose => DateOnly.TryParse(closeDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out _);

    protected override async Task OnInitializedAsync()
    {
        if (!CanViewLocations)
        {
            loading = false;
            return;
        }

        await LoadLocationsAsync();
    }

    private async Task LoadLocationsAsync(Guid? keepSelected = null)
    {
        loading = true;
        try
        {
            ApiResult<List<PosLocationAdmin>> result = await Api.GetLocationAdministrationAsync(CancellationToken.None);
            if (!result.IsSuccess || result.Value is null)
            {
                message = result.Error;
                return;
            }

            locations.Clear();
            locations.AddRange(result.Value.OrderBy(location => location.Kind).ThenBy(location => location.Code));
            Guid? targetId = keepSelected ?? selected?.Id;
            PosLocationAdmin? target = targetId is { } id ? locations.FirstOrDefault(location => location.Id == id) : locations.FirstOrDefault();
            if (target is not null)
            {
                SelectLocation(target);
            }
        }
        catch (HttpRequestException)
        {
            message = "The location service is unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateLocationAsync()
    {
        if (!CanManageLocations || !CanCreate)
        {
            message = "Enter a code, name and IANA timezone.";
            return;
        }

        working = true;
        message = null;
        try
        {
            ApiResult<PosReference> result = await Api.CreateLocationAsync(
                new PosCreateLocationRequest(newCode.Trim().ToUpperInvariant(), newName.Trim(), newKind, newTimeZone.Trim()),
                CancellationToken.None);
            if (!result.IsSuccess || result.Value is null)
            {
                message = result.Error;
                return;
            }

            newCode = string.Empty;
            newName = string.Empty;
            newKind = 1;
            newTimeZone = "Asia/Manila";
            showCreate = false;
            // LoadLocationsAsync re-runs SelectLocation, which clears message,
            // so set the success text AFTER the reload.
            await LoadLocationsAsync(result.Value.Id);
            message ??= "The location was created with conservative operating defaults.";
        }
        catch (HttpRequestException)
        {
            message = "The location service is unavailable. Try again shortly.";
        }
        finally
        {
            working = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        if (!CanManageSettings || selected is not { } location)
        {
            return;
        }

        if (editExpiryDays < 0 || editExpiryDays > 3650)
        {
            message = "Expiry warning must be between 0 and 3650 days.";
            return;
        }

        PosLocationSettings settings = location.Settings with
        {
            NegativeStockPolicy = editNegativePolicy,
            AllowsDirectSupplierDelivery = editDirectDelivery,
            ExpiryWarningDays = editExpiryDays,
        };

        working = true;
        message = null;
        try
        {
            ApiResult<string> result = await Api.UpdateLocationSettingsAsync(location.Id, settings, CancellationToken.None);
            if (!result.IsSuccess)
            {
                message = result.Error;
            }
            else
            {
                // LoadLocationsAsync re-runs SelectLocation, which clears
                // message, so set the success text AFTER the reload.
                await LoadLocationsAsync(location.Id);
                message ??= $"Stock rules saved for {location.Name}.";
            }
        }
        catch (HttpRequestException)
        {
            message = "The location service is unavailable. Try again shortly.";
        }
        finally
        {
            working = false;
        }
    }

    private async Task SaveDetailsAsync()
    {
        if (!CanManageLocations || selected is not { } location)
        {
            return;
        }

        if (!CanSaveDetails)
        {
            message = "Enter a code, name and IANA timezone.";
            return;
        }

        working = true;
        message = null;
        try
        {
            ApiResult<string> result = await Api.UpdateLocationAsync(
                location.Id,
                new PosUpdateLocationRequest(
                    editCode.Trim().ToUpperInvariant(),
                    editName.Trim(),
                    editKind,
                    editTimeZone.Trim()),
                CancellationToken.None);

            if (!result.IsSuccess)
            {
                message = result.Error;
                return;
            }

            // LoadLocationsAsync re-runs SelectLocation, which clears message,
            // so set the success text AFTER the reload.
            await LoadLocationsAsync(location.Id);
            message ??= $"Details saved for {editName.Trim()}.";
        }
        catch (HttpRequestException)
        {
            message = "The location service is unavailable. Try again shortly.";
        }
        finally
        {
            working = false;
        }
    }

    private async Task CloseLocationAsync()
    {
        if (!CanManageLocations || selected is not { } location)
        {
            return;
        }

        if (!DateOnly.TryParse(closeDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly effective))
        {
            message = "Choose the effective closing date.";
            return;
        }

        working = true;
        message = null;
        try
        {
            ApiResult<string> result = await Api.CloseLocationAsync(location.Id, effective, CancellationToken.None);
            if (!result.IsSuccess)
            {
                message = result.Error;
                return;
            }

            showCloseConfirm = false;
            // A closed location leaves the directory, so clear the selection
            // before reloading rather than leaving the panel pointed at a row
            // the list no longer returns.
            selected = null;
            await LoadLocationsAsync();
            message ??= $"{location.Name} was closed. It no longer appears in the directory.";
        }
        catch (HttpRequestException)
        {
            message = "The location service is unavailable. Try again shortly.";
        }
        finally
        {
            working = false;
        }
    }

    private void SelectLocation(PosLocationAdmin location)
    {
        selected = location;
        editNegativePolicy = location.Settings.NegativeStockPolicy;
        editDirectDelivery = location.Settings.AllowsDirectSupplierDelivery;
        editExpiryDays = location.Settings.ExpiryWarningDays;
        editCode = location.Code;
        editName = location.Name;
        editKind = location.Kind;
        editTimeZone = location.TimeZoneId;
        showCloseConfirm = false;
        closeDate = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        message = null;
    }

    private void ToggleCreate() { showCreate = !showCreate; message = null; }
    private void ToggleCloseConfirm() { showCloseConfirm = !showCloseConfirm; message = null; }
    private void OnCloseDateChanged(ChangeEventArgs e) => closeDate = e.Value?.ToString() ?? string.Empty;
    private static string KindName(int kind) => kind == 0 ? "Main warehouse" : "Retail store";
    private static string PolicyName(int policy) => policy switch { 0 => "Negative stock prohibited", 1 => "Permission override", 2 => "Offline review", _ => "Custom policy" };
}
