@page "/inventory/counts/{CountId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@* State, loading and commands live in InventoryCountDetail.razor.cs. *@

<PageTitle>Stock count · VaultFlow</PageTitle>
<div class="inventory-workflow web-workflow">

@if (!CanViewInventory)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view inventory counts.</h2>
        <p>Ask an administrator for the <code>inventory.view</code> permission.</p>
    </section>
}
else if (detail is null && loadingDetail)
{
    <section class="loading-card">Loading the count sheet…</section>
}
else if (detail is null)
{
    <section class="pos-message" role="alert">@(message ?? "This count could not be found.")</section>
}
else
{
    PosInventoryCountSummary count = detail.Count;

    <div class="office-head">
        <div>
            <p class="office-kicker"><a class="count-back" href="/inventory/counts">Stock counts</a> · @StoreName(count.LocationId)</p>
            <h1 class="office-title">@count.Number</h1>
            <p class="office-lead">@SplitWords(count.Kind) · @count.Lines line@(count.Lines == 1 ? "" : "s")@(count.PostedAtUtc is { } posted ? $" · posted {posted.InStoreTime():MMM d, yyyy}" : "")</p>
        </div>
        <span class="@StatusChipClass(count.Status)">@SplitWords(count.Status)</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pos-message" role="status">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(detail.Note))
    {
        <div class="count-note"><strong>Note:</strong> @detail.Note</div>
    }

    @if (!string.IsNullOrWhiteSpace(detail.LastRejectionReason) && IsCounting)
    {
        <div class="count-sent-back" role="alert">
            <strong>Sent back for recounting.</strong>
            <span>@detail.LastRejectionReason</span>
        </div>
    }

    @* The two numbers every decision on this page rests on: how much is left to
       count, and what the variance would do to stock if it were posted. *@
    <section class="count-progress" aria-label="Count progress">
        <div class="count-progress-bar">
            <div class="count-progress-fill" style="width:@(PercentCounted.ToString("0.#", CultureInfo.InvariantCulture))%"></div>
        </div>
        <div class="count-progress-facts">
            <span class="cp-strong">@sheet.CountedLines of @sheet.TotalLines counted</span>
            @if (sheet.RemainingLines > 0)
            {
                <span class="cp-warn">@sheet.RemainingLines still to count</span>
            }
            else
            {
                <span class="cp-done">Sheet complete</span>
            }
            <span>@sheet.VaryingLines line@(sheet.VaryingLines == 1 ? "" : "s") varying</span>
            <span>Net <b class="@VarianceTone(sheet.NetVarianceValue)">@Money(sheet.NetVarianceValue)</b></span>
            <span title="The figure an approver's tier is measured against">Absolute <b>@Money(sheet.AbsoluteVarianceValue)</b></span>
            @if (sheet.HasUnsavedChanges)
            {
                <span class="cp-unsaved">Unsaved changes</span>
            }
        </div>
    </section>

    <section class="count-meta">
        <span><strong>Snapshot</strong>@detail.SnapshotTakenAtUtc.InStoreTime().ToString("MMM d, yyyy HH:mm", CultureInfo.InvariantCulture)</span>
        <span><strong>Created</strong>@detail.Count.CreatedAtUtc.InStoreTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</span>
        @if (detail.SubmittedByUserId is { } submitter)
        {
            <span><strong>Submitted</strong>@(PersonName(submitter) ?? "yes")</span>
        }
        @if (detail.ApprovedByUserId is { } approver)
        {
            <span><strong>Approved</strong>@(PersonName(approver) ?? "yes")</span>
        }
        @if (!string.IsNullOrWhiteSpace(detail.CancellationReason))
        {
            <span><strong>Cancelled</strong>@detail.CancellationReason</span>
        }
    </section>

    @if (IsCounting && CanCount)
    {
        <ScanTarget OnScan="OnScannedAsync" />
        <CameraScanner Enabled="@(!busy)" />
        <div class="scan-strip" role="status">
            <span class="scan-strip-mark" aria-hidden="true">▥</span>
            <span>@(scanNote ?? "Scan items to count them: each scan adds one to that product.")</span>
        </div>
    }

    @* On a full physical the sheet runs to hundreds of lines. Finding one
       product, or just what is left to do, is the whole job. *@
    <section class="sheet-toolbar" aria-label="Find lines">
        <label class="sheet-search">
            <span class="sheet-sr">Search this sheet</span>
            <input type="search" @bind="search" @bind:event="oninput" placeholder="Search product or SKU…" />
        </label>
        <div class="sheet-filters" role="group" aria-label="Show lines">
            @foreach ((CountSheetFilter Key, string Label) choice in FilterChoices)
            {
                <button type="button" class="sheet-filter @(filter == choice.Key ? "is-on" : null)"
                        aria-pressed="@(filter == choice.Key ? "true" : "false")"
                        @onclick="() => filter = choice.Key">
                    @choice.Label<b>@sheet.CountFor(choice.Key).ToString("N0", CultureInfo.InvariantCulture)</b>
                </button>
            }
        </div>
    </section>

    <section class="results-panel sheet-panel" aria-live="polite">
        @if (!VisibleLines.Any())
        {
            <div class="results-empty">
                <strong>No lines match.</strong>
                <span>Clear the search, or choose a different set of lines.</span>
            </div>
        }
        else
        {
            <table class="sheet-table">
                <thead>
                    <tr><th>#</th><th>Product</th><th>Batch</th><th>System</th><th>Counted</th><th>Variance</th><th>Unit cost</th><th>Value</th><th>Counted at</th></tr>
                </thead>
                <tbody>
                    @foreach (PosInventoryCountLineView line in VisibleLines)
                    {
                        <tr @key="line.LineNo" class="@RowClass(line)">
                            <td class="sheet-line-no">@line.LineNo</td>
                            <td>
                                <div class="product-name">@ProductDisplayName(line.ProductId)</div>
                                @if (ProductSku(line.ProductId) is { } sku)
                                {
                                    <div class="product-sku">@sku</div>
                                }
                                @if (line.IsRepeatVariance)
                                {
                                    <span class="repeat-flag" title="This product already varied at this store within the last 90 days">Repeat variance</span>
                                }
                            </td>
                            <td>@(line.BatchId is { } batchId ? ShortId(batchId) : "—")</td>
                            <td class="sheet-number">@Quantity(line.SystemQuantity)</td>
                            <td>
                                @if (IsCounting && CanCount)
                                {
                                    <input class="sheet-input @(sheet.IsDirty(line.LineNo) ? "is-dirty" : null)"
                                           type="number" min="0" step="0.001"
                                           aria-label="@($"Counted quantity for {ProductDisplayName(line.ProductId)}")"
                                           value="@(sheet.Draft(line.LineNo)?.ToString("0.######", CultureInfo.InvariantCulture) ?? string.Empty)"
                                           @onchange="e => OnGaugeChanged(line.LineNo, e)" />
                                }
                                else
                                {
                                    <span class="sheet-number">@(line.PhysicalQuantity is { } saved ? Quantity(saved) : "—")</span>
                                }
                            </td>
                            <td class="@VarianceTone(sheet.Variance(line))">@(sheet.Variance(line) is { } variance ? variance.ToString("+#.###;-#.###;0", CultureInfo.InvariantCulture) : "—")</td>
                            <td class="sheet-number">@Money(line.UnitCost)</td>
                            <td class="sheet-number @VarianceTone(sheet.Value(line))">@(sheet.Value(line) is { } value ? Money(value) : "—")</td>
                            <td class="sheet-muted">@(line.CountedAtUtc?.InStoreTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="sheet-actions">
        @if (IsCounting && CanCount)
        {
            <button type="button" class="action-button primary" @onclick="SaveCountsAsync" disabled="@(busy || !sheet.HasUnsavedChanges)">
                @(busy ? "Saving…" : "Save counts")
            </button>
            <button type="button" class="action-button" @onclick="SubmitAsync" disabled="@(busy || !sheet.IsComplete)">
                Submit for approval
            </button>
            <button type="button" class="action-button danger" @onclick="ToggleCancel" disabled="@busy">
                Cancel count
            </button>
            @if (!sheet.IsComplete)
            {
                <span class="sheet-hint">Every line needs a quantity before this sheet can be submitted — @sheet.RemainingLines to go.</span>
            }
        }
        else if (IsPendingApproval && CanApproveCount)
        {
            <button type="button" class="action-button primary" @onclick="ToggleApprove" disabled="@busy">
                Approve &amp; post
            </button>
            <button type="button" class="action-button" @onclick="ToggleReject" disabled="@busy">
                Send back
            </button>
        }
        else if (IsPendingApproval && CanCount)
        {
            <button type="button" class="action-button danger" @onclick="ToggleCancel" disabled="@busy">
                Cancel count
            </button>
        }
    </section>

    @* Approving writes movements to the ledger and cannot be undone, so it says
       what it is about to post before it does it. *@
    @if (approving)
    {
        <section class="reason-editor confirm-post" role="alertdialog" aria-labelledby="confirm-post-title">
            <strong id="confirm-post-title">Post this variance to stock?</strong>
            <p>
                @sheet.VaryingLines of @sheet.TotalLines line@(sheet.TotalLines == 1 ? "" : "s") disagree with the ledger,
                a net of <b class="@VarianceTone(sheet.NetVarianceValue)">@Money(sheet.NetVarianceValue)</b>
                (@Money(sheet.AbsoluteVarianceValue) absolute). This writes count adjustments against @StoreName(count.LocationId) and cannot be undone.
            </p>
            <div class="reason-actions">
                <button type="button" class="action-button primary" @onclick="ApproveAsync" disabled="@busy">@(busy ? "Posting…" : "Yes, post the variance")</button>
                <button type="button" class="action-button subtle" @onclick="DismissPrompt">Not yet</button>
            </div>
        </section>
    }

    @if (cancelling)
    {
        <section class="reason-editor">
            <label class="reason-label" for="cancel-reason">Reason for cancelling</label>
            <input id="cancel-reason" class="reason-input" type="text" @bind="reasonText" placeholder="Optional" />
            <div class="reason-actions">
                <button type="button" class="action-button danger" @onclick="CancelCountAsync" disabled="@busy">@(busy ? "Cancelling…" : "Confirm cancel")</button>
                <button type="button" class="action-button subtle" @onclick="DismissPrompt">Dismiss</button>
            </div>
        </section>
    }

    @if (rejecting)
    {
        <section class="reason-editor">
            <label class="reason-label" for="reject-reason">Reason for sending back</label>
            <input id="reject-reason" class="reason-input" type="text" @bind="reasonText" placeholder="Say what needs recounting" />
            <div class="reason-actions">
                <button type="button" class="action-button" @onclick="RejectAsync" disabled="@busy">@(busy ? "Returning…" : "Confirm send back")</button>
                <button type="button" class="action-button subtle" @onclick="DismissPrompt">Dismiss</button>
            </div>
        </section>
    }
}

</div>

