@page "/purchasing"
@attribute [Authorize(Policy = "purchase.view")]
@attribute [Authorize(Roles = "Owner")]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Purchase orders · VaultFlow</PageTitle>

<header class="qr-head po-head">
    <div>
        <span class="eyebrow">Purchasing</span>
        <h1>Purchase orders</h1>
        <p>Order from suppliers, approve line by line, and check every delivery against what was ordered.</p>
    </div>
    @if (Session.HasPermission("purchase.create"))
    {
        <a class="po-btn primary" href="purchasing/new">+ New purchase order</a>
    }
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="dashboard-notices" role="status"><p>@message</p></div>
}

@if (NeedsMyApproval.Count > 0)
{
    <button type="button" class="po-callout" @onclick='() => SetStage("PendingApproval")'>
        <strong>@NeedsMyApproval.Count @(NeedsMyApproval.Count == 1 ? "order is" : "orders are") waiting for your approval</strong>
        <span>@PurchasingText.Money(NeedsMyApproval.Sum(o => o.GrandTotal)) in total · Review →</span>
    </button>
}

<nav class="po-stages" aria-label="Filter by stage">
    @foreach ((string key, string label) in StageFilters)
    {
        int count = CountFor(key);
        <button type="button" class="@(stage == key ? "on" : null)" aria-pressed="@((stage == key) ? "true" : "false")" @onclick="() => SetStage(key)">
            @label <span>@count</span>
        </button>
    }
</nav>

<section class="qr-card qr-results">
    <div class="sk-toolbar po-toolbar" role="search">
        <input class="sk-search" type="search" placeholder="Search order number or supplier" aria-label="Search orders"
               @bind="search" @bind:event="oninput" @bind:after="FirstPage" />
        <select aria-label="Supplier" @bind="supplierFilter" @bind:after="FirstPage">
            <option value="">All suppliers</option>
            @foreach (PosSupplier supplier in suppliers.Values.OrderBy(s => s.Name, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@supplier.Id">@supplier.Name</option>
            }
        </select>
        <select aria-label="Deliver to" @bind="destinationFilter" @bind:after="FirstPage">
            <option value="">All destinations</option>
            @foreach (PosLocation location in locations.Values.Where(l => l.Kind is 0 or 1).OrderBy(l => l.Kind).ThenBy(l => l.Code))
            {
                <option value="@location.Id">@location.Code · @location.Name</option>
            }
        </select>
    </div>

    @if (loading)
    {
        <div class="qr-empty"><span class="qr-spinner"></span><p>Loading purchase orders…</p></div>
    }
    else
    {
        List<PosPurchaseOrderSummary> visible = Visible;
        int pageCount = Math.Max(1, (visible.Count + PageSize - 1) / PageSize);
        int currentPage = Math.Clamp(page, 1, pageCount);

        @if (visible.Count == 0)
        {
            <div class="qr-empty">
                <p><strong>No purchase orders here</strong></p>
                <p>@(orders.Count == 0 ? "Start with a new purchase order." : "Try another stage, supplier or search.")</p>
            </div>
        }
        else
        {
            <div class="qr-table-wrap">
                <table class="qr-table po-table">
                    <thead>
                        <tr><th>Order</th><th>Supplier</th><th>Deliver to</th><th>Status</th><th class="num">Total</th><th>Created</th></tr>
                    </thead>
                    <tbody>
                        @foreach (PosPurchaseOrderSummary order in visible.Skip((currentPage - 1) * PageSize).Take(PageSize))
                        {
                            <tr @onclick="() => Open(order.Id)" class="@(IsMineToApprove(order) ? "po-attention" : null)">
                                <td>
                                    <a href="@($"purchasing/{order.Id:D}")" @onclick:stopPropagation="true"><strong>@PurchasingText.OrderName(order.Number)</strong></a>
                                    @if (order.CreatedByUserId == MyId) { <small>Raised by you</small> }
                                </td>
                                <td>@SupplierName(order.SupplierId)</td>
                                <td>@LocationName(order.DestinationLocationId)</td>
                                <td>
                                    <span class="ov-pill tone-@PurchasingText.Tone(order.Status, order.OutstandingQuantity)">@PurchasingText.Label(order.Status, order.OutstandingQuantity)</span>
                                    @if (PurchasingText.IsIncomplete(order.Status, order.OutstandingQuantity))
                                    {
                                        <small class="po-short">@PurchasingText.Quantity(order.OutstandingQuantity) unit@(order.OutstandingQuantity == 1 ? "" : "s") not delivered</small>
                                    }
                                </td>
                                <td class="num"><strong>@PurchasingText.Money(order.GrandTotal)</strong></td>
                                <td>@order.CreatedAtUtc.InStoreTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="sk-pager" aria-label="Order pages">
                <span class="sk-pager-range">Showing @((currentPage - 1) * PageSize + 1)–@Math.Min(currentPage * PageSize, visible.Count) of @visible.Count</span>
                <div class="sk-pages">
                    <button type="button" aria-label="Previous page" disabled="@(currentPage == 1)" @onclick="() => page = currentPage - 1">‹</button>
                    <span class="sk-gap">Page @currentPage of @pageCount</span>
                    <button type="button" aria-label="Next page" disabled="@(currentPage == pageCount)" @onclick="() => page = currentPage + 1">›</button>
                </div>
            </nav>
        }
    }
</section>

@code {
    private const int PageSize = 20;

    private static readonly (string Key, string Label)[] StageFilters =
    [
        ("", "All"),
        ("Draft", "Drafts"),
        ("PendingApproval", "Awaiting approval"),
        ("Approved", "Approved"),
        ("Ordered", "Ordered"),
        ("Incomplete", "Incomplete"),
        ("Done", "Received & closed"),
        ("Stopped", "Rejected & cancelled"),
    ];

    private readonly List<PosPurchaseOrderSummary> orders = [];
    private readonly Dictionary<Guid, PosSupplier> suppliers = [];
    private readonly Dictionary<Guid, PosLocation> locations = [];
    private bool loading = true;
    private string? message;
    private string stage = string.Empty;
    private string search = string.Empty;
    private Guid? supplierFilter;
    private Guid? destinationFilter;
    private int page = 1;

    private Guid MyId => Session.Current?.User.Id ?? Guid.Empty;

    private bool CanApprove => Session.HasPermission("purchase.approve");

    // Someone else's order: the one who raised it may not approve it.
    private bool IsMineToApprove(PosPurchaseOrderSummary order)
        => CanApprove && order.Status == "PendingApproval" && order.CreatedByUserId != MyId;

    private List<PosPurchaseOrderSummary> NeedsMyApproval => [.. orders.Where(IsMineToApprove)];

    private List<PosPurchaseOrderSummary> Visible
    {
        get
        {
            string term = search.Trim();
            return [.. orders
                .Where(o => InStage(o, stage))
                .Where(o => supplierFilter is null || o.SupplierId == supplierFilter)
                .Where(o => destinationFilter is null || o.DestinationLocationId == destinationFilter)
                .Where(o => term.Length == 0
                    || (o.Number?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || SupplierName(o.SupplierId).Contains(term, StringComparison.OrdinalIgnoreCase))];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Task<ApiResult<List<PosPurchaseOrderSummary>>> ordersTask = Api.GetPurchaseOrdersAsync(CancellationToken.None);
            Task<ApiResult<List<PosSupplier>>> suppliersTask = Api.GetSuppliersAsync(CancellationToken.None);
            Task<ApiResult<List<PosLocation>>> locationsTask = Api.GetAsync<List<PosLocation>>("/api/v1/locations", CancellationToken.None);
            await Task.WhenAll(ordersTask, suppliersTask, locationsTask);

            if (ordersTask.Result is { IsSuccess: true, Value: { } list })
            {
                orders.AddRange(list.OrderByDescending(o => o.CreatedAtUtc));
            }
            else
            {
                message = ordersTask.Result.Error;
            }

            foreach (PosSupplier supplier in suppliersTask.Result.Value ?? []) suppliers[supplier.Id] = supplier;
            foreach (PosLocation location in locationsTask.Result.Value ?? []) locations[location.Id] = location;

            // Arriving with work to do: open on what needs a decision.
            if (NeedsMyApproval.Count > 0)
            {
                stage = "PendingApproval";
            }
        }
        catch (HttpRequestException)
        {
            message = "Purchase orders are unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private static bool InStage(PosPurchaseOrderSummary order, string key) => key switch
    {
        "" => true,
        "Incomplete" => PurchasingText.IsIncomplete(order.Status, order.OutstandingQuantity),
        "Done" => order.Status == "FullyReceived" || (order.Status == "Closed" && order.OutstandingQuantity <= 0),
        "Stopped" => order.Status is "Rejected" or "Cancelled",
        _ => order.Status == key,
    };

    private int CountFor(string key) => orders.Count(o => InStage(o, key));

    private void SetStage(string key)
    {
        stage = key;
        page = 1;
    }

    private void FirstPage() => page = 1;

    private void Open(Guid id) => Navigation.NavigateTo(FormattableString.Invariant($"purchasing/{id:D}"));

    private string SupplierName(Guid id) => suppliers.TryGetValue(id, out PosSupplier? supplier) ? supplier.Name : "Unknown supplier";

    private string LocationName(Guid id) => locations.TryGetValue(id, out PosLocation? location) ? $"{location.Code} · {location.Name}" : "—";
}
