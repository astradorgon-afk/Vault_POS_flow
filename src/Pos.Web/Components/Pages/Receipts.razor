@page "/receipts"
@attribute [Authorize(Policy = "receipt.view")]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session
@inject IJSRuntime Js

<PageTitle>Receipts · VaultFlow</PageTitle>

<section class="receipts-head">
    <div>
        <span class="eyebrow">Cash control</span>
        <h1>Receipts</h1>
        <p>Record money moving in and out of the branches — walk-in sales, branch expenses and owner withdrawals — then reprint any of them.</p>
    </div>
    <div class="receipts-head-controls">
        <label class="location-picker">
            <span>Store</span>
            <select value="@(selectedLocationId?.ToString() ?? string.Empty)"
                    @onchange="OnLocationChangedAsync" disabled="@(loadingLocations || !CanViewReceipts)">
                <option value="">All locations</option>
                @foreach (PosLocation location in locations)
                {
                    <option value="@location.Id">@location.Code · @location.Name</option>
                }
            </select>
        </label>
    </div>
</section>

@if (!CanViewReceipts)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view receipts.</h2>
        <p>Ask an administrator for the <code>receipt.view</code> permission.</p>
    </section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="pos-message" role="status">@_message</div>
    }

    <section class="receipt-cards" aria-label="Today's receipt summary">
        <article class="receipt-card receipt-card-lead">
            <span class="card-index">TODAY MONEY IN</span>
            <strong>@Money(MoneyIn)</strong>
            <small>@(_today.Count(receipt => KindValue(receipt.Kind) == WalkInSale)) walk-in sale receipt@(_today.Count(receipt => KindValue(receipt.Kind) == WalkInSale) == 1 ? string.Empty : "s")</small>
        </article>
        <article class="receipt-card">
            <span class="card-index">TODAY MONEY OUT</span>
            <strong>@Money(MoneyOut)</strong>
            <small>@(_today.Count(receipt => KindValue(receipt.Kind) != WalkInSale)) expense and withdrawal receipt@(_today.Count(receipt => KindValue(receipt.Kind) != WalkInSale) == 1 ? string.Empty : "s")</small>
        </article>
        <article class="receipt-card">
            <span class="card-index">LAST NUMBER ISSUED</span>
            <strong class="receipt-last-number">@LastNumber</strong>
            <small>@LastIssuedLabel</small>
        </article>
    </section>

    <div class="receipts-grid">
        <section class="receipts-list">
            <div class="receipt-toolbar">
                <div class="receipt-tabs" role="tablist" aria-label="Receipt types">
                    @foreach (ReceiptTab tab in Tabs)
                    {
                        <button type="button" class="@(_activeKind == tab.Kind ? "active" : string.Empty)"
                                role="tab" aria-selected="@(_activeKind == tab.Kind)"
                                @onclick="() => SetTab(tab.Kind)">
                            @tab.Label
                            @if (tab.Kind is null)
                            {
                                <span>@_today.Count</span>
                            }
                            else
                            {
                                <span>@_today.Count(receipt => KindValue(receipt.Kind) == tab.Kind)</span>
                            }
                        </button>
                    }
                </div>
                <span class="receipt-count">@FilteredReceipts.Count() today</span>
            </div>

            @if (loadingReceipts)
            {
                <div class="results-empty">Reading today's receipts…</div>
            }
            else if (FilteredReceipts.Count() == 0)
            {
                <div class="results-empty"><strong>No receipts yet.</strong><span>This window has no receipts to show.</span></div>
            }
            else
            {
                <table class="receipts-table">
                    <thead>
                        <tr><th>RECEIPT</th><th>TYPE</th><th>PAID TO — RECEIVED FROM</th><th>AMOUNT</th></tr>
                    </thead>
                    <tbody>
                        @foreach (PosReceiptSummary receipt in FilteredReceipts)
                        {
                            <tr @key="receipt.Id">
                                <td>
                                    <strong class="receipt-number">@receipt.Number</strong>
                                    <small>@receipt.IssuedAtUtc.ToLocalTime().ToString("MMM d, yyyy · HH:mm", CultureInfo.InvariantCulture)</small>
                                </td>
                                <td><span class="kind-chip kind-@receipt.Kind.ToLowerInvariant()">@KindLabel(receipt.Kind)</span></td>
                                <td>@(string.IsNullOrWhiteSpace(receipt.Counterparty) ? "—" : receipt.Counterparty)</td>
                                <td class="receipt-amount"><strong>@Money(receipt.Amount)</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <aside class="receipt-command" aria-label="Issue a receipt">
            <span class="eyebrow">Issue a receipt</span>
            <h2>Record cash in or out</h2>
            <p class="receipt-command-lead">Assign an RCT number to money that moved outside a sale — giving a walk-in customer a slip or documenting a branch expense or owner withdrawal.</p>

            @if (!string.IsNullOrWhiteSpace(_issueError))
            {
                <div class="pos-message pos-message-error" role="alert">@_issueError</div>
            }

            <div class="issue-form">
                <label>
                    <span>Type</span>
                    <select @bind="_issueKind" @bind:after="() => _issueError = null">
                        <option value="1">Walk-in sale — money in</option>
                        <option value="2">Branch expense — money out</option>
                        <option value="3">Owner withdrawal — money out</option>
                    </select>
                </label>

                @if (locations.Count > 1)
                {
                    <label>
                        <span>Store</span>
                        <select value="@(selectedLocationId?.ToString() ?? string.Empty)" @onchange="OnLocationChangedAsync">
                            <option value="">All locations</option>
                            @foreach (PosLocation location in locations)
                            {
                                <option value="@location.Id">@location.Code · @location.Name</option>
                            }
                        </select>
                    </label>
                }

                <label>
                    <span>Amount <strong>*</strong></span>
                    <input type="text" inputmode="decimal" placeholder="0.00" @bind="_issueAmount" disabled="@issuing" />
                </label>

                <label>
                    <span>Paid to / received from</span>
                    <input type="text" maxlength="120" placeholder="Customer or supplier name" @bind="_issueCounterparty" disabled="@issuing" />
                </label>

                <label>
                    <span>Reference number <small>optional</small></span>
                    <input type="text" maxlength="40" placeholder="Related document, e.g. a sale number" @bind="_issueReference" disabled="@issuing" />
                </label>

                <label>
                    <span>Note <small>optional</small></span>
                    <input type="text" maxlength="240" placeholder="What the money was for" @bind="_issueNote" disabled="@issuing" />
                </label>

                <button type="button" class="issue-button" @onclick="IssueAsync" disabled="@(issuing || !CanIssueReceipts)">
                    @(issuing ? "Issuing…" : "Issue receipt")
                </button>

                @if (!CanIssueReceipts)
                {
                    <p class="issue-permission-note">Your account needs the <code>receipt.create</code> permission to issue receipts.</p>
                }
            </div>

            @if (_preview is not null)
            {
                <div class="print-preview">
                    <header>
                        <span>PRINT PREVIEW</span>
                        <button type="button" class="copy-button" @onclick="CopyPreviewAsync" disabled="@copying">
                            @(copied ? "Copied" : "Copy text")
                        </button>
                    </header>
                    <pre>@_preview</pre>
                </div>
            }
        </aside>
    </div>
}

@code {
    private const int WalkInSale = 1;

    private readonly List<PosLocation> locations = [];
    private readonly List<PosReceiptSummary> _today = [];
    private Guid? selectedLocationId;
    private int? _activeKind;
    private string? _message;
    private string? _issueError;
    private string _issueAmount = string.Empty;
    private string _issueCounterparty = string.Empty;
    private string _issueReference = string.Empty;
    private string _issueNote = string.Empty;
    private int _issueKind = 1;
    private string? _preview;
    private bool loadingLocations = true;
    private bool loadingReceipts;
    private bool issuing;
    private bool copying;
    private bool copied;

    private record ReceiptTab(int? Kind, string Label);

    private IReadOnlyList<ReceiptTab> Tabs { get; } =
    [
        new(null, "All"),
        new(1, "Walk-in sales"),
        new(2, "Branch expenses"),
        new(3, "Owner withdrawals"),
    ];

    private bool CanViewReceipts => Session.Current?.User.Permissions.Contains("receipt.view", StringComparer.Ordinal) == true;
    private bool CanIssueReceipts => Session.Current?.User.Permissions.Contains("receipt.create", StringComparer.Ordinal) == true;

    private IEnumerable<PosReceiptSummary> FilteredReceipts =>
        _activeKind is { } kind
            ? _today.Where(receipt => KindValue(receipt.Kind) == kind)
            : _today;

    private decimal MoneyIn => _today
        .Where(receipt => KindValue(receipt.Kind) == WalkInSale)
        .Sum(receipt => receipt.Amount);

    private decimal MoneyOut => _today
        .Where(receipt => KindValue(receipt.Kind) != WalkInSale)
        .Sum(receipt => receipt.Amount);

    private string LastNumber
    {
        get
        {
            PosReceiptSummary? latest = _today.OrderByDescending(receipt => receipt.IssuedAtUtc)
                .ThenByDescending(receipt => receipt.Number, StringComparer.Ordinal)
                .FirstOrDefault();
            return latest is null ? "—" : latest.Number;
        }
    }

    private string LastIssuedLabel
    {
        get
        {
            PosReceiptSummary? latest = _today.OrderByDescending(receipt => receipt.IssuedAtUtc)
                .ThenByDescending(receipt => receipt.Number, StringComparer.Ordinal)
                .FirstOrDefault();
            return latest is null
                ? "No receipt issued yet today"
                : latest.IssuedAtUtc.ToLocalTime().ToString("MMM d, yyyy · HH:mm", CultureInfo.InvariantCulture);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!CanViewReceipts)
        {
            loadingLocations = false;
            return;
        }

        ApiResult<List<PosLocation>> response = await Api.GetAsync<List<PosLocation>>(
            "/api/v1/locations",
            CancellationToken.None);
        loadingLocations = false;
        if (!response.IsSuccess || response.Value is null)
        {
            _message = response.Error;
            return;
        }

        HashSet<Guid> assigned = [.. Session.Current?.User.Locations ?? []];
        locations.AddRange(response.Value.Where(location =>
            location.Kind == 1 &&
            (Session.Current?.User.HasAllLocations == true || assigned.Contains(location.Id))));
        selectedLocationId = locations.Count == 1 ? locations[0].Id : null;
        if (locations.Count == 0)
        {
            _message = "No active store is assigned to this account.";
            return;
        }

        await LoadTodayAsync();
    }

    private async Task OnLocationChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        selectedLocationId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
        _activeKind = null;
        _message = null;
        await LoadTodayAsync();
    }

    private void SetTab(int? kind) => _activeKind = kind;

    private async Task LoadTodayAsync()
    {
        loadingReceipts = true;
        _message = null;
        _today.Clear();
        try
        {
            (DateTimeOffset fromUtc, DateTimeOffset toUtc) = TodayWindow();
            ApiResult<List<PosReceiptSummary>> response = await Api.GetReceiptsAsync(
                selectedLocationId, null, fromUtc, toUtc, 200, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                _message = response.Error;
                return;
            }

            _today.AddRange(response.Value);
        }
        catch (HttpRequestException)
        {
            _message = "The receipts ledger is unavailable. Try again shortly.";
        }
        finally
        {
            loadingReceipts = false;
        }
    }

    private async Task IssueAsync()
    {
        _issueError = null;
        if (selectedLocationId is not { } locationId)
        {
            _issueError = "Choose the store the cash event happened at.";
            return;
        }

        if (!decimal.TryParse(_issueAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal amount)
            || amount <= 0m)
        {
            _issueError = "Enter an amount greater than zero.";
            return;
        }

        issuing = true;
        _preview = null;
        copied = false;
        try
        {
            ApiResult<PosNewReceipt> result = await Api.IssueReceiptAsync(new PosIssueReceiptRequest
            {
                LocationId = locationId,
                Kind = _issueKind,
                Amount = decimal.Round(amount, 4, MidpointRounding.ToEven),
                Counterparty = string.IsNullOrWhiteSpace(_issueCounterparty) ? null : _issueCounterparty.Trim(),
                Note = string.IsNullOrWhiteSpace(_issueNote) ? null : _issueNote.Trim(),
                ReferenceNumber = string.IsNullOrWhiteSpace(_issueReference) ? null : _issueReference.Trim(),
            }, CancellationToken.None);

            if (!result.IsSuccess || result.Value is null)
            {
                _issueError = result.Error;
                return;
            }

            _message = "Receipt issued and numbered.";
            _issueAmount = string.Empty;
            _issueCounterparty = string.Empty;
            _issueReference = string.Empty;
            _issueNote = string.Empty;
            _activeKind = null;
            await LoadTodayAsync();
            await LoadPreviewAsync(result.Value.Id);
        }
        catch (HttpRequestException)
        {
            _issueError = "Head office is unreachable. Try again shortly.";
        }
        finally
        {
            issuing = false;
        }
    }

    private async Task LoadPreviewAsync(Guid receiptId)
    {
        ApiResult<string> result = await Api.GetReceiptPrintTextAsync(receiptId, "Plain", CancellationToken.None);
        if (result.IsSuccess)
        {
            _preview = result.Value;
        }
        else
        {
            _preview = null;
            _message = result.Error;
        }
    }

    private async Task CopyPreviewAsync()
    {
        if (_preview is null)
        {
            return;
        }

        copying = true;
        copied = false;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", _preview);
            copied = true;
        }
        catch (JSException)
        {
            _issueError = "The clipboard is unavailable in this browser.";
        }
        finally
        {
            copying = false;
        }
    }

    private static (DateTimeOffset FromUtc, DateTimeOffset ToUtc) TodayWindow()
    {
        DateTime localNow = DateTime.Now;
        DateTime startOfDay = localNow.Date;
        DateTimeOffset startUtc = new DateTimeOffset(startOfDay, TimeZoneInfo.Local.GetUtcOffset(startOfDay)).ToUniversalTime();
        DateTimeOffset endUtc = startUtc.AddDays(1);
        return (startUtc, endUtc);
    }

    private static int KindValue(string kind) =>
        kind switch
        {
            "BranchExpense" => 2,
            "OwnerWithdrawal" => 3,
            _ => 1,
        };

    private static string KindLabel(string kind) =>
        kind switch
        {
            "BranchExpense" => "Branch expense",
            "OwnerWithdrawal" => "Owner withdrawal",
            _ => "Walk-in sale",
        };

    private static string Money(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));
}
