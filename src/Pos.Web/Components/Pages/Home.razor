@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserSession Session

<PageTitle>Operations · VaultFlow</PageTitle>

<section class="home-head">
    <div><span class="eyebrow">Operations overview</span><h1>Good work starts with a clean handoff.</h1><p>Review the live workspace, then move directly into the task at hand.</p></div>
    <div class="policy-chip"><span></span> Policy snapshot @Session.Current?.User.PolicyVersion</div>
</section>

<section class="command-grid">
    <a class="primary-card" href="pos"><span class="card-index">POS / 01</span><div><h2>Start a sale</h2><p>Scan or search the live catalogue and build the customer cart.</p></div><span class="coming-soon">Open transaction workspace →</span></a>
    <article class="status-card"><span class="card-index">ACCESS</span><strong>@(Session.Current?.User.Permissions.Count ?? 0)</strong><p>effective permissions in this session</p></article>
    <article class="status-card"><span class="card-index">SCOPE</span><strong>@ScopeLabel</strong><p>operational location access</p></article>
</section>

<section class="readiness"><div><span class="pulse"></span><strong>API session active</strong></div><p>Access expires @Session.Current?.AccessTokenExpiresAtUtc.ToLocalTime().ToString("t").</p></section>

@code {
    private string ScopeLabel => Session.Current?.User.HasAllLocations == true
        ? "All"
        : (Session.Current?.User.Locations.Count ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
