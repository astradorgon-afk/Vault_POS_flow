    private async Task SelectRoleAsync(Guid roleId)
    {
        selectedRoleId = roleId;
        selectedRole = roles.FirstOrDefault(role => role.Id == roleId);
        message = null;
        roleChangeReason = string.Empty;
        rolePermissionCodes.Clear();
        if (selectedRole is { } role)
        {
            foreach (string code in role.Permissions)
            {
                rolePermissionCodes.Add(code);
            }
        }
    }

    private void ToggleRolePermission(string code)
    {
        if (!rolePermissionCodes.Add(code))
        {
            rolePermissionCodes.Remove(code);
        }
    }

    private async Task SaveRolePermissionsAsync()
    {
        if (selectedRole is not { } role || SelectedRoleIsMine)
        {
            return;
        }

        savingRolePermissions = true;
        message = null;
        try
        {
            ApiResult<string> response = await Api.SetRolePermissionsAsync(
                role.Id, rolePermissionCodes.ToArray(), roleChangeReason.Trim(), CancellationToken.None);
            message = response.IsSuccess
                ? "Role permissions saved."
                : response.Error;
            if (response.IsSuccess)
            {
                roleChangeReason = string.Empty;
                await LoadRolesAsync();
                await SelectRoleAsync(role.Id);
            }
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
        finally
        {
            savingRolePermissions = false;
        }
    }

    private Task SelectUsersTabAsync() => SelectTabAsync("users");

    private Task SelectRolesTabAsync() => SelectTabAsync("roles");

    private async Task SelectTabAsync(string tab)
    {
        if (activeTab == tab)
        {
            return;
        }

        activeTab = tab;
        message = null;
        if (tab == "users" && !hasSearched)
        {
            await FindUsersAsync();
        }

        if (tab == "roles" && roles.Count == 0)
        {
            await LoadRolesAsync();
        }
    }

    private static string TierName(int tier) => tier switch
    {
        1 => "Tier 1",
        2 => "Tier 2",
        3 => "Tier 3",
        4 => "Unlimited",
        _ => "None"
    };

    private static string SplitWords(string value)
        => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");

    private List<string> LocationLabels(IReadOnlyList<Guid> ids)
    {
        List<string> labels = [];
        foreach (Guid id in ids)
        {
            string? label = locations.FirstOrDefault(location => location.Id == id)?.Code;
            labels.Add(label ?? id.ToString()[..8]);
        }
        return labels;
    }

    private string LocationLabel(Guid id)
        => locations.FirstOrDefault(location => location.Id == id) is { } location
            ? $"{location.Code} · {location.Name}"
            : id.ToString();

    private sealed record TierOption(int Value, string Label);
