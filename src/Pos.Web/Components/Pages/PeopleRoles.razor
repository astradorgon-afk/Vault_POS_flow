        }
    }

    // "Maria Santos" becomes "maria", or "maria.santos" when "maria" is taken.
    private void SuggestUserName()
    {
        if (userNameTouched)
        {
            return;
        }

        string[] words = [.. createDisplayName.Trim().ToLowerInvariant()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(word => new string([.. word.Where(char.IsLetterOrDigit)]))
            .Where(word => word.Length > 0)];
        if (words.Length == 0)
        {
            createUserName = string.Empty;
            return;
        }

        string first = words[0];
        bool taken = users.Any(u => string.Equals(u.UserName, first, StringComparison.OrdinalIgnoreCase));
        createUserName = taken && words.Length > 1 ? $"{first}.{words[^1]}" : first;
    }

    private void GeneratePassword()
    {
        // No look-alike characters (0/O, 1/l/I), since it will be read aloud or copied by hand.
        const string alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789";
        createPassword = string.Concat(Enumerable.Range(0, 14)
            .Select(_ => alphabet[System.Security.Cryptography.RandomNumberGenerator.GetInt32(alphabet.Length)]));
        showCreatePassword = true;
    }

    private static bool IsBusinessWide(PosRoleView role) => role.Permissions.Contains("location.all");

    private static int DefaultTier(string roleName) => roleName switch
    {
        "Owner" => 4,
        "Administrator" => 3,
        "MainInventoryManager" => 2,
        "StoreManager" => 1,
        _ => 0,
    };

    // Store jobs first, the way most accounts are created.
    private static int RoleRank(string roleName) => roleName switch
    {
        "Cashier" => 0,
        "StoreManager" => 1,
        "InventoryStaff" => 2,
        "MainInventoryManager" => 3,
        "Administrator" => 4,
        "Auditor" => 5,
        "Owner" => 6,
        _ => 7,
    };

    private static string RoleBlurb(PosRoleView role) => role.Name switch
    {
        "Cashier" => "Sells, takes returns and runs a till at their store.",
        "StoreManager" => "Runs a store: overrides at the till, counts, receiving and transfers.",
        "InventoryStaff" => "Stockroom work: receives deliveries, counts and moves stock. Cannot sell.",
        "MainInventoryManager" => "Runs the warehouse and purchasing; sees stock everywhere.",
        "Administrator" => "Sets up people, stores and devices; approves up to ₱250,000.",
        "Auditor" => "Looks at everything, changes nothing. For accountants and auditors.",
        "Owner" => "Full control of the business, with no approval limit.",
        _ => role.Description,
    };

    private async Task CreateUserAsync()
    {
        if (!CanSubmitCreate)
        {
            return;
        }

        creatingUser = true;
        ClearMessage();
        try
        {
            ApiResult<PosReference> response = await Api.CreateUserAsync(
                new PosCreateUserRequest(
                    createUserName.Trim(),
                    createDisplayName.Trim(),
                    createPassword,
                    string.IsNullOrWhiteSpace(createEmail) ? null : createEmail.Trim(),
                    string.IsNullOrWhiteSpace(createEmployeeCode) ? null : createEmployeeCode.Trim(),
                    createApprovalTier,
                    createRoles.ToArray(),
                    createLocations
                        .Select((locationId, index) => new PosUserLocationSpec(locationId, index == 0))
                        .ToArray()),
                CancellationToken.None);

            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            string createdName = createDisplayName.Trim();
            ResetCreateForm();
            showCreate = false;
            await FindUsersAsync();
            selectedUserId = null;
            selectedUser = null;
            string created = createdName;
            await OpenUserAsync(response.Value.Id);
            ShowSuccess($"Account created for {created}.");
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
        finally
        {
            creatingUser = false;
        }
    }

