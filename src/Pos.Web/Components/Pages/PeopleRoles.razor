    private async Task GrantOverrideAsync()
    {
        if (selectedUser is not { } detail || IsSelf)
        {
            return;
        }

        grantingOverride = true;
        message = null;
        try
        {
            PosOverrideRequest request = new(
                newOverrideCode,
                newOverrideEffect,
                newOverrideReason.Trim(),
                newOverrideExpires?.ToDateTime(TimeOnly.MinValue),
                newOverrideLocationId);
            ApiResult<PosReference> response = await Api.GrantOverrideAsync(detail.User.Id, request, CancellationToken.None);
            if (!response.IsSuccess)
            {
                message = response.Error;
                return;
            }

            newOverrideCode = string.Empty;
            newOverrideReason = string.Empty;
            newOverrideExpires = null;
            newOverrideLocationId = null;
            message = "Override granted.";
            await OpenUserAsync(detail.User.Id);
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
        finally
        {
            grantingOverride = false;
        }
    }

