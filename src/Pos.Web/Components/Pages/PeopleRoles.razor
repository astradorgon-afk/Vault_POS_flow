@page "/admin/users"
@attribute [Authorize(Policy = "people.manage")]
@rendermode InteractiveServer
@using System.Globalization
@using Pos.Web.Services
@inject VaultFlowApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>People &amp; roles · VaultFlow</PageTitle>

<section class="pos-head">
    <div>
        <span class="eyebrow">Administration</span>
        <h1>People &amp; roles</h1>
        <p>Choose a person to change what they can do and where they work. Roles bundle permissions; overrides bend one account without touching its role.</p>
    </div>
</section>

@if (!CanViewAdministration)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot administer people and roles.</h2>
        <p>Ask an administrator for the <code>user.manage</code> or <code>role.manage</code> permission.</p>
    </section>
}
else
{
    <nav class="tab-strip" role="tablist" aria-label="Sections">
        <button type="button" role="tab" aria-selected="@((activeTab == "users") ? "true" : "false")" class="tab@(activeTab == "users" ? " tab-active" : "")" @onclick="SelectUsersTabAsync">People</button>
        <button type="button" role="tab" aria-selected="@((activeTab == "roles") ? "true" : "false")" class="tab@(activeTab == "roles" ? " tab-active" : "")" @onclick="SelectRolesTabAsync">Roles</button>
    </nav>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pr-notice @(messageOk ? "ok" : "bad")" role="@(messageOk ? "status" : "alert")">
            <span class="pr-notice-mark" aria-hidden="true">@(messageOk ? "✓" : "!")</span>
            <span>@message</span>
            <button type="button" aria-label="Dismiss message" @onclick="ClearMessage">×</button>
        </div>
    }

    @if (activeTab == "users")
    {
        bool canManageUsersLocal = CanManageUsers;
        bool modalOpen = canManageUsersLocal && (selectedUserId is not null || showCreate);


        <section class="pr-toolbar" aria-label="Find people">
            <input type="search" class="pr-toolbar-search" placeholder="Search name, user name, e-mail, role or location"
                   aria-label="Search people"
                   @bind="searchText" @bind:event="oninput" @onkeydown="OnSearchKeyAsync" />
            <select aria-label="Filter by location" @bind="locationFilter">
                <option value="">All locations</option>
                @foreach (PosLocation location in AssignableLocations)
                {
                    <option value="@location.Id">@location.Code · @location.Name</option>
                }
            </select>
            <label class="switch-label">
                <input type="checkbox" checked="@includeInactive" @onchange="ToggleIncludeInactiveAsync" />
                <span>Show disabled</span>
            </label>
            <span class="pr-toolbar-count">@VisibleUsers.Count of @users.Count @(users.Count == 1 ? "person" : "people")</span>
            @if (canManageUsersLocal)
            {
                <button type="button" class="pr-btn primary" @onclick="StartCreateAsync">+ New account</button>
            }
        </section>

        <section class="pr-table-card" aria-live="polite">
            @if (loadingUsers)
            {
                <p class="pr-empty">Loading people…</p>
            }
            else if (VisibleUsers.Count == 0)
            {
                <div class="pr-empty">
                    <strong>No one matches</strong>
                    <span>@(string.IsNullOrWhiteSpace(searchText) ? "Try another location, or show disabled accounts." : "Press Enter to search every account for “" + searchText.Trim() + "”.")</span>
                </div>
            }
            else
            {
                <table class="pr-table">
                    <thead>
                        <tr>
                            <th scope="col">Person</th>
                            <th scope="col">Roles</th>
                            <th scope="col">Locations</th>
                            <th scope="col">Status</th>
                            <th scope="col">Last sign-in</th>
                            <th scope="col"><span class="pr-sr">Edit</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PosUserSummary user in VisibleUsers)
                        {
                            <tr class="@(user.IsActive ? "" : "is-disabled") @(selectedUserId == user.Id ? "is-current" : "")" @onclick="() => RequestOpenUserAsync(user.Id)">
                                <td>
                                    <div class="pr-who">
                                        <span class="pr-avatar" aria-hidden="true">@Initials(user.DisplayName)</span>
                                        <div>
                                            <strong>@user.DisplayName</strong>
                                            <span>@@@user.UserName@(string.IsNullOrWhiteSpace(user.Email) ? "" : " · " + user.Email)</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="chip-row">
                                        @if (user.Roles.Count == 0) { <span class="pr-muted">No role</span> }
                                        @foreach (string role in user.Roles) { <span class="pr-chip">@role</span> }
                                    </div>
                                </td>
                                <td>
                                    <div class="chip-row">
                                        @if (user.LocationIds.Count == 0) { <span class="pr-muted">All locations</span> }
                                        @foreach (string place in LocationLabels(user.LocationIds)) { <span class="pr-chip place">@place</span> }
                                    </div>
                                </td>
                                <td>
                                    @if (!user.IsActive) { <span class="status-chip status-disabled">Disabled</span> }
                                    else if (user.TwoFactorEnabled) { <span class="status-chip status-submitted">Active · 2FA</span> }
                                    else { <span class="status-chip status-approved">Active</span> }
                                </td>
                                <td class="pr-muted">@(user.LastLoginAtUtc is { } last ? last.InStoreTime().ToString("d MMM, h:mm tt", CultureInfo.InvariantCulture) : "Never")</td>
                                <td class="pr-row-action">
                                    <button type="button" class="pr-btn" aria-label="Edit @user.DisplayName"
                                            @onclick="() => RequestOpenUserAsync(user.Id)" @onclick:stopPropagation="true">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (modalOpen)
        {
            <div class="pr-overlay" @onclick="RequestCloseUser">
            <div class="pr-dialog" role="dialog" aria-modal="true" aria-labelledby="pr-dialog-title" tabindex="-1"
                 @ref="dialogRef" @onclick:stopPropagation="true" @onkeydown="OnUserDialogKey">
                @if (pendingUserId is { } pending)
                {
                    <div class="pr-confirm" role="alertdialog" aria-label="Unsaved changes">
                        <span>You have unsaved changes for @(showCreate ? "this new account" : selectedUser?.User.DisplayName ?? "this account"). Leave them?</span>
                        <div>
                            <button type="button" class="pr-btn" @onclick="() => pendingUserId = null">Keep editing</button>
                            <button type="button" class="pr-btn danger" @onclick="() => DiscardAndOpenAsync(pending)">Discard changes</button>
                        </div>
                    </div>
                }


                @if (showCreate && canManageUsersLocal)
                {
                    <header class="pr-pane-head">
                        <div class="pr-identity">
                            <span class="pr-avatar big" aria-hidden="true">@(string.IsNullOrWhiteSpace(createDisplayName) ? "+" : Initials(createDisplayName))</span>
                            <div>
                                <h2 id="pr-dialog-title">@(string.IsNullOrWhiteSpace(createDisplayName) ? "New account" : createDisplayName.Trim())</h2>
                                <p>Four quick steps. You can change anything later.</p>
                            </div>
                        </div>
                        <button type="button" class="pr-close" aria-label="Close" @onclick="RequestCloseUser">×</button>
                    </header>

                    <ol class="nc-steps" aria-label="Progress">
                        <li class="@(StepPersonDone ? "done" : "")">Person</li>
                        <li class="@(StepRoleDone ? "done" : "")">Job</li>
                        <li class="@(StepPlaceDone ? "done" : "")">Where</li>
                        <li class="@(StepSignInDone ? "done" : "")">Sign-in</li>
                    </ol>

                    <div class="pr-pane-body">
                        <section class="nc-step @(StepPersonDone ? "done" : "")" aria-labelledby="nc-person">
                            <h3 id="nc-person"><span class="nc-num">@(StepPersonDone ? "✓" : "1")</span> Who is this?</h3>
                            <div class="nc-grid">
                                <label class="pr-field">
                                    <span>Full name</span>
                                    <input type="text" @bind="createDisplayName" @bind:event="oninput" @bind:after="SuggestUserName" placeholder="e.g. Maria Santos" autocomplete="off" />
                                    <small>Shown on receipts and reports.</small>
                                </label>
                                <label class="pr-field">
                                    <span>User name</span>
                                    <input type="text" @bind="createUserName" @bind:event="oninput" @bind:after="() => userNameTouched = true" placeholder="e.g. maria" autocomplete="off" spellcheck="false" />
                                    <small class="@(UserNameProblem is null ? "" : "bad")">@(UserNameProblem ?? "What they type to sign in.")</small>
                                </label>
                            </div>
                            <details class="nc-optional" open="@(createEmail.Length > 0 || createEmployeeCode.Length > 0)">
                                <summary>Add e-mail or employee code <em>optional</em></summary>
                                <div class="nc-grid">
                                    <label class="pr-field"><span>E-mail</span><input type="email" @bind="createEmail" placeholder="name@example.com" /></label>
                                    <label class="pr-field"><span>Employee code</span><input type="text" @bind="createEmployeeCode" placeholder="e.g. EMP-014" /></label>
                                </div>
                            </details>
                        </section>

                        <section class="nc-step @(StepRoleDone ? "done" : "")" aria-labelledby="nc-role">
                            <h3 id="nc-role"><span class="nc-num">@(StepRoleDone ? "✓" : "2")</span> What is their job?</h3>
                            <p class="pr-note">Pick the one that fits. Most people need only one.</p>
                            @if (roles.Count == 0)
                            {
                                <p class="pr-note">The list of jobs could not be loaded.</p>
                            }
                            <div class="nc-roles" role="group" aria-label="Job">
                                @foreach (PosRoleView role in roles.OrderBy(r => RoleRank(r.Name)).ThenBy(r => r.Name, StringComparer.Ordinal))
                                {
                                    bool on = createRoles.Contains(role.Name);
                                    <label class="nc-role @(on ? "on" : "")">
                                        <input type="checkbox" checked="@on" @onchange="() => ToggleCreateRole(role.Name)" />
                                        <span>
                                            <strong>@SplitWords(role.Name)</strong>
                                            <small>@RoleBlurb(role)</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        </section>

                        <section class="nc-step @(StepPlaceDone ? "done" : "")" aria-labelledby="nc-place">
                            <h3 id="nc-place"><span class="nc-num">@(StepPlaceDone ? "✓" : "3")</span> Where do they work?</h3>
                            @if (createRoles.Count > 0 && !CreateNeedsLocation)
                            {
                                <p class="nc-info">@string.Join(" and ", createRoles.Select(SplitWords)) already covers every location, so you can skip this.</p>
                            }
                            else
                            {
                                <p class="pr-note">Their registers and store permissions work only at the places you tick. The first one ticked is their home location.</p>
                            }
                            <div class="pr-locations">
                                @foreach (PosLocation location in AssignableLocations)
                                {
                                    bool on = createLocations.Contains(location.Id);
                                    <label class="pr-location @(on ? "on" : "")">
                                        <input type="checkbox" checked="@on" @onchange="() => ToggleCreateLocation(location.Id)" />
                                        <span><strong>@location.Code</strong> @location.Name</span>
                                        @if (on && createLocations.First() == location.Id)
                                        {
                                            <span class="nc-home">Home</span>
                                        }
                                        <small>@KindName(location.Kind)</small>
                                    </label>
                                }
                            </div>
                        </section>

                        <section class="nc-step @(StepSignInDone ? "done" : "")" aria-labelledby="nc-signin">
                            <h3 id="nc-signin"><span class="nc-num">@(StepSignInDone ? "✓" : "4")</span> How do they sign in?</h3>
                            <p class="pr-note">Set a first password and give it to them privately.</p>
                            <div class="nc-password">
                                <input type="@(showCreatePassword ? "text" : "password")" aria-label="Password" @bind="createPassword" @bind:event="oninput" autocomplete="new-password" spellcheck="false" placeholder="Their first password" />
                                <button type="button" class="pr-btn" @onclick="() => showCreatePassword = !showCreatePassword">@(showCreatePassword ? "Hide" : "Show")</button>
                                <button type="button" class="pr-btn" @onclick="GeneratePassword">Generate</button>
                            </div>
                            <p class="pr-note">Head office checks it against your password rules when you create the account.</p>
                            <label class="pr-field nc-tier">
                                <span>Approval limit</span>
                                <select @bind="createApprovalTier" @bind:after="() => tierTouched = true">
                                    @foreach (TierOption option in TierOptions)
                                    {
                                        <option value="@option.Value">@option.Label</option>
                                    }
                                </select>
                                <small>@TierHint(createApprovalTier)@(tierTouched ? "" : " Set from their job.")</small>
                            </label>
                        </section>
                    </div>

                    <footer class="pr-pane-foot">
                        <span class="@(CanSubmitCreate ? "nc-ready" : "")">@CreateSummary</span>
                        <button type="button" class="pr-btn" @onclick="RequestCloseUser">Cancel</button>
                        <button type="button" class="pr-btn primary" @onclick="CreateUserAsync" disabled="@(creatingUser || !CanSubmitCreate)">
                            @(creatingUser ? "Creating…" : "Create account")
                        </button>
                    </footer>
                }
                else if (selectedUser is { } detail && canManageUsersLocal)
                {
                    <header class="pr-pane-head">
                        <div class="pr-identity">
                            <span class="pr-avatar big" aria-hidden="true">@Initials(detail.User.DisplayName)</span>
                            <div>
                                <h2 id="pr-dialog-title">@detail.User.DisplayName</h2>
                                <p>@@@detail.User.UserName@(string.IsNullOrWhiteSpace(detail.User.Email) ? "" : " · " + detail.User.Email)@(string.IsNullOrWhiteSpace(detail.User.EmployeeCode) ? "" : " · " + detail.User.EmployeeCode)</p>
                                <div class="chip-row">
                                    <span class="status-chip @(detail.User.IsActive ? "status-approved" : "status-disabled")">@(detail.User.IsActive ? "Active" : "Disabled")</span>
                                    @if (detail.User.TwoFactorEnabled) { <span class="status-chip status-submitted">2FA enrolled</span> }
                                    @if (detail.HasPin) { <span class="status-chip status-submitted">PIN set</span> }
                                    @if (detail.IsLockedOut) { <span class="status-chip status-disabled">Locked out</span> }
                                    <span class="pr-meta">@TierName(detail.User.ApprovalTier) · @(detail.User.LastLoginAtUtc is { } last ? "last sign-in " + last.InStoreTime().ToString("d MMM, h:mm tt", CultureInfo.InvariantCulture) : "never signed in")</span>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="pr-close" aria-label="Close" @onclick="RequestCloseUser">×</button>
                    </header>

                    @if (IsSelf)
                    {
                        <div class="pr-self">This is your own account. Nobody changes their own roles, locations, sign-in or status. Ask another administrator.</div>
                    }

                    <nav class="pr-tabs" role="tablist" aria-label="Account sections">
                        @foreach (var (key, label, dirty, count) in DetailTabs(detail))
                        {
                            <button type="button" role="tab" aria-selected="@((detailTab == key) ? "true" : "false")"
                                    class="@(detailTab == key ? "on" : "")" @onclick="() => detailTab = key">
                                @label
                                @if (dirty) { <span class="pr-dot" title="Unsaved changes"></span> }
                                @if (count > 0) { <span class="pr-count">@count</span> }
                            </button>
                        }
                    </nav>

                    <div class="pr-pane-body">
                        @switch (detailTab)
                        {
                            case "access":
                                <div class="pr-card @(RolesDirty ? "dirty" : "")">
                                    <div class="pr-card-head">
                                        <h3>Roles <small>What they can do</small></h3>
                                        @if (RolesDirty && !IsSelf)
                                        {
                                            <span class="pr-unsaved">Unsaved</span>
                                            <button type="button" class="pr-btn" @onclick="UndoRoles">Undo</button>
                                            <button type="button" class="pr-btn primary" @onclick="SaveUserRolesAsync" disabled="@savingRoles">@(savingRoles ? "Saving…" : "Save roles")</button>
                                        }
                                    </div>
                                    <div class="check-grid">
                                        @foreach (PosRoleView role in roles.OrderBy(r => r.Name, StringComparer.Ordinal))
                                        {
                                            bool on = userDetailRoles.Contains(role.Name);
                                            <label class="check-chip @(on ? "on" : "") @(IsSelf ? "static-chip" : "")" title="@role.Description">
                                                <input type="checkbox" checked="@on" disabled="@IsSelf" @onchange="() => ToggleUserRole(role.Name)" />
                                                <span>@role.Name</span>
                                            </label>
                                        }
                                    </div>
                                </div>

                                <div class="pr-card @(LocationsDirty ? "dirty" : "")">
                                    <div class="pr-card-head">
                                        <h3>Locations <small>Where they work</small></h3>
                                        @if (LocationsDirty && !IsSelf)
                                        {
                                            <span class="pr-unsaved">Unsaved</span>
                                            <button type="button" class="pr-btn" @onclick="UndoLocations">Undo</button>
                                            <button type="button" class="pr-btn primary" @onclick="SaveUserLocationsAsync" disabled="@savingLocations">@(savingLocations ? "Saving…" : "Save locations")</button>
                                        }
                                    </div>
                                    <p class="pr-note">Registers at a ticked location accept this person's sign-in. The <strong>home</strong> location is where they usually work.</p>
                                    @if (locations.Count == 0)
                                    {
                                        <p class="pr-note">The location directory is unavailable.</p>
                                    }
                                    <div class="pr-locations">
                                        @foreach (PosLocation location in LocationsFor(userDetailLocations))
                                        {
                                            bool assigned = userDetailLocations.Contains(location.Id);
                                            <div class="pr-location @(assigned ? "on" : "")">
                                                <label>
                                                    <input type="checkbox" checked="@assigned" disabled="@IsSelf" @onchange="() => ToggleUserLocation(location.Id)" />
                                                    <span><strong>@location.Code</strong> @location.Name</span>
                                                </label>
                                                <small>@KindName(location.Kind)</small>
                                                @if (assigned)
                                                {
                                                    <label class="pr-home">
                                                        <input type="radio" name="home-location" checked="@(userDetailPrimaryId == location.Id)" disabled="@IsSelf"
                                                               @onchange="() => userDetailPrimaryId = location.Id" />
                                                        <span>Home</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                                break;

                            case "profile":
                                <div class="pr-card @(ProfileDirty ? "dirty" : "")">
                                    <div class="pr-card-head">
                                        <h3>Profile</h3>
                                        @if (ProfileDirty && !IsSelf)
                                        {
                                            <span class="pr-unsaved">Unsaved</span>
                                            <button type="button" class="pr-btn" @onclick="UndoProfile">Undo</button>
                                            <button type="button" class="pr-btn primary" @onclick="SaveUserDetailsAsync" disabled="@(savingDetails || editDisplayName.Trim().Length == 0)">@(savingDetails ? "Saving…" : "Save profile")</button>
                                        }
                                    </div>
                                    <div class="pr-fields">
                                        <label class="pr-field"><span>Display name</span><input type="text" @bind="editDisplayName" @bind:event="oninput" disabled="@IsSelf" /></label>
                                        <label class="pr-field"><span>E-mail</span><input type="email" @bind="editEmail" @bind:event="oninput" disabled="@IsSelf" /></label>
                                        <label class="pr-field"><span>Employee code</span><input type="text" @bind="editEmployeeCode" @bind:event="oninput" disabled="@IsSelf" /></label>
                                        <label class="pr-field">
                                            <span>Approval tier</span>
                                            <select @bind="editApprovalTier" disabled="@IsSelf">
                                                @foreach (TierOption option in TierOptions)
                                                {
                                                    <option value="@option.Value">@option.Label</option>
                                                }
                                            </select>
                                            <small>@TierHint(editApprovalTier)</small>
                                        </label>
                                    </div>
                                    <p class="pr-note">Created @detail.User.CreatedAtUtc.InStoreTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture).</p>
                                </div>
                                break;

                            case "security":
                                <div class="pr-card">
                                    <h3>Reset password</h3>
                                    <p class="pr-note">Sets a new password. Tell the person privately; their other sessions keep working until they sign out.</p>
                                    <div class="pr-fields">
                                        <label class="pr-field"><span>New password</span><input type="@(showResetPassword ? "text" : "password")" @bind="resetPassword" @bind:event="oninput" autocomplete="new-password" spellcheck="false" disabled="@IsSelf" /></label>
                                        <label class="pr-field"><span>Repeat it</span><input type="@(showResetPassword ? "text" : "password")" @bind="resetPasswordConfirm" @bind:event="oninput" autocomplete="new-password" spellcheck="false" disabled="@IsSelf" /></label>
                                    </div>
                                    <ul class="pr-rules @(resetPassword.Length > 0 ? "checking" : "")">
                                        <li class="@(resetPassword.Length > 0 && resetPassword == resetPasswordConfirm ? "met" : "")">Both entries match</li>
                                    </ul>
                                    <div class="pr-actions">
                                        <button type="button" class="pr-btn" disabled="@IsSelf" @onclick="() => showResetPassword = !showResetPassword">@(showResetPassword ? "Hide" : "Show")</button>
                                        <button type="button" class="pr-btn" disabled="@IsSelf" @onclick="GenerateResetPassword">Generate</button>
                                        <button type="button" class="pr-btn primary" @onclick="ResetPasswordAsync" disabled="@(resettingPassword || IsSelf || ResetPasswordProblem is not null)">@(resettingPassword ? "Resetting…" : ResetPasswordProblem ?? "Reset password")</button>
                                    </div>
                                </div>

                                <div class="pr-card">
                                    <h3>Register PIN <small>@(detail.HasPin ? "A PIN is set" : "No PIN yet")</small></h3>
                                    <p class="pr-note">A quick sign-in at an enrolled register. Six or more digits.</p>
                                    <div class="pr-inline">
                                        <input type="password" inputmode="numeric" autocomplete="off" aria-label="New PIN" placeholder="6+ digits" @bind="pinText" @bind:event="oninput" disabled="@IsSelf" />
                                        <button type="button" class="pr-btn primary" @onclick="SetPinAsync" disabled="@(settingPin || IsSelf || pinText.Length < 6 || !pinText.All(char.IsDigit))">@(settingPin ? "Saving…" : detail.HasPin ? "Replace PIN" : "Set PIN")</button>
                                    </div>
                                    @if (pinText.Length > 0 && !pinText.All(char.IsDigit))
                                    {
                                        <small class="bad">Digits only.</small>
                                    }
                                </div>

                                <div class="pr-card">
                                    <h3>Two-factor sign-in <small>@(detail.User.TwoFactorEnabled ? "Enrolled" : "Not enrolled")</small></h3>
                                    <p class="pr-note">Resetting removes their authenticator; they enrol again at next sign-in. Use this when a phone is lost.</p>
                                    <div class="pr-inline">
                                        <input type="text" aria-label="Reason for resetting two-factor" placeholder="Reason (5+ characters)" @bind="twoFactorReason" @bind:event="oninput" disabled="@(IsSelf || !detail.User.TwoFactorEnabled)" />
                                        <button type="button" class="pr-btn" @onclick="ResetTwoFactorAsync" disabled="@(resettingTwoFactor || IsSelf || !detail.User.TwoFactorEnabled || twoFactorReason.Trim().Length < 5)">@(resettingTwoFactor ? "Resetting…" : "Reset two-factor")</button>
                                    </div>
                                </div>
                                break;

                            case "overrides":
                                <div class="pr-card">
                                    <h3>Overrides <small>One permission, for this person only</small></h3>
                                    @if (detail.Overrides.Count == 0)
                                    {
                                        <p class="pr-note">None. This person gets exactly what their roles give.</p>
                                    }
                                    <div class="override-list">
                                        @foreach (PosUserOverride item in detail.Overrides)
                                        {
                                            <div class="override-row">
                                                <div class="override-main">
                                                    <span class="status-chip @(item.Effect == "Grant" ? "status-approved" : "status-disabled")">@item.Effect</span>
                                                    <code class="override-code">@item.PermissionCode</code>
                                                    <span class="override-scope">@(item.LocationId is { } oid ? $"at {LocationLabel(oid)}" : "everywhere")</span>
                                                    @if (item.ExpiresAtUtc is { } expiry)
                                                    {
                                                        <span class="override-scope">until @expiry.InStoreTime().ToString("d MMM yyyy", CultureInfo.InvariantCulture)</span>
                                                    }
                                                    <span class="override-scope">— @item.Reason</span>
                                                </div>
                                                @if (!IsSelf)
                                                {
                                                    <div class="override-actions">
                                                        @if (revokeTargetId != item.Id)
                                                        {
                                                            <button type="button" class="link-action" @onclick="() => { revokeTargetId = item.Id; revokeReason = string.Empty; }">Revoke…</button>
                                                        }
                                                        else
                                                        {
                                                            <input type="text" class="text-filter" aria-label="Reason for revoking" placeholder="Reason (5+ characters)" @bind="revokeReason" @bind:event="oninput" />
                                                            <button type="button" class="link-action" @onclick="() => RevokeOverrideAsync(item.Id)" disabled="@(revokingOverride || revokeReason.Trim().Length < 5)">@(revokingOverride ? "Revoking…" : "Confirm revoke")</button>
                                                            <button type="button" class="link-action muted" @onclick="() => { revokeTargetId = null; revokeReason = string.Empty; }">Cancel</button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (!IsSelf)
                                {
                                    <div class="pr-card">
                                        <h3>Add an override</h3>
                                        <div class="pr-fields">
                                            <label class="pr-field wide">
                                                <span>Permission</span>
                                                <select @bind="newOverrideCode">
                                                    <option value="">Select a permission…</option>
                                                    @foreach (IGrouping<string, PosPermissionView> module in permissions.GroupBy(p => p.Module).OrderBy(g => g.Key, StringComparer.Ordinal))
                                                    {
                                                        <optgroup label="@SplitWords(module.Key)">
                                                            @foreach (PosPermissionView permission in module.OrderBy(p => p.Code, StringComparer.Ordinal))
                                                            {
                                                                <option value="@permission.Code">@SplitWords(permission.Code)@(permission.IsPrivileged ? " (privileged)" : "")</option>
                                                            }
                                                        </optgroup>
                                                    }
                                                </select>
                                                @if (permissions.FirstOrDefault(p => p.Code == newOverrideCode) is { } chosen)
                                                {
                                                    <small>@chosen.Description</small>
                                                }
                                            </label>
                                            <fieldset class="pr-field pr-segment">
                                                <legend>Effect</legend>
                                                <label class="@(newOverrideEffect == 0 ? "on" : "")"><input type="radio" name="override-effect" checked="@(newOverrideEffect == 0)" @onchange="() => newOverrideEffect = 0" />Grant</label>
                                                <label class="@(newOverrideEffect == 1 ? "on deny" : "")"><input type="radio" name="override-effect" checked="@(newOverrideEffect == 1)" @onchange="() => newOverrideEffect = 1" />Deny</label>
                                            </fieldset>
                                            <label class="pr-field">
                                                <span>Where</span>
                                                <select @bind="newOverrideLocationId">
                                                    <option value="">Everywhere</option>
                                                    @foreach (PosLocation location in AssignableLocations)
                                                    {
                                                        <option value="@location.Id">@location.Code · @location.Name</option>
                                                    }
                                                </select>
                                            </label>
                                            <label class="pr-field">
                                                <span>Expires <em>optional</em></span>
                                                <input type="date" @bind="newOverrideExpires" />
                                            </label>
                                            <label class="pr-field wide">
                                                <span>Reason</span>
                                                <input type="text" @bind="newOverrideReason" @bind:event="oninput" placeholder="Why does this person need it? (5+ characters)" />
                                            </label>
                                        </div>
                                        <div class="pr-actions">
                                            <button type="button" class="pr-btn primary" @onclick="GrantOverrideAsync" disabled="@(grantingOverride || newOverrideCode.Length == 0 || newOverrideReason.Trim().Length < 5)">@(grantingOverride ? "Adding…" : newOverrideEffect == 1 ? "Add deny override" : "Add grant override")</button>
                                        </div>
                                    </div>
                                }
                                break;

                            case "status":
                                <div class="pr-card @(detail.User.IsActive ? "danger" : "")">
                                    @if (detail.User.IsActive)
                                    {
                                        <h3>Disable this account</h3>
                                        <p class="pr-note">They are signed out everywhere and cannot sign in, online or at a register, until re-enabled. Their history is kept.</p>
                                        <div class="pr-inline">
                                            <input type="text" aria-label="Reason for disabling" placeholder="Reason (5+ characters)" @bind="disableReason" @bind:event="oninput" disabled="@IsSelf" />
                                            <button type="button" class="pr-btn danger" @onclick="DisableUserAsync" disabled="@(disablingUser || IsSelf || disableReason.Trim().Length < 5)">@(disablingUser ? "Disabling…" : "Disable account")</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <h3>This account is disabled</h3>
                                        @if (detail.DisabledAtUtc is { } disabledAt)
                                        {
                                            <p class="pr-note">Disabled @disabledAt.InStoreTime().ToString("d MMM yyyy, h:mm tt", CultureInfo.InvariantCulture)@(string.IsNullOrWhiteSpace(detail.DisabledReason) ? "" : " — " + detail.DisabledReason)</p>
                                        }
                                        <div class="pr-actions">
                                            <button type="button" class="pr-btn primary" @onclick="EnableUserAsync" disabled="@(enablingUser || IsSelf)">@(enablingUser ? "Re-enabling…" : "Re-enable account")</button>
                                        </div>
                                    }
                                </div>
                                break;
                        }
                    </div>
                }
                else
                {
                    <p class="pr-placeholder" id="pr-dialog-title">Loading…</p>
                }
            </div>
            </div>
        }
    }
    else
    {
        bool canManageRolesLocal = CanManageRoles;


        <section class="pr-role-grid" aria-live="polite">
            @if (loadingRoles)
            {
                <p class="pr-empty">Loading roles…</p>
            }
            else
            {
                @foreach (PosRoleView role in roles.OrderBy(r => r.Name, StringComparer.Ordinal))
                {
                    <button type="button" class="pr-role-card" @onclick="() => SelectRoleAsync(role.Id)">
                        <span class="pr-role-head">
                            <strong>@role.Name</strong>
                            @if (role.IsSystemRole) { <span class="pr-flag">System</span> }
                        </span>
                        <span class="pr-role-desc">@role.Description</span>
                        <span class="pr-role-meta">@role.Permissions.Count permission@(role.Permissions.Count == 1 ? "" : "s") · @role.MemberCount @(role.MemberCount == 1 ? "person" : "people")</span>
                    </button>
                }
            }
        </section>

        @if (selectedRole is { } selected && canManageRolesLocal)
        {
            <div class="pr-overlay" @onclick="RequestCloseRole">
            <div class="pr-dialog wide" role="dialog" aria-modal="true" aria-labelledby="pr-dialog-title" tabindex="-1"
                 @ref="dialogRef" @onclick:stopPropagation="true" @onkeydown="OnRoleDialogKey">
                @if (pendingRoleClose)
                {
                    <div class="pr-confirm" role="alertdialog" aria-label="Unsaved changes">
                        <span>You have unsaved permission changes for @selected.Name. Leave them?</span>
                        <div>
                            <button type="button" class="pr-btn" @onclick="() => pendingRoleClose = false">Keep editing</button>
                            <button type="button" class="pr-btn danger" @onclick="DiscardRoleChanges">Discard changes</button>
                        </div>
                    </div>
                }
                    <header class="pr-pane-head">
                        <div class="pr-identity">
                            <div>
                                <h2 id="pr-dialog-title">@selected.Name</h2>
                                <p>@selected.Description</p>
                                <div class="chip-row">
                                    <span class="status-chip status-submitted">@selected.MemberCount @(selected.MemberCount == 1 ? "person" : "people")</span>
                                    <span class="pr-meta">@rolePermissionCodes.Count of @permissions.Count permissions</span>
                                    @if (SelectedRoleIsMine) { <span class="status-chip status-disabled">You hold this role</span> }
                                </div>
                            </div>
                        </div>
                        <button type="button" class="pr-close" aria-label="Close" @onclick="RequestCloseRole">×</button>
                    </header>

                    @if (SelectedRoleIsMine)
                    {
                        <div class="pr-self">You hold this role, so you cannot change its permissions. Ask another administrator.</div>
                    }

                    <div class="pr-perm-tools">
                        <input type="search" aria-label="Filter permissions" placeholder="Filter permissions" @bind="permissionFilter" @bind:event="oninput" />
                        <label class="switch-label">
                            <input type="checkbox" @bind="showGrantedOnly" />
                            <span>Only what this role has</span>
                        </label>
                    </div>

                    <div class="pr-pane-body">
                        @foreach (IGrouping<string, PosPermissionView> module in VisiblePermissions.GroupBy(p => p.Module).OrderBy(g => g.Key, StringComparer.Ordinal))
                        {
                            int granted = module.Count(p => rolePermissionCodes.Contains(p.Code));
                            <div class="pr-card">
                                <div class="pr-card-head">
                                    <h3>@SplitWords(module.Key) <small>@granted of @module.Count()</small></h3>
                                    @if (!SelectedRoleIsMine)
                                    {
                                        <button type="button" class="link-action muted" @onclick="() => SetModule(module, true)" disabled="@(granted == module.Count())">Select all</button>
                                        <button type="button" class="link-action muted" @onclick="() => SetModule(module, false)" disabled="@(granted == 0)">Clear</button>
                                    }
                                </div>
                                <div class="pr-perms">
                                    @foreach (PosPermissionView permission in module.OrderBy(p => p.Code, StringComparer.Ordinal))
                                    {
                                        bool on = rolePermissionCodes.Contains(permission.Code);
                                        bool changed = on != selected.Permissions.Contains(permission.Code);
                                        <label class="pr-perm @(on ? "on" : "") @(changed ? "changed" : "")">
                                            <input type="checkbox" checked="@on" disabled="@SelectedRoleIsMine" @onchange="() => ToggleRolePermission(permission.Code)" />
                                            <span>
                                                <strong>@SplitWords(permission.Code)@(permission.IsPrivileged ? " ⛨" : "")</strong>
                                                <small>@permission.Description</small>
                                            </span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        @if (!VisiblePermissions.Any())
                        {
                            <p class="pr-note">No permissions match that filter.</p>
                        }
                    </div>

                    @if (RolePermissionsDirty && !SelectedRoleIsMine)
                    {
                        <footer class="pr-pane-foot">
                            <span class="pr-unsaved">@RoleChangeSummary</span>
                            <input type="text" aria-label="Reason for the change" placeholder="Reason for the change (5+ characters)" @bind="roleChangeReason" @bind:event="oninput" />
                            <button type="button" class="pr-btn" @onclick="UndoRolePermissions">Undo</button>
                            <button type="button" class="pr-btn primary" @onclick="SaveRolePermissionsAsync" disabled="@(savingRolePermissions || roleChangeReason.Trim().Length < 5)">@(savingRolePermissions ? "Saving…" : "Save permissions")</button>
                        </footer>
                    }
            </div>
            </div>
        }
    }
}

@code {
    private const string UserManagePermission = "user.manage";
    private const string RoleManagePermission = "role.manage";

    private static readonly TierOption[] TierOptions =
    [
        new(0, "None"),
        new(1, "Tier 1"),
        new(2, "Tier 2"),
        new(3, "Tier 3"),
        new(4, "Unlimited")
    ];

    private string activeTab = "users";
    private string? message;
    private bool messageOk;
    private string detailTab = "access";
    private Guid? pendingUserId;
    private Guid? locationFilter;
    private string lastServerSearch = string.Empty;
    private string permissionFilter = string.Empty;
    private bool showGrantedOnly;
    private bool pendingRoleClose;
    private ElementReference dialogRef;
    private bool focusDialog;

    private List<PosUserSummary> users = [];
    private List<PosRoleView> roles = [];
    private List<PosPermissionView> permissions = [];
    private List<PosLocation> locations = [];

    private bool loadingUsers;
    private bool loadingRoles;
    private bool hasSearched;
    private string searchText = string.Empty;
    private bool includeInactive;

    private bool showCreate;
    private bool creatingUser;
    private string createUserName = string.Empty;
    private string createDisplayName = string.Empty;
    private string createPassword = string.Empty;
    private string createEmail = string.Empty;
    private string createEmployeeCode = string.Empty;
    private int createApprovalTier;
    private readonly HashSet<string> createRoles = [];
    private readonly List<Guid> createLocations = [];
    private bool userNameTouched;
    private bool tierTouched;
    private bool showCreatePassword;

    private Guid? selectedUserId;
    private PosUserDetail? selectedUser;
    private readonly HashSet<string> userDetailRoles = [];
    private readonly HashSet<Guid> userDetailLocations = [];
    private Guid? userDetailPrimaryId;
    private bool savingRoles;
    private bool savingLocations;

    private Guid? revokeTargetId;
    private string revokeReason = string.Empty;
    private bool revokingOverride;
    private string newOverrideCode = string.Empty;
    private int newOverrideEffect;
    private Guid? newOverrideLocationId;
    private DateOnly? newOverrideExpires;
    private string newOverrideReason = string.Empty;
    private bool grantingOverride;

    private string editDisplayName = string.Empty;
    private string editEmail = string.Empty;
    private string editEmployeeCode = string.Empty;
    private int editApprovalTier;
    private bool savingDetails;
    private string resetPassword = string.Empty;
    private string resetPasswordConfirm = string.Empty;
    private bool resettingPassword;
    private string pinText = string.Empty;
    private bool settingPin;
    private string twoFactorReason = string.Empty;
    private bool resettingTwoFactor;
    private string disableReason = string.Empty;
    private bool disablingUser;
    private bool enablingUser;

    private Guid? selectedRoleId;
    private PosRoleView? selectedRole;
    private readonly HashSet<string> rolePermissionCodes = [];
    private string roleChangeReason = string.Empty;
    private bool savingRolePermissions;

    private bool CanViewAdministration => CanManageUsers || CanManageRoles;
    private bool CanManageUsers => Session.Current?.User.Permissions.Contains(UserManagePermission) ?? false;
    private bool CanManageRoles => Session.Current?.User.Permissions.Contains(RoleManagePermission) ?? false;
    private Guid CurrentUserId => Session.Current?.User.Id ?? Guid.Empty;
    private bool IsSelf => selectedUser is { } detail && detail.User.Id == CurrentUserId;
    private bool SelectedRoleIsMine => selectedRole is { } role
        && Session.Current?.User.Roles.Contains(role.Name, StringComparer.Ordinal) == true;
    private bool PasswordsMatch => ResetPasswordProblem is null;

    // Says what is missing on the button itself, rather than just greying it out.
    private string? ResetPasswordProblem
        => resetPassword.Length == 0 ? "Type a new password"
            : resetPassword != resetPasswordConfirm ? (resetPasswordConfirm.Length == 0 ? "Repeat it to confirm" : "The two entries differ")
            : null;

    private bool showResetPassword;

    private void GenerateResetPassword()
    {
        GeneratePassword();
        resetPassword = createPassword;
        resetPasswordConfirm = createPassword;
        createPassword = string.Empty;
        showCreatePassword = false;
        showResetPassword = true;
    }
    private bool CanSubmitCreate => StepPersonDone && StepRoleDone && StepPlaceDone && StepSignInDone;

    private bool StepPersonDone => createDisplayName.Trim().Length >= 1 && UserNameProblem is null && createUserName.Trim().Length >= 3;

    private bool StepRoleDone => createRoles.Count > 0;

    // A store job means nothing without a store; a business-wide job needs none.
    private bool StepPlaceDone => StepRoleDone && (!CreateNeedsLocation || createLocations.Count > 0);

    private bool StepSignInDone => createPassword.Length > 0;

    private bool CreateNeedsLocation => createRoles.Any(name => roles.FirstOrDefault(r => r.Name == name) is not { } role || !IsBusinessWide(role));

    private string? UserNameProblem
    {
        get
        {
            string name = createUserName.Trim();
            if (name.Length == 0)
            {
                return null;
            }

            if (name.Length < 3)
            {
                return "At least 3 characters.";
            }

            if (name.Any(char.IsWhiteSpace))
            {
                return "No spaces.";
            }

            return users.Any(u => string.Equals(u.UserName, name, StringComparison.OrdinalIgnoreCase))
                ? "Someone already uses that user name."
                : null;
        }
    }

    private string CreateSummary
    {
        get
        {
            List<string> missing = [];
            if (!StepPersonDone) missing.Add("name and user name");
            if (!StepRoleDone) missing.Add("a job");
            else if (!StepPlaceDone) missing.Add("a location");
            if (!StepSignInDone) missing.Add("a password");
            if (missing.Count > 0)
            {
                return "Still needed: " + string.Join(", ", missing);
            }

            string job = string.Join(" and ", createRoles.Select(SplitWords));
            string where = createLocations.Count == 0
                ? "every location"
                : string.Join(", ", createLocations.Select(id => locations.FirstOrDefault(l => l.Id == id)?.Name ?? "a location"));
            return $"Ready: {createDisplayName.Trim()}, {job} at {where}.";
        }
    }

    // Warehouses and stores; the system's external counterparties are not
    // places anybody works.
    private List<PosLocation> AssignableLocations => [.. locations
        .Where(location => location.Kind is 0 or 1)
        .OrderBy(location => location.Kind)
        .ThenBy(location => location.Code, StringComparer.Ordinal)];

    // An assignment to anything else is still shown, so saving never drops it unseen.
    private IEnumerable<PosLocation> LocationsFor(HashSet<Guid> assigned)
        => AssignableLocations.Concat(locations.Where(location => location.Kind is not (0 or 1) && assigned.Contains(location.Id)));

    private List<PosUserSummary> VisibleUsers => [.. users.Where(MatchesFilters)];

    private bool MatchesFilters(PosUserSummary user)
    {
        if (locationFilter is { } location && !user.LocationIds.Contains(location))
        {
            return false;
        }

        string term = searchText.Trim();
        if (term.Length == 0)
        {
            return true;
        }

        return user.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || user.UserName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || user.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) == true
            || user.EmployeeCode?.Contains(term, StringComparison.OrdinalIgnoreCase) == true
            || user.Roles.Any(role => role.Contains(term, StringComparison.OrdinalIgnoreCase))
            || user.LocationIds.Any(id => LocationLabel(id).Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private bool RolesDirty => selectedUser is { } detail && !userDetailRoles.SetEquals(detail.User.Roles);

    private bool LocationsDirty => selectedUser is { } detail
        && (!userDetailLocations.SetEquals(detail.Locations.Select(spec => spec.LocationId))
            || userDetailPrimaryId != detail.Locations.FirstOrDefault(spec => spec.IsPrimary)?.LocationId);

    private bool ProfileDirty => selectedUser is { } detail
        && (editDisplayName != detail.User.DisplayName
            || editEmail != (detail.User.Email ?? string.Empty)
            || editEmployeeCode != (detail.User.EmployeeCode ?? string.Empty)
            || editApprovalTier != detail.User.ApprovalTier);

    private bool AnyDirty => RolesDirty || LocationsDirty || ProfileDirty
        || resetPassword.Length > 0 || pinText.Length > 0
        || (showCreate && CreateDirty);

    private bool CreateDirty => createUserName.Length > 0 || createDisplayName.Length > 0
        || createPassword.Length > 0 || createEmail.Length > 0 || createEmployeeCode.Length > 0
        || createRoles.Count > 0 || createLocations.Count > 0;

    private bool RolePermissionsDirty => selectedRole is { } role && !rolePermissionCodes.SetEquals(role.Permissions);

    private string RoleChangeSummary => selectedRole is { } role
        ? $"{rolePermissionCodes.Except(role.Permissions).Count()} added, {role.Permissions.Except(rolePermissionCodes).Count()} removed"
        : string.Empty;

    private IEnumerable<PosPermissionView> VisiblePermissions => permissions.Where(permission =>
        (!showGrantedOnly || rolePermissionCodes.Contains(permission.Code))
        && (permissionFilter.Trim().Length == 0
            || SplitWords(permission.Code).Contains(permissionFilter.Trim(), StringComparison.OrdinalIgnoreCase)
            || permission.Code.Contains(permissionFilter.Trim(), StringComparison.OrdinalIgnoreCase)
            || permission.Module.Contains(permissionFilter.Trim(), StringComparison.OrdinalIgnoreCase)
            || permission.Description.Contains(permissionFilter.Trim(), StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<(string Key, string Label, bool Dirty, int Count)> DetailTabs(PosUserDetail detail) =>
    [
        ("access", "Access", RolesDirty || LocationsDirty, 0),
        ("profile", "Profile", ProfileDirty, 0),
        ("security", "Sign-in & security", resetPassword.Length > 0 || pinText.Length > 0, 0),
        ("overrides", "Overrides", false, detail.Overrides.Count),
        ("status", detail.User.IsActive ? "Account status" : "Disabled", false, 0),
    ];

    private CancellationTokenSource? noticeTimer;

    private void ClearMessage()
    {
        noticeTimer?.Cancel();
        message = null;
        messageOk = false;
    }

    // Good news fades on its own; problems stay until dismissed.
    private void ShowSuccess(string text)
    {
        message = text;
        messageOk = true;
        noticeTimer?.Cancel();
        CancellationTokenSource timer = new();
        noticeTimer = timer;
        _ = FadeAsync(timer.Token);
    }

    private async Task FadeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
            await InvokeAsync(() =>
            {
                ClearMessage();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // A newer message replaced it, or it was dismissed.
        }
        catch (ObjectDisposedException)
        {
            // The page was left before the notice faded.
        }
    }

    private void ShowResult(bool succeeded, string success, string? error)
    {
        if (succeeded)
        {
            ShowSuccess(success);
        }
        else
        {
            message = error;
            messageOk = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            List<Task> loads =
            [
                LoadLocationsAsync(),
                LoadRolesAsync(),
                LoadPermissionsAsync()
            ];
            await Task.WhenAll(loads);

            if (CanManageUsers)
            {
                await FindUsersAsync();
            }
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
    }

    private async Task LoadLocationsAsync()
    {
        ApiResult<List<PosLocation>> response = await Api.GetAsync<List<PosLocation>>(
            "/api/v1/locations", CancellationToken.None);
        if (response.IsSuccess && response.Value is not null)
        {
            locations = response.Value;
        }
    }

    private async Task LoadRolesAsync()
    {
        if (!CanManageRoles)
        {
            return;
        }

        loadingRoles = true;
        try
        {
            ApiResult<List<PosRoleView>> response = await Api.GetRolesAsync(CancellationToken.None);
            if (response.IsSuccess && response.Value is not null)
            {
                roles = response.Value;
            }
            else
            {
                message = response.Error;
            }
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
        finally
        {
            loadingRoles = false;
        }
    }

    private async Task LoadPermissionsAsync()
    {
        if (!CanManageRoles)
        {
            return;
        }

        ApiResult<List<PosPermissionView>> response = await Api.GetPermissionsAsync(CancellationToken.None);
        if (response.IsSuccess && response.Value is not null)
        {
            permissions = response.Value;
        }
    }

    private async Task FindUsersAsync()
    {
        loadingUsers = true;
        try
        {
            ApiResult<List<PosUserSummary>> response = await Api.GetUsersAsync(
                string.IsNullOrWhiteSpace(searchText) ? null : searchText.Trim(),
                includeInactive,
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            users = response.Value;
            hasSearched = true;
            lastServerSearch = searchText.Trim();
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
        finally
        {
            loadingUsers = false;
        }
    }

    // Typing filters the loaded list at once; Enter asks head office, which
    // also finds accounts beyond the first page.
    private async Task OnSearchKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await FindUsersAsync();
        }
        else if (e.Key == "Escape")
        {
            searchText = string.Empty;
            if (lastServerSearch.Length > 0)
            {
                await FindUsersAsync();
            }
        }
    }

    private async Task ToggleIncludeInactiveAsync(ChangeEventArgs e)
    {
        includeInactive = e.Value is true;
        await FindUsersAsync();
    }

    private async Task StartCreateAsync()
    {
        pendingUserId = null;
        selectedUserId = null;
        selectedUser = null;
        ClearMessage();
        showCreate = true;
        focusDialog = true;
        if (roles.Count == 0)
        {
            await LoadRolesAsync();
        }
    }

    private void CloseCreate()
    {
        ResetCreateForm();
        showCreate = false;
    }

    // Leaving an account with unsaved edits asks first. Guid.Empty stands for
    // "close the account" rather than "open another".
    private async Task RequestOpenUserAsync(Guid userId)
    {
        if (userId == selectedUserId && !showCreate)
        {
            return;
        }

        if (AnyDirty)
        {
            pendingUserId = userId;
            return;
        }

        ClearMessage();
        await OpenUserAsync(userId);
    }

    private void RequestCloseUser()
    {
        if (pendingUserId is not null)
        {
            return;
        }

        if (AnyDirty)
        {
            pendingUserId = Guid.Empty;
            return;
        }

        CloseUser();
    }

    private async Task DiscardAndOpenAsync(Guid userId)
    {
        pendingUserId = null;
        resetPassword = string.Empty;
