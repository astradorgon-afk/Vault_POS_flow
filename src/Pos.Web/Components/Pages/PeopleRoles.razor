    private void ToggleCreateRole(string roleName)
    {
        if (!createRoles.Add(roleName))
        {
            createRoles.Remove(roleName);
        }

        // The approval limit follows the job until someone sets it by hand.
        if (!tierTouched)
        {
            createApprovalTier = createRoles.Count == 0 ? 0 : createRoles.Max(DefaultTier);
        }
    }

    private void ToggleCreateLocation(Guid locationId)
