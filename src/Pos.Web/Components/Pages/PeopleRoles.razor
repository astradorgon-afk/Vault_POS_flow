    private async Task SelectRoleAsync(Guid roleId, bool keepMessage = false)
    {
        selectedRoleId = roleId;
        selectedRole = roles.FirstOrDefault(role => role.Id == roleId);
        if (!keepMessage)
        {
            ClearMessage();
            focusDialog = true;
            pendingRoleClose = false;
            permissionFilter = string.Empty;
        }

        roleChangeReason = string.Empty;
        rolePermissionCodes.Clear();
        if (selectedRole is { } role)
        {
            foreach (string code in role.Permissions)
            {
                rolePermissionCodes.Add(code);
            }
        }
    }

    private void UndoRolePermissions()
    {
        rolePermissionCodes.Clear();
        foreach (string code in selectedRole?.Permissions ?? [])
        {
            rolePermissionCodes.Add(code);
        }
    }

    private void SetModule(IEnumerable<PosPermissionView> module, bool granted)
    {
        foreach (PosPermissionView permission in module)
        {
            if (granted)
            {
                rolePermissionCodes.Add(permission.Code);
            }
            else
            {
                rolePermissionCodes.Remove(permission.Code);
            }
        }
    }

