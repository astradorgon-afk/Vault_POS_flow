    private async Task CreateUserAsync()
    {
        if (!CanSubmitCreate)
        {
            return;
        }

        creatingUser = true;
        message = null;
        try
        {
            ApiResult<PosReference> response = await Api.CreateUserAsync(
                new PosCreateUserRequest(
                    createUserName.Trim(),
                    createDisplayName.Trim(),
                    createPassword,
                    string.IsNullOrWhiteSpace(createEmail) ? null : createEmail.Trim(),
                    string.IsNullOrWhiteSpace(createEmployeeCode) ? null : createEmployeeCode.Trim(),
                    createApprovalTier,
                    createRoles.ToArray(),
                    createLocations
                        .Select(locationId => new PosUserLocationSpec(locationId, false))
                        .ToArray()),
                CancellationToken.None);

            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            ResetCreateForm();
            showCreate = false;
            await FindUsersAsync();
            selectedUserId = null;
            selectedUser = null;
            message = "The account was created.";
            await OpenUserAsync(response.Value.Id);
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
        }
        finally
        {
            creatingUser = false;
        }
    }

    private void ResetCreateForm()
    {
        createUserName = string.Empty;
        createDisplayName = string.Empty;
        createPassword = string.Empty;
        createEmail = string.Empty;
        createEmployeeCode = string.Empty;
        createApprovalTier = 0;
        createRoles.Clear();
        createLocations.Clear();
    }

    private async Task OpenUserAsync(Guid userId)
    {
        if (!CanManageUsers)
        {
            return;
        }

        selectedUserId = userId;
        selectedUser = null;
        message = null;
        revokeTargetId = null;
        revokeReason = string.Empty;
        newOverrideCode = string.Empty;
        newOverrideReason = string.Empty;
        newOverrideExpires = null;
        newOverrideLocationId = null;
        resetPassword = string.Empty;
        resetPasswordConfirm = string.Empty;
        pinText = string.Empty;
        twoFactorReason = string.Empty;
        disableReason = string.Empty;
        newOverrideExpires = null;

        try
        {
            ApiResult<PosUserDetail> response = await Api.GetUserAsync(userId, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                selectedUserId = null;
                return;
            }

            selectedUser = response.Value;
            userDetailRoles.Clear();
            foreach (string roleName in selectedUser.User.Roles)
            {
                userDetailRoles.Add(roleName);
            }

            userDetailLocations.Clear();
            userDetailPrimaryId = null;
            foreach (PosUserLocationSpec spec in selectedUser.Locations)
            {
                userDetailLocations.Add(spec.LocationId);
                if (spec.IsPrimary)
                {
                    userDetailPrimaryId = spec.LocationId;
                }
            }

            editDisplayName = selectedUser.User.DisplayName;
            editEmail = selectedUser.User.Email ?? string.Empty;
            editEmployeeCode = selectedUser.User.EmployeeCode ?? string.Empty;
            editApprovalTier = selectedUser.User.ApprovalTier;
        }
        catch (HttpRequestException)
        {
            message = "The administration service is unavailable. Try again shortly.";
            selectedUserId = null;
        }
    }

    private void ToggleUserRole(string roleName)
    {
        if (!userDetailRoles.Add(roleName))
        {
            userDetailRoles.Remove(roleName);
        }
    }

    private void ToggleUserLocation(Guid locationId)
    {
        if (!userDetailLocations.Add(locationId))
        {
            userDetailLocations.Remove(locationId);
            if (userDetailPrimaryId == locationId)
            {
                userDetailPrimaryId = null;
            }
        }
    }

