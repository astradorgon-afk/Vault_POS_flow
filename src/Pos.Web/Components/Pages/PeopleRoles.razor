    // Keyboard focus moves into a dialog when it opens, so Esc and Tab work
    // from the first keystroke.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusDialog)
        {
            return;
        }

        focusDialog = false;
        try
        {
            await dialogRef.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // The dialog closed before it could take focus.
        }
    }

    private void OnUserDialogKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape")
        {
            return;
        }

        if (pendingUserId is not null)
        {
            pendingUserId = null;
            return;
        }

        RequestCloseUser();
    }

    private void OnRoleDialogKey(KeyboardEventArgs e)
    {
