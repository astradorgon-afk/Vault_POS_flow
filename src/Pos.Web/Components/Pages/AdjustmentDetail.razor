@page "/inventory/adjustments/{AdjustmentId:guid}"
@using System.Globalization
@attribute [Authorize(Policy = "inventory.view")]
@rendermode InteractiveServer
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>Stock adjustment · VaultFlow</PageTitle>

@if (!CanViewInventory)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view stock adjustments.</h2>
        <p>Ask an administrator for the <code>inventory.view</code> permission.</p>
    </section>
}
else if (detail is null && loadingDetail)
{
    <section class="loading-card">Loading the adjustment…</section>
}
else if (detail is null)
{
    <section class="pos-message" role="alert">@(message ?? "This adjustment could not be found.")</section>
}
else
{
    PosStockAdjustmentSummary adjustment = detail.Adjustment;

    <div class="office-head">
        <div>
            <p class="office-kicker">Stock adjustment · @LocationName(adjustment.LocationId)</p>
            <h1 class="office-title">@adjustment.Number</h1>
            <p class="office-lead">@SplitWords(adjustment.Reason) · @detail.Lines.Count line@(detail.Lines.Count == 1 ? "" : "s") · @Money(adjustment.TotalAbsoluteValue) total</p>
        </div>
        <span class="@StatusChipClass(adjustment.Status)">@SplitWords(adjustment.Status)</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pos-message" role="status">@message</div>
    }

    @if (!string.IsNullOrWhiteSpace(detail.Notes))
    {
        <div class="count-note"><strong>Notes:</strong> @detail.Notes</div>
    }

    <section class="count-meta">
        <span><strong>Created</strong>@adjustment.CreatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</span>
        @if (detail.SubmittedAtUtc is { } submitted)
        {
            <span><strong>Submitted</strong>@submitted.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</span>
        }
        @if (detail.DecidedAtUtc is { } decided)
        {
            <span><strong>Decided</strong>@decided.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</span>
        }
        @if (!string.IsNullOrWhiteSpace(detail.RejectionReason))
        {
            <span><strong>Rejected</strong>@detail.RejectionReason</span>
        }
        @if (!string.IsNullOrWhiteSpace(detail.ReversalReason))
        {
            <span><strong>Reversed</strong>@detail.ReversalReason</span>
        }
    </section>

    <section class="results-panel sheet-panel" aria-live="polite">
        <table class="sheet-table">
            <thead>
                <tr><th>#</th><th>Product</th><th>Batch</th><th>Qty</th><th>Unit cost</th><th>Value</th><th>Movement</th></tr>
            </thead>
            <tbody>
                @foreach (PosStockAdjustmentLineView line in detail.Lines)
                {
                    <tr @key="line.LineNo">
                        <td class="sheet-line-no">@line.LineNo</td>
                        <td>
                            <div class="product-name">@ProductDisplayName(line.ProductId)</div>
                            @if (ProductSku(line.ProductId) is { } sku)
                            {
                                <div class="product-sku">@sku</div>
                            }
                        </td>
                        <td>@(line.BatchId is { } batchId ? ShortId(batchId) : "—")</td>
                        <td class="@(line.QuantityDelta >= 0m ? "sheet-gain" : "sheet-loss")">@line.QuantityDelta.ToString("+0.######;-0.######;0", CultureInfo.InvariantCulture)</td>
                        <td class="sheet-number">@line.UnitCost.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                        <td class="sheet-number">@line.AbsoluteValue.ToString("C", CultureInfo.GetCultureInfo("en-PH"))</td>
                        <td class="sheet-muted">@SplitWords(line.MovementType)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

}

@code {
    [Parameter] public Guid AdjustmentId { get; set; }

    private readonly List<PosLocation> locations = [];
    private readonly Dictionary<Guid, (string Sku, string Name)> productNames = [];

    private PosStockAdjustmentDetail? detail;
    private bool loadingDetail = true;
    private string? message;

    private bool CanViewInventory => Session.HasPermission("inventory.view");
    protected override async Task OnInitializedAsync()
    {
        if (!CanViewInventory)
        {
            loadingDetail = false;
            return;
        }

        await LoadDetailAsync();
    }

    private async Task LoadDetailAsync()
    {
        loadingDetail = true;
        try
        {
            ApiResult<List<PosLocation>> locationResponse = await Api.GetAsync<List<PosLocation>>("/api/v1/locations", CancellationToken.None);
            if (locationResponse.IsSuccess && locationResponse.Value is not null)
            {
                locations.Clear();
                locations.AddRange(locationResponse.Value);
            }

            ApiResult<PosStockAdjustmentDetail> response = await Api.GetStockAdjustmentAsync(AdjustmentId, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error ?? "This adjustment could not be found.";
                return;
            }

            detail = response.Value;
            await LoadProductNamesAsync(detail.Lines.Select(line => line.ProductId).Distinct().ToArray());
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            loadingDetail = false;
        }
    }

    private async Task LoadProductNamesAsync(IReadOnlyCollection<Guid> ids)
    {
        HashSet<Guid> wanted = [.. ids];
        foreach (Guid id in wanted)
        {
            productNames[id] = (ShortId(id), "Product");
        }

        try
        {
            for (int offset = 0; offset < 2000 && wanted.Count > 0; offset += 200)
            {
                ApiResult<List<PosProductSummary>> response = await Api.GetProductsAsync(null, offset, 200, CancellationToken.None);
                if (!response.IsSuccess || response.Value is null || response.Value.Count == 0)
                {
                    break;
                }

                foreach (PosProductSummary product in response.Value)
                {
                    if (wanted.Remove(product.Id))
                    {
                        productNames[product.Id] = (product.Sku, product.Name);
                    }
                }

                if (response.Value.Count < 200)
                {
                    break;
                }
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    private string LocationName(Guid locationId)
        => locations.FirstOrDefault(location => location.Id == locationId)?.Name ?? "location";

    private string ProductDisplayName(Guid productId)
        => productNames.TryGetValue(productId, out (string Sku, string Name) product)
            ? product.Name
            : $"Product {ShortId(productId)}";

    private string? ProductSku(Guid productId)
        => productNames.TryGetValue(productId, out (string Sku, string Name) product) && !string.IsNullOrWhiteSpace(product.Sku)
            ? product.Sku
            : null;

    private static string ShortId(Guid value) => value.ToString("D", CultureInfo.InvariantCulture)[..8];

    private static string SplitWords(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        return string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character)
                ? $" {char.ToLowerInvariant(character)}"
                : character.ToString()));
    }

    private static string Money(decimal value) => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));

    private static string StatusChipClass(string status) => status switch
    {
        "Draft" => "status-chip sc-draft",
        "PendingApproval" => "status-chip sc-pending-approval",
        "Posted" => "status-chip sc-posted",
        "Rejected" => "status-chip sc-rejected",
        "Reversed" => "status-chip sc-cancelled",
        _ => "status-chip",
    };
}
