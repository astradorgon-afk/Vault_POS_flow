@page "/stores"
@using System.Globalization
@attribute [Authorize(Policy = "transfer.view")]
@rendermode InteractiveServer
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>Store movement · VaultFlow</PageTitle>

<header class="qr-head st-head">
    <div>
        <span class="eyebrow">Stores</span>
        <h1>Store movement</h1>
    </div>
    <label class="st-period-picker">
        <span class="sr-only">Movement date range</span>
        <select value="@period" @onchange="HandlePeriodChanged" disabled="@loading" aria-label="Movement date range">
            <option value="today">@(period == "today" ? RangeLabel : "Today")</option>
            <option value="7">@(period == "7" ? RangeLabel : "Last 7 days")</option>
            <option value="30">@(period == "30" ? RangeLabel : "Last 30 days")</option>
            <option value="month">@(period == "month" ? RangeLabel : "This month")</option>
        </select>
    </label>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="dashboard-notices" role="status"><p>@message</p></div>
}

@if (loading && report is null)
{
    <section class="qr-card"><div class="qr-empty"><span class="qr-spinner"></span><p>Loading store movements…</p></div></section>
}
else if (report is not null && report.Stores.Count == 0)
{
    <section class="qr-card"><div class="qr-empty"><h2>No stores in your scope.</h2><p>Ask an administrator to assign a store location to this account.</p></div></section>
}
else if (report is not null)
{
    @if (QuietestStore is { } quietest)
    {
        <section class="st-quiet-banner" aria-label="Quietest store">
            <span class="st-quiet-label">Quietest store this period</span>
            <strong>@quietest.Name <small>(@quietest.Code)</small></strong>
            <p>@TransferCount(quietest) transfer@(TransferCount(quietest) == 1 ? "" : "s") · @Quantity(StoreProductsMoved(quietest)) product units moved</p>
        </section>
    }

    <div class="st-grid">
        @foreach (PosStoreMovement store in report.Stores
            .OrderByDescending(StoreProductsMoved)
            .ThenBy(store => store.Name, StringComparer.CurrentCultureIgnoreCase))
        {
            bool isQuietest = QuietestStore?.LocationId == store.LocationId;
            <article class="st-card" @key="store.LocationId">
                <header>
                    <div>
                        <span class="st-code">@store.Code</span>
                        <h2>@store.Name</h2>
                    </div>
                    @if (isQuietest)
                    {
                        <span class="st-last st-quiet-tag">Quietest</span>
                    }
                    else
                    {
                        <span class="st-last">@LastMovementLabel(store)</span>
                    }
                </header>

                <div class="st-flow-total">
                    <span>Product units moved</span>
                    <strong>@Quantity(StoreProductsMoved(store))</strong>
                    <small>@ShareOfMovement(store)% of all stores</small>
                </div>

                <dl class="st-stats">
                    <div><dt>Products in</dt><dd>@Quantity(store.IncomingUnits)</dd><small>@store.InboundTransfers inbound transfers</small></div>
                    <div><dt>Products out</dt><dd>@Quantity(store.OutgoingUnits)</dd><small>@store.OutboundTransfers outbound transfers</small></div>
                    <div><dt>Supply requests</dt><dd>@store.RestockRequests.ToString("N0", CultureInfo.InvariantCulture)</dd><small>@store.PendingApprovalRequests awaiting approval</small></div>
                    <div><dt>Approved, awaiting dispatch</dt><dd>@store.AwaitingDispatchRequests.ToString("N0", CultureInfo.InvariantCulture)</dd></div>
                    <div><dt>Last products received</dt><dd>@LastEventTime(store.LastIncomingAtUtc)</dd></div>
                    <div><dt>Last products sent</dt><dd>@LastEventTime(store.LastOutgoingAtUtc)</dd></div>
                </dl>

                <div class="st-flow-share" role="img" aria-label="@ShareOfMovement(store)% share of product units moved across stores">
                    <span style="width:@ShareOfMovement(store)%"></span>
                </div>
                <div class="st-chart-legend"><span><i class="st-chart-in-key"></i>In @Quantity(store.IncomingUnits)</span><span><i class="st-chart-out-key"></i>Out @Quantity(store.OutgoingUnits)</span></div>
                <div class="st-chart" role="img" aria-label="Incoming and outgoing product units over the selected period">
                    @foreach (PosStoreMovementChartPoint point in store.DailyMovement)
                    {
                        <span class="st-chart-column" title="@ChartBucketLabel(point.Bucket)">
                            <i class="st-chart-in" style="height:@ChartHeight(point.IncomingUnits, store)%"></i>
                            <b class="st-chart-out" style="height:@ChartHeight(point.OutgoingUnits, store)%"></b>
                        </span>
                    }
                </div>

                <div class="st-recent-products">
                    <h3>Latest transfers</h3>
                    @if (store.RecentItems.Count == 0)
                    {
                        <p>No product movement or requests in this period.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (PosStoreMovementItem item in store.RecentItems)
                            {
                                <li @key="(item.Reference, item.ProductName, item.Direction, item.OccurredAtUtc)">
                                    <span><strong>@item.ProductName</strong><small>@item.Reference · @item.Direction</small></span>
                                    <b>@Quantity(item.Units) units</b>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <footer>
                    <a href="transfers">Transfers <AppIcon Name="arrow" /></a>
                    <a href="@($"inventory/stock?store={store.LocationId:D}")">Stock levels <AppIcon Name="arrow" /></a>
                    @if (CanReviewRequests)
                    {
                        <a href="restock/approvals">Requests <AppIcon Name="arrow" /></a>
                    }
                    else if (CanRequestRestock)
                    {
                        <a href="restock">Requests <AppIcon Name="arrow" /></a>
                    }
                </footer>
            </article>
        }
    </div>

    <section class="st-activity" aria-label="Recent store requests and transfers">
        <header>
            <div><span class="eyebrow">Movement ledger</span><h2>Latest transfers and requests</h2></div>
            <a href="transfers">Open transfers <AppIcon Name="arrow" /></a>
        </header>
        @if (report.RecentActivity.Count == 0)
        {
            <div class="st-activity-empty">No dispatched transfers or store requests in this period.</div>
        }
        else
        {
            <div class="st-ledger-scroll">
                <table class="st-ledger">
                    <thead><tr><th>Reference</th><th>Quantity</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody>
                        @foreach (PosStoreMovementActivity entry in report.RecentActivity)
                        {
                            <tr @key="(entry.TransferId, entry.Kind)">
                                <td><a href="@($"transfers/{entry.TransferId:D}")"><strong>@entry.Reference</strong><small>@entry.Kind · @entry.SourceLocationName → @entry.DestinationLocationName</small></a></td>
                                <td><strong>@Quantity(entry.ProductUnits)</strong><small>@(entry.Kind == "Store request" ? "requested" : "units sent")</small></td>
                                <td><span class="st-activity-status @ActivityStatusClass(entry.Status)">@SplitWords(entry.Status)</span></td>
                                <td><time>@entry.OccurredAtUtc.InStoreTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</time></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private PosStoreMovementReport? report;
    private string period = "7";
    private bool loading = true;
    private string? message;

    private static DateOnly Today => StoreClock.Today;

    private (DateOnly From, DateOnly To) Range => period switch
    {
        "today" => (Today, Today),
        "30" => (Today.AddDays(-29), Today),
        "month" => (new DateOnly(Today.Year, Today.Month, 1), Today),
        _ => (Today.AddDays(-6), Today),
    };

    private string RangeLabel => report is null
        ? string.Empty
        : report.From == report.To
            ? report.From.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            : $"{report.From.ToString("MMM d", CultureInfo.InvariantCulture)} – {report.To.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}";

    private PosStoreMovement? QuietestStore => report?.Stores
        .OrderBy(StoreActivityCount)
        .ThenBy(StoreProductsMoved)
        .ThenBy(store => store.Name, StringComparer.CurrentCultureIgnoreCase)
        .FirstOrDefault();

    private bool CanReviewRequests => Session.HasPermission("transfer.approve") &&
        Session.Current?.User.Roles.Contains("Owner", StringComparer.Ordinal) == true;
    private bool CanRequestRestock => Session.WorkLocationKind == 1 && Session.HasPermission("transfer.request");

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task HandlePeriodChanged(ChangeEventArgs args)
    {
        if (args.Value?.ToString() is { } key && key is "today" or "7" or "30" or "month")
        {
            await SelectPeriodAsync(key);
        }
    }

    private async Task SelectPeriodAsync(string key)
    {
        period = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        message = null;
        try
        {
            (DateOnly from, DateOnly to) = Range;
            ApiResult<PosStoreMovementReport> response = await Api.GetStoreMovementsAsync(from, to, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            report = response.Value with
            {
                Stores = [.. response.Value.Stores.Where(store => Session.CanUseInventoryLocation(store.LocationId))],
            };
        }
        catch (HttpRequestException)
        {
            message = "Store movement data is unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private static decimal StoreProductsMoved(PosStoreMovement store) => store.IncomingUnits + store.OutgoingUnits;
    private static int TransferCount(PosStoreMovement store) => store.InboundTransfers + store.OutboundTransfers;
    private static int StoreActivityCount(PosStoreMovement store) => TransferCount(store) + store.RestockRequests;
    private decimal ShareOfMovement(PosStoreMovement store)
    {
        decimal total = report?.Stores.Sum(StoreProductsMoved) ?? 0m;
        return total == 0m ? 0m : decimal.Round(StoreProductsMoved(store) / total * 100m, 0);
    }

    private static string ChartHeight(decimal units, PosStoreMovement store)
    {
        decimal max = store.DailyMovement.Count == 0
            ? 0m
            : store.DailyMovement.Max(point => point.IncomingUnits + point.OutgoingUnits);
        return (max <= 0m ? 0m : decimal.Round(units / max * 100m, 0))
            .ToString(CultureInfo.InvariantCulture);
    }

    private string ChartBucketLabel(int bucket)
    {
        if (report is null)
        {
            return string.Empty;
        }

        int days = report.To.DayNumber - report.From.DayNumber + 1;
        int firstOffset = Math.Min(days - 1, (int)Math.Ceiling(bucket * days / 7d));
        int lastOffset = Math.Min(days - 1, Math.Max(firstOffset, (int)Math.Ceiling((bucket + 1) * days / 7d) - 1));
        DateOnly first = report.From.AddDays(firstOffset);
        DateOnly last = report.From.AddDays(lastOffset);
        return first == last
            ? first.ToString("MMM d", CultureInfo.InvariantCulture)
            : $"{first.ToString("MMM d", CultureInfo.InvariantCulture)}–{last.ToString("MMM d", CultureInfo.InvariantCulture)}";
    }

    private static string Quantity(decimal value) => value.ToString("#,##0.##", CultureInfo.InvariantCulture);

    private static string LastMovementLabel(PosStoreMovement store)
        => Latest(store.LastIncomingAtUtc, store.LastOutgoingAtUtc) is { } at
            ? $"Last movement {at.InStoreTime().ToString("MMM d", CultureInfo.InvariantCulture)}"
            : "No movement yet";

    private static string LastEventTime(DateTimeOffset? at)
        => at is { } instant ? instant.InStoreTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture) : "—";

    private static DateTimeOffset? Latest(DateTimeOffset? first, DateTimeOffset? second)
        => first is { } a && (second is null || a >= second.Value) ? a : second;

    private static string SplitWords(string value)
        => string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character) ? $" {char.ToLowerInvariant(character)}" : character.ToString()));

    private static string ActivityStatusClass(string status) => status switch
    {
        "Cancelled" or "Closed" => "is-closed",
        "Submitted" or "InReview" or "Approved" or "Picking" or "Ready" => "is-pending",
        _ => "is-complete",
    };
}
