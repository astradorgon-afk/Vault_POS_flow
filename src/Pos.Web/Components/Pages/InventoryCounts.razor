@page "/inventory/counts"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Stock counts · VaultFlow</PageTitle>
<div class="inventory-workflow web-workflow counts-page">

<div class="office-head counts-head">
    <div>
        <p class="office-kicker">Inventory control</p>
        <h1 class="office-title">Stock counts</h1>
        <p class="office-lead">Open a sheet, count what is on the shelf, then submit it for approval. Approving posts the variance to stock.</p>
    </div>
    @if (CanViewInventory && CanCount)
    {
        <button type="button" class="counts-new @(showNew ? "is-open" : null)" aria-expanded="@(showNew ? "true" : "false")"
                aria-controls="new-count" @onclick="ToggleNew" disabled="@(selectedLocationId is null)">
            @(showNew ? "Close" : "+ New count")
        </button>
    }
</div>

@if (!CanViewInventory)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view inventory counts.</h2>
        <p>Ask an administrator for the <code>inventory.view</code> permission.</p>
    </section>
}
else
{
    @* Which store, and which sheets: the two choices the page turns on, in one
       bar. Each status shows how many sheets it holds, so "is anything waiting
       for me?" is answered before a click. *@
    <section class="counts-bar" aria-label="Choose counts">
        <label class="counts-store">
            <span>Store</span>
            <select value="@(selectedLocationId?.ToString() ?? string.Empty)"
                    @onchange="OnLocationChangedAsync" disabled="@loadingLocations">
                <option value="">Select a store</option>
                @foreach (PosLocation location in locations)
                {
                    <option value="@location.Id">@location.Code · @location.Name</option>
                }
            </select>
        </label>
        <div class="counts-tabs" role="group" aria-label="Show counts">
            @foreach ((string Status, string Label) tab in StatusTabs)
            {
                <button type="button" class="counts-tab @(selectedStatus == tab.Status ? "is-on" : null) @(tab.Status == "PendingApproval" && CountFor(tab.Status) > 0 ? "is-attention" : null)"
                        aria-pressed="@(selectedStatus == tab.Status ? "true" : "false")"
                        disabled="@(selectedLocationId is null)" @onclick="() => selectedStatus = tab.Status">
                    @tab.Label <b>@CountFor(tab.Status).ToString("N0", CultureInfo.InvariantCulture)</b>
                </button>
            }
        </div>
        <button type="button" class="counts-refresh" @onclick="LoadCountsAsync" disabled="@(loading || selectedLocationId is null)"
                title="Refresh" aria-label="Refresh counts">
            <AppIcon Name="sync" />
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pos-message" role="status">@message</div>
    }

    @if (CanCount && showNew && selectedLocationId is not null)
    {
        <section id="new-count" class="counts-new-panel" aria-labelledby="new-count-title">
            <header>
                <h2 id="new-count-title">New count at @StoreLabel</h2>
                <p>Pick what the sheet covers. A manager can count and approve their own store end-to-end.</p>
            </header>
            <div class="counts-kinds" role="radiogroup" aria-label="What to count">
                @foreach (CountKindOption option in KindOptions)
                {
                    <button type="button" role="radio" class="counts-kind @(selectedKind == option.Value ? "is-on" : null)"
                            aria-checked="@(selectedKind == option.Value ? "true" : "false")" @onclick="() => ChooseKind(option.Value)">
                        <strong>@option.Label</strong>
                        <span>@option.Hint</span>
                    </button>
                }
            </div>
            <div class="counts-new-fields">
                @if (selectedKind is KindCycle or KindCategory)
                {
                    <label class="counts-field">
                        <span>Category</span>
                        <select value="@(selectedCategoryId?.ToString() ?? string.Empty)" @onchange="OnCategoryChangedAsync"
                                disabled="@(CategoryOptions.Count == 0)">
                            <option value="">@(CategoryOptions.Count > 0 ? "Select a category" : "Categories unavailable")</option>
                            @foreach (PosCategory category in CategoryOptions)
                            {
                                <option value="@category.Id">@category.Code · @category.Name</option>
                            }
                        </select>
                    </label>
                }
                <label class="counts-field">
                    <span>Note <em>optional</em></span>
                    <input type="text" @bind="openNote" placeholder="e.g. Monthly shelf count" />
                </label>
            </div>
            @if (selectedKind is KindCycle or KindCategory && CategoryOptions.Count == 0)
            {
                <div class="open-count-hint" role="note">
                    The catalogue is unavailable to this account, so category (and cycle) counts cannot be scoped here. Use a full count instead.
                </div>
            }
            <footer>
                <button type="button" class="counts-cancel" @onclick="ToggleNew">Cancel</button>
                <button type="button" class="search-action" @onclick="OpenCountAsync" disabled="@(!CanOpenCount || opening)">
                    @(opening ? "Opening…" : "Open count sheet")
                </button>
            </footer>
        </section>
    }

    <section class="results-panel" aria-live="polite">
        @if (selectedLocationId is null)
        {
            <div class="results-empty"><strong>Choose a store.</strong><span>Its count sheets appear here.</span></div>
        }
        else if (loading)
        {
            <div class="results-empty">Loading counts…</div>
        }
        else if (VisibleCounts.Count == 0)
        {
            <div class="results-empty">
                <strong>@(counts.Count == 0 ? "No counts at this store yet." : $"No {TabLabel(selectedStatus).ToLowerInvariant()} counts.")</strong>
                @if (counts.Count == 0 && CanCount && !showNew)
                {
                    <button type="button" class="search-action counts-empty-action" @onclick="ToggleNew">Open the first count</button>
                }
            </div>
        }
        else
        {
            <table class="sales-table counts-table rt-stack">
                <thead>
                    <tr><th>Count</th><th>Status</th><th>Progress</th><th>Variance</th><th>Created</th><th>Posted</th></tr>
                </thead>
                <tbody>
                    @foreach (PosInventoryCountSummary count in VisibleCounts)
                    {
                        <tr class="office-row-click @(count.Status == "PendingApproval" ? "row-awaiting" : null)" @key="count.Id" @onclick="() => OpenCount(count.Id)">
                            <td class="sale-number rt-primary">
                                <a href="@($"/inventory/counts/{count.Id:D}")" @onclick:stopPropagation="true">@count.Number</a>
                                <small>@SplitWords(count.Kind)</small>
                            </td>
                            <td data-label="Status"><span class="@StatusChipClass(count.Status)">@SplitWords(count.Status)</span></td>
                            <td class="counted-td" data-label="Progress">
                                <div class="counted-cell">
                                    <span>@count.CountedLines.ToString("N0", CultureInfo.InvariantCulture) of @count.Lines.ToString("N0", CultureInfo.InvariantCulture) lines</span>
                                    <span class="counted-bar"><b style="width:@(Percent(count).ToString("0.#", CultureInfo.InvariantCulture))%"></b></span>
                                </div>
                            </td>
                            <td data-label="Variance">@Money(count.TotalAbsoluteVarianceValue)</td>
                            <td data-label="Created">@count.CreatedAtUtc.InStoreTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</td>
                            <td class="rt-hide-sm" data-label="Posted">@(count.PostedAtUtc?.InStoreTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

</div>

@code {
    private const int KindFullPhysical = 1;
    private const int KindCycle = 2;
    private const int KindCategory = 3;

    private static readonly (string Status, string Label)[] StatusTabs =
    [
        (string.Empty, "All"),
        ("Counting", "Counting"),
        ("PendingApproval", "Awaiting approval"),
        ("Posted", "Posted"),
        ("Cancelled", "Cancelled"),
    ];

    private sealed record CountKindOption(int Value, string Label, string Hint);

    private static readonly CountKindOption[] KindOptions =
    [
        new(KindFullPhysical, "Full physical", "Every product at the store."),
        new(KindCycle, "Cycle", "One category, on a rotation."),
        new(KindCategory, "Category", "One category, as a one-off."),
    ];

    private readonly List<PosLocation> locations = [];
    private readonly List<PosCategory> categoryOptions = [];
    private readonly List<PosInventoryCountSummary> counts = [];

    private Guid? selectedLocationId;
    private string selectedStatus = string.Empty;
    private int selectedKind = KindFullPhysical;
    private Guid? selectedCategoryId;
    private string openNote = string.Empty;

    private bool loadingLocations = true;
    private bool loading;
    private bool opening;
    private bool showNew;
    private string? message;

    private bool CanViewInventory => Session.HasPermission("inventory.view");
    private bool CanCount => Session.HasPermission("inventory.count");

    private List<PosCategory> CategoryOptions => categoryOptions;

    private bool CanOpenCount =>
        selectedLocationId is not null &&
        (selectedKind is KindCycle or KindCategory
            ? selectedCategoryId is not null
            : true);

    /// <summary>The sheets on the chosen status tab. Every status is loaded at
    /// once so each tab can say how many it holds.</summary>
    private List<PosInventoryCountSummary> VisibleCounts => string.IsNullOrEmpty(selectedStatus)
        ? counts
        : [.. counts.Where(count => count.Status == selectedStatus)];

    private int CountFor(string status) => string.IsNullOrEmpty(status)
        ? counts.Count
        : counts.Count(count => count.Status == status);

    private static string TabLabel(string status) => StatusTabs.FirstOrDefault(tab => tab.Status == status).Label ?? status;

    private string StoreLabel => locations.FirstOrDefault(location => location.Id == selectedLocationId) is { } store
        ? store.Name
        : "this store";

    protected override async Task OnInitializedAsync()
    {
        if (!CanViewInventory)
        {
            loadingLocations = false;
            return;
        }

        await LoadLocationsAsync();
        if (CanCount)
        {
            await LoadCategoriesAsync();
        }

        // A store already chosen for this session, or the only one this account
        // has, needs no second act of selection before the page says anything.
        if (selectedLocationId is not null)
        {
            await LoadCountsAsync();
        }
    }

    private async Task LoadLocationsAsync()
    {
        ApiResult<List<PosLocation>> response = await Api.GetLocationsAsync(CancellationToken.None);
        loadingLocations = false;
        if (!response.IsSuccess || response.Value is null)
        {
            message = response.Error;
            return;
        }

        locations.AddRange(response.Value.Where(location =>
            location.Kind == 1 && location.IsActive && Session.CanUseInventoryLocation(location.Id)));
        selectedLocationId = Session.WorkLocationId is { } preferred
            ? locations.Any(location => location.Id == preferred) ? preferred : null
            : locations.Count == 1 ? locations[0].Id : null;
        if (locations.Count == 0)
        {
            message = "No active store is available to this account.";
        }
    }

    private async Task LoadCategoriesAsync()
    {
        ApiResult<List<PosCategory>> response = await Api.GetCategoriesAsync(CancellationToken.None);
        if (response.IsSuccess && response.Value is not null)
        {
            categoryOptions.AddRange(response.Value.Where(c => c.IsActive).OrderBy(c => c.Name));
        }
    }

    /// <summary>
    /// Choosing a store loads it. Making the reader pick a store and then press
    /// a button to see anything made an empty panel the normal first sight of
    /// this page.
    /// </summary>
    private Task OnLocationChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        selectedLocationId = Guid.TryParse(e.Value?.ToString(), out Guid id) && locations.Any(location => location.Id == id) ? id : null;
        counts.Clear();
        message = null;
        if (selectedLocationId is null)
        {
            showNew = false;
        }

        return selectedLocationId is null ? Task.CompletedTask : LoadCountsAsync();
    }

    private void ToggleNew()
    {
        showNew = !showNew;
        message = null;
    }

    private void ChooseKind(int kind)
    {
        selectedKind = kind;
        selectedCategoryId = null;
        message = null;
    }

    private void OnCategoryChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        selectedCategoryId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
    }

    private async Task LoadCountsAsync()
    {
        if (selectedLocationId is not { } locationId || !locations.Any(location => location.Id == locationId))
        {
            message = "Select an assigned store before searching.";
            return;
        }

        loading = true;
        message = null;
        counts.Clear();
        try
        {
            ApiResult<List<PosInventoryCountSummary>> response = await Api.GetInventoryCountsAsync(
                locationId,
                null,
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            counts.AddRange(response.Value);
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OpenCountAsync()
    {
        if (selectedLocationId is not { } locationId || !locations.Any(location => location.Id == locationId))
        {
            message = "Select an assigned store before opening a count.";
            return;
        }

        List<Guid>? categoryIds = selectedKind is KindCycle or KindCategory
            && selectedCategoryId is { } categoryId
            ? [categoryId]
            : null;

        opening = true;
        message = null;
        try
        {
            ApiResult<PosReference> response = await Api.OpenInventoryCountAsync(
                locationId,
                selectedKind,
                categoryIds,
                string.IsNullOrWhiteSpace(openNote) ? null : openNote.Trim(),
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            openNote = string.Empty;
            selectedCategoryId = null;
            Navigation.NavigateTo($"/inventory/counts/{response.Value.Id:D}");
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            opening = false;
        }
    }

    private void OpenCount(Guid countId) => Navigation.NavigateTo($"/inventory/counts/{countId:D}");

    private static string SplitWords(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        return string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character)
                ? $" {char.ToLowerInvariant(character)}"
                : character.ToString()));
    }

    private static string Money(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));

    private static double Percent(PosInventoryCountSummary count)
        => count.Lines == 0 ? 0d : count.CountedLines * 100d / count.Lines;

    private static string StatusChipClass(string status) => status switch
    {
        "Counting" => "status-chip sc-counting",
        "PendingApproval" => "status-chip sc-pending-approval",
        "Posted" => "status-chip sc-posted",
        "Cancelled" => "status-chip sc-cancelled",
        _ => "status-chip",
    };
}
