@page "/inventory/counts"
@using System.Globalization
@attribute [Authorize(Policy = "inventory.view")]
@rendermode InteractiveServer
@inject VaultFlowApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Stock counts · VaultFlow</PageTitle>

<div class="office-head">
    <div>
        <p class="office-kicker">Inventory control</p>
        <h1 class="office-title">Stock counts</h1>
        <p class="office-lead">Stock counts each store runs at its register, with the variance each approved count posted to stock.</p>
    </div>
    <div class="head-pickers">
        <label class="location-picker">
            <span>Store</span>
            <select value="@(selectedLocationId?.ToString() ?? string.Empty)"
                    @onchange="OnLocationChangedAsync" disabled="@loadingLocations">
                <option value="">Select a store</option>
                @foreach (PosLocation location in locations)
                {
                    <option value="@location.Id">@location.Code · @location.Name</option>
                }
            </select>
        </label>
        <label class="location-picker">
            <span>Status</span>
            <select @bind="selectedStatus" disabled="@(selectedLocationId is null)">
                <option value="">All states</option>
                @foreach (string statusName in StatusNames)
                {
                    <option value="@statusName">@SplitWords(statusName)</option>
                }
            </select>
        </label>
    </div>
</div>

@if (!CanViewInventory)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view inventory counts.</h2>
        <p>Ask an administrator for the <code>inventory.view</code> permission.</p>
    </section>
}
else
{
    <section class="search-strip">
        <span>@(counts.Count) count@(counts.Count == 1 ? "" : "s")@(searchedLabel.Length > 0 ? $" · {searchedLabel}" : "")</span>
        <button type="button" class="search-action" @onclick="LoadCountsAsync"
                disabled="@(loading || selectedLocationId is null)">
            @(loading ? "Loading…" : "Find counts")
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pos-message" role="status">@message</div>
    }

    <section class="results-panel" aria-live="polite">
        @if (loading)
        {
            <div class="results-empty">Loading counts…</div>
        }
        else if (counts.Count == 0)
        {
            <div class="results-empty"><strong>No counts yet.</strong><span>Choose a store, then open a count or find existing sheets.</span></div>
        }
        else
        {
            <table class="sales-table counts-table">
                <thead>
                    <tr><th>COUNT #</th><th>Kind</th><th>Status</th><th>Counted</th><th>Variance</th><th>Created</th><th>Posted</th></tr>
                </thead>
                <tbody>
                    @foreach (PosInventoryCountSummary count in counts)
                    {
                        <tr class="office-row-click" @key="count.Id" @onclick="() => OpenCount(count.Id)">
                            <td class="sale-number">@count.Number</td>
                            <td>@SplitWords(count.Kind)</td>
                            <td><span class="@StatusChipClass(count.Status)">@SplitWords(count.Status)</span></td>
                            <td>@count.CountedLines / @count.Lines</td>
                            <td>@Money(count.TotalAbsoluteVarianceValue)</td>
                            <td>@count.CreatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@(count.PostedAtUtc?.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private static readonly string[] StatusNames = ["Counting", "PendingApproval", "Posted", "Cancelled"];

    private readonly List<PosLocation> locations = [];
    private readonly List<PosInventoryCountSummary> counts = [];

    private Guid? selectedLocationId;
    private string selectedStatus = string.Empty;

    private bool loadingLocations = true;
    private bool loading;
    private string? message;
    private string searchedLabel = string.Empty;

    private bool CanViewInventory => Session.HasPermission("inventory.view");
    protected override async Task OnInitializedAsync()
    {
        if (!CanViewInventory)
        {
            loadingLocations = false;
            return;
        }

        await LoadLocationsAsync();
    }

    private async Task LoadLocationsAsync()
    {
        ApiResult<List<PosLocation>> response = await Api.GetAsync<List<PosLocation>>("/api/v1/locations", CancellationToken.None);
        loadingLocations = false;
        if (!response.IsSuccess || response.Value is null)
        {
            message = response.Error;
            return;
        }

        locations.AddRange(response.Value.Where(location => location.Kind == 1));
        selectedLocationId = locations.Count == 1 ? locations[0].Id : null;
        if (locations.Count == 0)
        {
            message = "No active store is available to this account.";
        }
    }

    private void OnLocationChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        selectedLocationId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
        counts.Clear();
        searchedLabel = string.Empty;
        message = null;
    }

    private async Task LoadCountsAsync()
    {
        if (selectedLocationId is not { } locationId)
        {
            message = "Select the store before searching.";
            return;
        }

        loading = true;
        message = null;
        counts.Clear();
        try
        {
            ApiResult<List<PosInventoryCountSummary>> response = await Api.GetInventoryCountsAsync(
                locationId,
                string.IsNullOrWhiteSpace(selectedStatus) ? null : selectedStatus,
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            counts.AddRange(response.Value);
            searchedLabel = string.IsNullOrWhiteSpace(selectedStatus)
                ? "all states"
                : SplitWords(selectedStatus);
            if (counts.Count == 0)
            {
                message = "No counts matched that store and state.";
            }
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCount(Guid countId) => Navigation.NavigateTo($"/inventory/counts/{countId:D}");

    private static string SplitWords(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        return string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character)
                ? $" {char.ToLowerInvariant(character)}"
                : character.ToString()));
    }

    private static string Money(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));

    private static string StatusChipClass(string status) => status switch
    {
        "Counting" => "status-chip sc-counting",
        "PendingApproval" => "status-chip sc-pending-approval",
        "Posted" => "status-chip sc-posted",
        "Cancelled" => "status-chip sc-cancelled",
        _ => "status-chip",
    };
}

