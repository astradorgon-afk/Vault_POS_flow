@page "/reports"
@attribute [Authorize(Policy = "report.view")]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>Daily inventory operations · VaultFlow</PageTitle>

<header class="report-page-head">
    <div>
        <span class="eyebrow">Daily snapshot</span>
        <h1>Inventory operations</h1>
        <p>Review one business date: transfers in/out, restock requests, and stock movements for this @(SelectedIsWarehouse ? "warehouse" : "location").</p>
    </div>
    <div class="report-pickers">
        <label><span>Location</span><select @bind="selectedLocationId"><option value="">Select a location</option>@foreach (PosLocation location in ScopedLocations){<option value="@location.Id">@location.Code · @location.Name</option>}</select></label>
        <label><span>Business date</span><input type="date" @bind="selectedDate" /></label>
        <button type="button" @onclick="LoadReportAsync" disabled="@(!CanLoad || loading)">@(loading ? "Loading…" : "Open report")</button>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="report-message" role="status">@message</div>
}

@if (loading)
{
    <section class="report-empty" aria-live="polite"><span class="book-mark">VF</span><div><strong>Building the daily operations summary</strong><small>Reading transfers, restocks and stock movements.</small></div></section>
}
else if (report is null)
{
    <section class="report-empty"><span class="book-mark" aria-hidden="true">VF</span><div><strong>Choose a location and business date.</strong><small>The daily operations report covers transfers, restocks and stock movements for stores and the main warehouse.</small></div></section>
}
else
{
    <section class="report-banner @(SelectedIsWarehouse ? "is-warehouse" : null)">
        <span class="banner-icon" aria-hidden="true"><AppIcon Name="@(SelectedIsWarehouse ? "box" : "location")" /></span>
        <div class="banner-identity">
            <strong>@report.Name</strong>
            <small>@selectedDate.ToString("dddd, MMMM d, yyyy", CultureInfo.InvariantCulture)</small>
        </div>
        <div class="banner-stat">
            <span aria-hidden="true"><AppIcon Name="transfer" /></span>
            <div><strong>@DispatchedHere</strong><small>transfers dispatched</small></div>
        </div>
    </section>

    <section class="stat-row" aria-label="Daily movement totals">
        <article class="stat-card">
            <span class="stat-label">Incoming</span>
            <div class="stat-figure">
                <strong>@Qty(report.IncomingUnits)</strong>
                <span class="stat-badge is-in" aria-hidden="true"><AppIcon Name="box-in" /></span>
            </div>
            <small>@InboundSources(report)</small>
        </article>
        <article class="stat-card">
            <span class="stat-label">Outgoing</span>
            <div class="stat-figure">
                <strong>@Qty(report.OutgoingUnits)</strong>
                <span class="stat-badge is-out" aria-hidden="true"><AppIcon Name="box-out" /></span>
            </div>
            <small>@report.OutboundTransfers outbound transfer@(report.OutboundTransfers == 1 ? "" : "s")</small>
        </article>
        <article class="stat-card">
            <span class="stat-label">Restock requests</span>
            <div class="stat-figure">
                <strong>@report.RestockRequests</strong>
                @if (report.PendingApprovalRequests > 0)
                {
                    <span class="stat-pill">@report.PendingApprovalRequests pending</span>
                }
            </div>
            <small>@report.AwaitingDispatchRequests awaiting dispatch</small>
        </article>
        <article class="stat-card">
            <span class="stat-label">Net movement</span>
            <div class="stat-figure">
                <strong class="@(NetUnits >= 0 ? "positive" : "negative")">@(NetUnits > 0 ? "+" : string.Empty)@Qty(NetUnits)</strong>
            </div>
            <small>@(NetUnits >= 0 ? "Units added to stock" : "Units released from stock")</small>
        </article>
    </section>

    <div class="report-grid">
        <section class="report-panel" aria-labelledby="recent-activity-title">
            <header>
                <div>
                    <h2 id="recent-activity-title">Recent movements</h2>
                    <p>Latest activity for this @(SelectedIsWarehouse ? "warehouse" : "store")</p>
                </div>
                @if (LocationActivity.Count > ActivityPreviewCount)
                {
                    <button type="button" class="panel-link" @onclick="() => showAllActivity = !showAllActivity">@(showAllActivity ? "Show less" : "View all") <span aria-hidden="true">→</span></button>
                }
            </header>
            @if (LocationActivity.Count == 0)
            {
                <div class="panel-empty">No transfer activity recorded for this period.</div>
            }
            else
            {
                <table class="activity-table">
                    <thead><tr><th>Time</th><th>Reference</th><th>Type</th><th>Route</th><th class="is-numeric">Units</th></tr></thead>
                    <tbody>
                        @foreach (PosStoreMovementActivity item in VisibleActivity)
                        {
                            bool incoming = item.DestinationLocationId == SelectedId;
                            <tr>
                                <td>@item.OccurredAtUtc.InStoreTime().ToString("HH:mm", CultureInfo.InvariantCulture)</td>
                                <td>
                                    <span class="activity-ref">@item.Reference</span>
                                    @if (!string.IsNullOrWhiteSpace(item.DeliveryReceiptNumber))
                                    {
                                        <small class="activity-dr">DR @item.DeliveryReceiptNumber</small>
                                    }
                                </td>
                                <td>
                                    <span class="activity-kind">@SplitWords(item.Kind)</span>
                                    <span class="direction @(incoming ? "incoming" : "outgoing")">@(incoming ? "Incoming" : "Outgoing")</span>
                                </td>
                                <td class="activity-route">@item.SourceLocationName <span aria-hidden="true">→</span> @item.DestinationLocationName</td>
                                <td class="is-numeric @(item.Kind.StartsWith("Dispatched", StringComparison.OrdinalIgnoreCase) ? (incoming ? "units-in" : "units-out") : null)">
                                    @(item.Kind.StartsWith("Dispatched", StringComparison.OrdinalIgnoreCase) ? (incoming ? "+" : "−") : string.Empty)@Qty(item.ProductUnits)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="report-panel" aria-labelledby="daily-chart-title">
            <header>
                <div>
                    <h2 id="daily-chart-title">7-day movement</h2>
                    <p>@(fullReport?.From.ToString("MMM d", CultureInfo.InvariantCulture) ?? "–") – @(fullReport?.To.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ?? "–")</p>
                </div>
            </header>
            @if (ChartMax <= 0m)
            {
                <div class="chart-shell is-empty">
                    <div class="chart-placeholder">
                        <span aria-hidden="true"><AppIcon Name="report" /></span>
                        <strong>No daily trend data available</strong>
                        <small>Daily movement will appear here.</small>
                    </div>
                </div>
            }
            else
            {
                <div class="chart-shell">
                    <div class="movement-chart" role="img" aria-label="Daily incoming and outgoing units over the period">
                        @foreach (PosStoreMovementChartPoint point in report.DailyMovement)
                        {
                            <div class="chart-bar" title="@ChartDayLabel(point.Bucket): in @Qty(point.IncomingUnits), out @Qty(point.OutgoingUnits)">
                                <div class="bar-in" style="height:@Pct(point.IncomingUnits)%"></div>
                                <div class="bar-out" style="height:@Pct(point.OutgoingUnits)%"></div>
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="chart-axis" aria-hidden="true">
                @foreach (int bucket in Enumerable.Range(0, 7))
                {
                    <span>@ChartDayLabel(bucket)</span>
                }
            </div>
            <div class="chart-legend"><span class="legend-in">Incoming</span><span class="legend-out">Outgoing</span></div>
        </section>
    </div>

    <section class="report-panel" aria-labelledby="top-items-title">
        <header>
            <div>
                <h2 id="top-items-title">Products with most movement</h2>
                <p>Top moved products in the selected period</p>
            </div>
            <span class="panel-pill"><AppIcon Name="calendar" /> 7-day window</span>
        </header>
        @if (report.RecentItems.Count == 0)
        {
            <div class="panel-empty">No product movement recorded for this period.</div>
        }
        else
        {
            <table class="items-table">
                <thead><tr><th>Product</th><th>Reference</th><th>Direction</th><th class="is-numeric">Units</th></tr></thead>
                <tbody>
                    @foreach (PosStoreMovementItem item in report.RecentItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Reference</td>
                            <td><span class="direction @(item.Direction.Equals("Sent", StringComparison.OrdinalIgnoreCase) ? "outgoing" : "incoming")">@item.Direction</span></td>
                            <td class="is-numeric">@Qty(item.Units)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private const int ActivityPreviewCount = 5;

    private readonly List<PosLocation> locations = [];
    private string selectedLocationId = string.Empty;
    private DateOnly selectedDate = StoreClock.Today;
    private PosStoreMovementReport? fullReport;
    private PosStoreMovement? report;
    private bool loading;
    private bool showAllActivity;
    private string? message;

    private bool CanLoad => Guid.TryParse(selectedLocationId, out Guid id) && ScopedLocations.Any(location => location.Id == id);

    /// <summary>Stores and the main warehouse the signed-in user may report on.</summary>
    private List<PosLocation> ScopedLocations =>
        [.. locations
            .Where(location => location.Kind is 0 or 1 && location.IsActive && Session.CanUseInventoryLocation(location.Id))
            .OrderBy(location => location.Kind)
            .ThenBy(location => location.Code, StringComparer.OrdinalIgnoreCase)];

    private Guid SelectedId => Guid.TryParse(selectedLocationId, out Guid id) ? id : Guid.Empty;

    private bool SelectedIsWarehouse => locations.Any(location => location.Id == SelectedId && location.Kind == 0);

    private decimal NetUnits => (report?.IncomingUnits ?? 0m) - (report?.OutgoingUnits ?? 0m);

    /// <summary>Dispatched transfers that touched the selected location in the period.</summary>
    private int DispatchedHere => LocationActivity
        .Count(item => item.Kind.StartsWith("Dispatched", StringComparison.OrdinalIgnoreCase));

    private List<PosStoreMovementActivity> LocationActivity =>
        [.. (fullReport?.RecentActivity ?? [])
            .Where(item => item.SourceLocationId == SelectedId || item.DestinationLocationId == SelectedId)];

    private IEnumerable<PosStoreMovementActivity> VisibleActivity =>
        showAllActivity ? LocationActivity : LocationActivity.Take(ActivityPreviewCount);

    private decimal ChartMax => report is null || report.DailyMovement.Count == 0
        ? 0m
        : report.DailyMovement.Max(point => Math.Max(point.IncomingUnits, point.OutgoingUnits));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ApiResult<List<PosLocation>> result = await Api.GetAsync<List<PosLocation>>("/api/v1/locations", CancellationToken.None);
            if (!result.IsSuccess || result.Value is null) { message = result.Error; return; }
            locations.AddRange(result.Value.OrderBy(location => location.Code));
            if (ScopedLocations.Count == 1) { selectedLocationId = ScopedLocations[0].Id.ToString(); await LoadReportAsync(); }
        }
        catch (HttpRequestException) { message = "The reporting service is unavailable. Try again shortly."; }
    }

    private async Task LoadReportAsync()
    {
        if (!Guid.TryParse(selectedLocationId, out Guid locationId) || !ScopedLocations.Any(location => location.Id == locationId))
        {
            message = "Select an assigned store or the main warehouse before opening the report.";
            return;
        }
        loading = true;
        message = null;
        report = null;
        fullReport = null;
        showAllActivity = false;
        try
        {
            // Request a 7-day window ending on the selected date for the chart, but filter to the single day for the main numbers
            DateOnly from = selectedDate.AddDays(-6);
            ApiResult<PosStoreMovementReport> result = await Api.GetStoreMovementsAsync(from, selectedDate, CancellationToken.None);
            if (!result.IsSuccess || result.Value is null) { message = result.Error; return; }
            fullReport = result.Value;
            report = fullReport.Stores.FirstOrDefault(s => s.LocationId == locationId);
            if (report is null)
            {
                // Create a blank report for the selected location if no data
                PosLocation chosen = ScopedLocations.First(location => location.Id == locationId);
                report = new PosStoreMovement(locationId, chosen.Code, chosen.Name, 0, 0, 0, 0, 0, 0, 0, 0, null, null, [], []);
            }
        }
        catch (HttpRequestException) { message = "The reporting service is unavailable. Try again shortly."; }
        finally { loading = false; }
    }

    private int Pct(decimal units) => ChartMax > 0m ? (int)Math.Round(units / ChartMax * 100m) : 0;

    /// <summary>"Oct 9" for the nth day of the reported window.</summary>
    private string ChartDayLabel(int bucket) =>
        (fullReport?.From ?? selectedDate.AddDays(-6)).AddDays(bucket).ToString("MMM d", CultureInfo.InvariantCulture);

    private static string Qty(decimal qty) => qty % 1m == 0m ? qty.ToString("0", CultureInfo.InvariantCulture) : qty.ToString("0.###", CultureInfo.InvariantCulture);

    // Stock arrives two ways. Naming only transfers under a figure that counts
    // supplier deliveries as well reads as a miscount, so both are named.
    private static string InboundSources(PosStoreMovement store)
    {
        string transfers = $"{store.InboundTransfers} inbound transfer{(store.InboundTransfers == 1 ? "" : "s")}";
        return store.InboundReceipts == 0
            ? transfers
            : $"{transfers} · {store.InboundReceipts} supplier deliver{(store.InboundReceipts == 1 ? "y" : "ies")}";
    }

    private static string SplitWords(string value) => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
}
