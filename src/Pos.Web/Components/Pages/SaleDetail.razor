@page "/sales/{Id:guid}"
@attribute [Authorize(Policy = "sale.view")]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session
@inject IJSRuntime Js

<PageTitle>Sale @sale?.Number · VaultFlow</PageTitle>

@if (sale is null && !string.IsNullOrWhiteSpace(message))
{
    <section class="sale-blocked" role="alert">
        <span>Cannot load this sale</span>
        <h2>@message</h2>
        <p><a href="sales">Back to the sales ledger</a></p>
    </section>
}
else if (sale is not null)
{
    <section class="sale-head">
        <div>
            <span class="eyebrow">Point of sale</span>
            <h1>Sale @sale.Number</h1>
            <p>
                @(storeName is null ? "Unknown store" : storeName) ·
                @sale.BusinessDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) ·
                Completed @sale.CompletedAtUtc.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)
            </p>
        </div>
        <div class="sale-head-actions"><span class="status-chip status-@sale.Status.ToLowerInvariant()">@sale.Status</span></div>
    </section>

    @* The web is for monitoring: sales, voids, returns and reprints happen at
       the store's register, which works offline and syncs here. *@
    <div class="pos-message" role="note">Voids, returns and reprints are done at the store's register.</div>

    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div class="pos-message" role="status">@actionMessage</div>
    }

    <div class="detail-grid">
        <section class="detail-panel">
            <header><span class="eyebrow">Transaction</span><h2>Lines <em>@sale.Lines.Count</em></h2></header>
            <table class="lines-table">
                <thead>
                    <tr><th>#</th><th>Product</th><th class="num">Qty</th><th class="num">Price</th><th class="num">Discount</th><th class="num">VAT</th><th class="num">Net</th></tr>
                </thead>
                <tbody>
                    @foreach (PosSaleLineDetail line in sale.Lines)
                    {
                        <tr @key="line.LineNumber">
                            <td>@line.LineNumber</td>
                            <td>
                                <strong>@line.ProductName</strong>
                                @if (!string.IsNullOrWhiteSpace(line.Barcode)) { <small>@line.Barcode</small> }
                            </td>
                            <td class="num">@line.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</td>
                            <td class="num">@Money(line.UnitPrice)</td>
                            <td class="num">@(line.Discount > 0m ? $"- {Money(line.Discount)}" : "—")</td>
                            <td class="num">@Money(line.Vat)</td>
                            <td class="num"><strong>@Money(line.NetAmount)</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="totals">
                <div><span>Gross</span><strong>@Money(sale.GrossTotal)</strong></div>
                @if (sale.DiscountTotal > 0m) { <div><span>Discounts</span><strong class="discount-total">− @Money(sale.DiscountTotal)</strong></div> }
                <div><span>VAT</span><strong>@Money(sale.VatTotal)</strong></div>
                <div class="net"><span>Net settled</span><strong>@Money(sale.NetTotal)</strong></div>
            </div>
        </section>

        <section class="detail-panel">
            <header><span class="eyebrow">Settlement</span><h2>Payments <em>@sale.Payments.Count</em></h2></header>
            @if (sale.Payments.Count == 0)
            {
                <div class="panel-empty">No payments recorded.</div>
            }
            else
            {
                <table class="payments-table">
                    <thead><tr><th>Method</th><th class="num">Amount</th><th class="num">Tendered</th><th class="num">Change</th><th>Reference</th></tr></thead>
                    <tbody>
                        @foreach (PosSalePaymentDetail payment in sale.Payments)
                        {
                            <tr @key="payment.Method">
                                <td><span class="method-chip">@payment.Method</span></td>
                                <td class="num"><strong>@Money(payment.Amount)</strong></td>
                                <td class="num">@(payment.Tendered is { } tendered ? Money(tendered) : "—")</td>
                                <td class="num">@(payment.Change is { } change ? Money(change) : "—")</td>
                                <td>@(payment.ProviderReference ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>

    <section class="receipt-panel">
        <header>
            <div>
                <span class="eyebrow">Receipt</span>
                <h2>Receipt copy</h2>
            </div>
            <div class="receipt-actions">
                <button type="button" @onclick="LoadReceiptAsync" disabled="@loadingReceipt">
                    @(loadingReceipt ? "Loading…" : "View receipt")
                </button>
                <button type="button" @onclick="OpenPrintableAsync" disabled="@(openingPrintable || loadingReceipt)">
                    @(openingPrintable ? "Opening…" : "Printable / PDF")
                </button>
            </div>
        </header>

        @if (receiptText is not null)
        {
            <pre class="receipt-text">@receiptText</pre>
        }
        else if (!loadingReceipt)
        {
            <div class="receipt-empty">Press <strong>View receipt</strong> to see the receipt as the register printed it.</div>
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private PosSaleDetail? sale;
    private string? storeName;
    private string? message;
    private string? actionMessage;
    private string? receiptText;
    private bool loadingReceipt;
    private bool openingPrintable;
    private Guid loadedId;

    private bool CanView => Session.Current?.User.Permissions.Contains("sale.view", StringComparer.Ordinal) == true;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == loadedId) return;
        loadedId = Id;
        await LoadSaleAsync();
    }

    private async Task LoadSaleAsync()
    {
        message = null;
        actionMessage = null;
        receiptText = null;
        try
        {
            if (!CanView)
            {
                message = "This account cannot view sales. Ask an administrator for the sale.view permission.";
                return;
            }

            ApiResult<PosSaleDetail> response = await Api.GetSaleAsync(Id, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { message = response.Error; return; }
            sale = response.Value;

            ApiResult<List<PosLocation>> locations = await Api.GetAsync<List<PosLocation>>(
                "/api/v1/locations", CancellationToken.None);
            if (locations.IsSuccess && locations.Value is not null)
            {
                storeName = locations.Value.FirstOrDefault(location => location.Id == sale.LocationId)?.Name;
            }
        }
        catch (HttpRequestException) { message = "The sale service is unavailable. Try again shortly."; }
    }

    private async Task LoadReceiptAsync()
    {
        loadingReceipt = true;
        actionMessage = null;
        try
        {
            ApiResult<string> response = await Api.GetSaleReceiptAsync(Id, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { actionMessage = response.Error; return; }
            receiptText = response.Value;
        }
        catch (HttpRequestException) { actionMessage = "The receipts service is unavailable. Try again shortly."; }
        finally { loadingReceipt = false; }
    }

    private async Task OpenPrintableAsync()
    {
        openingPrintable = true;
        actionMessage = null;
        try
        {
            ApiResult<string> response = await Api.GetSaleReceiptHtmlAsync(Id, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { actionMessage = response.Error; return; }

            await Js.InvokeVoidAsync("vaultflowPrintReceipt", response.Value);
        }
        catch (HttpRequestException) { actionMessage = "The receipts service is unavailable. Try again shortly."; }
        finally { openingPrintable = false; }
    }

    private static string Money(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));
}
