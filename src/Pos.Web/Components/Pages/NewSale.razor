@page "/pos"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject VaultFlowApiClient Api
@inject UserSession Session

<PageTitle>New sale · VaultFlow</PageTitle>

<section class="pos-head">
    <div>
        <span class="eyebrow">Point of sale</span>
        <h1>New sale</h1>
        <p>Choose a store and register, then scan or search to build the transaction.</p>
    </div>
    <div class="head-pickers">
        <label class="location-picker">
            <span>Sale location</span>
            <select value="@(selectedLocationId?.ToString() ?? string.Empty)"
                    @onchange="OnLocationChangedAsync" disabled="@(cart.Count > 0 || loadingLocations)">
                <option value="">Select a store</option>
                @foreach (PosLocation location in locations)
                {
                    <option value="@location.Id">@location.Code · @location.Name</option>
                }
            </select>
        </label>
        <label class="location-picker">
            <span>Register</span>
            <select value="@(selectedRegisterId?.ToString() ?? string.Empty)"
                    @onchange="OnRegisterChangedAsync"
                    disabled="@(cart.Count > 0 || loadingRegisters || registers.Count == 0)">
                <option value="">Select a register</option>
                @foreach (PosRegister register in registers)
                {
                    <option value="@register.Id">@register.Name</option>
                }
            </select>
        </label>
    </div>
</section>

@if (!CanCreateSale)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot create sales.</h2>
        <p>Ask an administrator for the <code>sale.create</code> permission.</p>
    </section>
}
else
{
    <section class="shift-strip" aria-live="polite">
        @if (terminalSession is not null && openShift is not null)
        {
            <span class="shift-live" role="status">
                <strong>Shift open</strong>
                <em>@openShift.Number</em>
                <small>@openShift.CashierName · @openShift.BusinessDate.ToString("ddd, MMM d", CultureInfo.InvariantCulture) · Opening @Money(openShift.OpeningFloat)</small>
            </span>
        }
        else if (terminalSession is not null)
        {
            <label class="shift-start">
                <span>Start shift · business date <strong>@terminalSession.BusinessDate.ToString("ddd, MMM d", CultureInfo.InvariantCulture)</strong></span>
                <div>
                    <input type="number" min="0" step="0.01" value="@openingFloat" aria-label="Opening float"
                           @onchange="e => openingFloat = e.Value?.ToString() ?? string.Empty" />
                    <button type="button" @onclick="StartShiftAsync" disabled="@startingShift">
                        @(startingShift ? "Opening…" : "Start shift")
                    </button>
                </div>
            </label>
        }
        @if (!string.IsNullOrWhiteSpace(checkoutMessage))
        {
            <div class="pos-message" role="status">@checkoutMessage</div>
        }
    </section>

    @if (completedSale is not null)
    {
        <section class="sale-complete" role="status">
            <span>Sale completed</span>
            <h2>Sale @completedSale.Number is in the books.</h2>
            <p>Stock moved, the audit entry is written, and the shift remains open.</p>
            <button type="button" @onclick="StartNextSale">New sale</button>
        </section>
    }
    else if (showPayment)
    {
        <section class="payment-panel">
            <header>
                <div><span class="eyebrow">Settle the transaction</span><h2>Payment <em>@Money(NetTotal)</em></h2></div>
                <button type="button" class="clear-cart" @onclick="CancelPayment">Back to cart</button>
            </header>

            <div class="payment-body">
                <label class="tender-row">
                    <span>Cash tendered</span>
                    <input type="text" inputmode="decimal" placeholder="0.00" autocomplete="off"
                           value="@tendered" @onchange="OnTenderedChanged"
                           disabled="@completing" />
                </label>

                <div class="quick-tender">
                    <button type="button" @onclick="() => tendered = MoneyPlain(RoundedNet)" disabled="@completing">Exact</button>
                    <button type="button" @onclick="() => tendered = MoneyPlain(100m)" disabled="@completing">100</button>
                    <button type="button" @onclick="() => tendered = MoneyPlain(500m)" disabled="@completing">500</button>
                    <button type="button" @onclick="() => tendered = MoneyPlain(1000m)" disabled="@completing">1000</button>
                </div>

                <div class="tender-summary">
                    <div><span>Amount due</span><strong>@Money(NetTotal)</strong></div>
                    <div><span>Tendered</span><strong>@Money(TenderedAmount)</strong></div>
                    <div class="change"><span>Estimated change</span><strong>@Money(ChangeEstimate)</strong></div>
                </div>

                @if (!string.IsNullOrWhiteSpace(checkoutMessage))
                {
                    <div class="pos-message" role="alert">@checkoutMessage</div>
                }
            </div>

            <footer>
                <button type="button" class="checkout" @onclick="CompleteSaleAsync"
                        disabled="@(completing || !CanPay || TenderedAmount < NetTotal)">@(completing ? "Completing…" : "Complete sale")</button>
            </footer>
        </section>
    }
    else
    {
        <section class="pos-workspace">
            <div class="catalog-panel">
                <form class="scan-bar" @onsubmit="ScanAsync" @onsubmit:preventDefault="true">
                    <label for="barcode">Barcode</label>
                    <div>
                        <input id="barcode" placeholder="Scan or enter a barcode" autocomplete="off"
                               @bind="barcode" @bind:event="oninput" disabled="@busy" />
                        <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(barcode))">Add</button>
                    </div>
                </form>

                <form class="search-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                    <label for="product-search">Product search</label>
                    <div>
                        <input id="product-search" placeholder="Name, SKU or barcode" autocomplete="off"
                               @bind="search" @bind:event="oninput" disabled="@busy" />
                        <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(search))">Search</button>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="pos-message" role="status">@message</div>
                }

                <div class="result-list" aria-live="polite">
                    @if (busy)
                    {
                        <div class="result-empty">Loading catalogue…</div>
                    }
                    else if (results.Count > 0)
                    {
                        @foreach (PosProduct product in results)
                        {
                            <article class="product-result" @key="product.Id">
                                <span class="product-monogram" aria-hidden="true">@Monogram(product.Name)</span>
                                <div><strong>@product.Name</strong><small>@product.Sku · @(product.Barcodes.FirstOrDefault() ?? "No barcode")</small></div>
                                <button type="button" @onclick="() => AddProductAsync(product)" disabled="@(selectedLocationId is null)">Add to cart</button>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="result-empty"><strong>Ready to scan.</strong><span>Results will appear here without disturbing the cart.</span></div>
                    }
                </div>
            </div>

            <aside class="cart-panel">
                <header>
                    <div><span class="eyebrow">Current transaction</span><h2>Cart <em>@cart.Count</em></h2></div>
                    @if (cart.Count > 0) { <button type="button" class="clear-cart" @onclick="ClearCart">Clear</button> }
                </header>

                <div class="cart-lines">
                    @if (cart.Count == 0)
                    {
                        <div class="cart-empty"><span aria-hidden="true">▤</span><strong>No items yet</strong><p>Choose a store and register, then scan or search for a product.</p></div>
                    }
                    else
                    {
                        @foreach (PosCartLine line in cart)
                        {
                            <article class="cart-line" @key="line.Product.Id">
                                <div class="line-title">
                                    <strong>@line.Product.Name</strong>
                                    <small>@Money(line.UnitPrice) each</small>
                                    @if (CanDiscount)
                                    {
                                        <label class="line-discount">
                                            Discount
                                            <input type="number" min="0" step="0.01" aria-label="Discount for @line.Product.Name"
                                                   value="@DiscountFor(line.Product.Id).ToString("0.##", CultureInfo.InvariantCulture)"
                                                   @onchange="(e) => SetDiscount(line, e.Value?.ToString())" />
                                        </label>
                                    }
                                </div>
                                <div class="quantity-control" aria-label="Quantity for @line.Product.Name">
                                    <button type="button" aria-label="Decrease quantity" @onclick="() => ChangeQuantity(line, -1m)">−</button>
                                    <span>@line.Quantity.ToString("0.###", CultureInfo.InvariantCulture)</span>
                                    <button type="button" aria-label="Increase quantity" @onclick="() => ChangeQuantity(line, 1m)">+</button>
                                </div>
                                <strong class="line-total">@Money(LineTotalAfterDiscount(line))</strong>
                                <button type="button" class="remove-line" aria-label="Remove @line.Product.Name" @onclick="() => Remove(line)">×</button>
                            </article>
                        }
                    }
                </div>

                <footer>
                    @if (DiscountTotal > 0m)
                    {
                        <div><span>Discounts</span><strong class="discount-total">− @Money(DiscountTotal)</strong></div>
                    }
                    <div class="net-total"><span>Amount due</span><strong>@Money(NetTotal)</strong></div>
                    @if (openShift is null)
                    {
                        <button type="button" class="checkout" disabled>Start the shift to accept payment <span>Shift required</span></button>
                    }
                    else
                    {
                        <button type="button" class="checkout" @onclick="StartPayment" disabled="@(cart.Count == 0 || NetTotal <= 0m)">Continue to payment <span>@Money(NetTotal)</span></button>
                    }
                </footer>
            </aside>
        </section>
    }
}

@code {
    private readonly List<PosLocation> locations = [];
    private readonly List<PosRegister> registers = [];
    private readonly List<PosProduct> results = [];
    private readonly List<PosCartLine> cart = [];
    private readonly Dictionary<Guid, decimal> discounts = [];
    private Guid? selectedLocationId;
    private Guid? selectedRegisterId;
    private PosTerminalSession? terminalSession;
    private PosOpenShift? openShift;
    private string openingFloat = "0";
    private string? message;
    private string? checkoutMessage;
    private string barcode = string.Empty;
    private string search = string.Empty;
    private bool busy;
    private bool loadingLocations = true;
    private bool loadingRegisters;
    private bool startingShift;
    private bool showPayment;
    private string tendered = string.Empty;
    private bool completing;
    private CompletedSaleState? completedSale;

    private bool CanCreateSale => Session.Current?.User.Permissions.Contains("sale.create", StringComparer.Ordinal) == true;
    private bool CanDiscount => Session.Current?.User.Permissions.Contains("sale.discount", StringComparer.Ordinal) == true;
    private bool CanPay => Session.DeviceId is not null && openShift is not null && cart.Count > 0;
    private decimal Subtotal => cart.Sum(line => line.Total);
    private decimal DiscountTotal => cart.Sum(line => DiscountFor(line.Product.Id));
    private decimal NetTotal => decimal.Round(Subtotal - DiscountTotal, 4, MidpointRounding.ToEven);
    private decimal RoundedNet => RoundToIncrement(NetTotal);
    private decimal TenderedAmount => decimal.TryParse(tendered, System.Globalization.NumberStyles.Currency, CultureInfo.CurrentCulture, out decimal amount) ? amount : 0m;
    private decimal ChangeEstimate => TenderedAmount >= NetTotal ? RoundToIncrement(TenderedAmount - NetTotal) : 0m;
    private decimal DiscountFor(Guid productId) => discounts.GetValueOrDefault(productId);
    private decimal LineTotalAfterDiscount(PosCartLine line) => decimal.Round(line.Total - DiscountFor(line.Product.Id), 4, MidpointRounding.ToEven);

    protected override async Task OnInitializedAsync()
    {
        if (!CanCreateSale)
        {
            loadingLocations = false;
            return;
        }

        ApiResult<List<PosLocation>> response = await Api.GetAsync<List<PosLocation>>(
            "/api/v1/locations",
            CancellationToken.None);
        loadingLocations = false;
        if (!response.IsSuccess || response.Value is null)
        {
            message = response.Error;
            return;
        }

        HashSet<Guid> assigned = [.. Session.Current?.User.Locations ?? []];
        locations.AddRange(response.Value.Where(location =>
            location.Kind == 1 &&
            (Session.Current?.User.HasAllLocations == true || assigned.Contains(location.Id))));
        selectedLocationId = locations.Count == 1 ? locations[0].Id : null;
        if (locations.Count == 0)
        {
            message = "No active store is assigned to this account.";
        }
        else if (selectedLocationId is { } single)
        {
            await LoadRegistersAsync(single);
        }
    }

    private async Task OnLocationChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        selectedLocationId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
        ResetRegisterContext();
        message = null;
        checkoutMessage = null;
        if (selectedLocationId is { } locationId)
        {
            await LoadRegistersAsync(locationId);
        }
    }

    private async Task LoadRegistersAsync(Guid locationId)
    {
        loadingRegisters = true;
        try
        {
            ApiResult<List<PosRegister>> response = await Api.GetRegistersAsync(locationId, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { message = response.Error; return; }

            registers.Clear();
            registers.AddRange(response.Value);
            if (registers.Count == 0)
            {
                message = "No browser register is active for this store. Ask an administrator to register one.";
            }
            else if (registers.Count == 1)
            {
                await SelectRegisterAsync(registers[0]);
            }
        }
        catch (HttpRequestException) { message = "The register service is unavailable. Try again shortly."; }
        finally { loadingRegisters = false; }
    }

    private async Task OnRegisterChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out Guid id)) return;
        PosRegister? register = registers.FirstOrDefault(r => r.Id == id);
        if (register is not null) { await SelectRegisterAsync(register); }
    }

    private async Task SelectRegisterAsync(PosRegister register)
    {
        Session.SetRegister(register);
        selectedRegisterId = register.Id;
        checkoutMessage = null;
        await LoadSessionAsync();
    }

    private async Task LoadSessionAsync()
    {
        if (selectedLocationId is null || Session.DeviceId is null)
        {
            terminalSession = null;
            openShift = null;
            return;
        }

        try
        {
            ApiResult<PosTerminalSession> response = await Api.GetTerminalSessionAsync(
                selectedLocationId.Value, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { checkoutMessage = response.Error; return; }

            terminalSession = response.Value;
            openShift = response.Value.OpenShift;
        }
        catch (HttpRequestException) { checkoutMessage = "The terminal session is unavailable. Try again shortly."; }
    }

    private void ResetRegisterContext()
    {
        Session.ClearRegister();
        selectedRegisterId = null;
        terminalSession = null;
        openShift = null;
        registers.Clear();
    }

    private async Task StartShiftAsync()
    {
        if (terminalSession is null) return;
        if (!decimal.TryParse(openingFloat, out decimal floatAmount) || floatAmount < 0m)
        {
            checkoutMessage = "Enter a valid opening float.";
            return;
        }

        startingShift = true;
        checkoutMessage = null;
        try
        {
            ApiResult<PosNextNumber> number = await Api.PostNextNumberAsync(
                selectedLocationId!.Value, "SHF", CancellationToken.None);
            if (!number.IsSuccess || number.Value is null) { checkoutMessage = number.Error; return; }

            ApiResult<PosShiftReference> opened = await Api.OpenShiftAsync(
                selectedLocationId.Value, number.Value.Number, terminalSession.BusinessDate, floatAmount, CancellationToken.None);
            if (!opened.IsSuccess || opened.Value is null) { checkoutMessage = opened.Error; return; }

            await LoadSessionAsync();
        }
        catch (HttpRequestException) { checkoutMessage = "The shift service is unavailable. Try again shortly."; }
        finally { startingShift = false; }
    }

    private void StartPayment()
    {
        if (NetTotal <= 0m) return;
        showPayment = true;
        checkoutMessage = null;
    }

    private void CancelPayment()
    {
        showPayment = false;
        checkoutMessage = null;
    }

    private async Task CompleteSaleAsync()
    {
        if (terminalSession is null || openShift is null || Session.Current?.User is not { } user || selectedLocationId is not { } locationId)
        {
            checkoutMessage = "The terminal session is not ready. Reopen this page.";
            return;
        }
        if (TenderedAmount < NetTotal)
        {
            checkoutMessage = "The cash tendered is below the amount due.";
            return;
        }

        completing = true;
        checkoutMessage = null;
        try
        {
            ApiResult<PosNextNumber> number = await Api.PostNextNumberAsync(locationId, "SAL", CancellationToken.None);
            if (!number.IsSuccess || number.Value is null) { checkoutMessage = number.Error; return; }

            List<PosSaleLine> lines = cart.Select(line => new PosSaleLine(
                line.Product.Id,
                line.Quantity,
                line.Product.BaseUnitOfMeasureId,
                line.Product.Barcodes.FirstOrDefault(),
                UnitPriceOverride: null,
                PriceOverrideAuthorizedByUserId: null,
                DiscountFor(line.Product.Id),
                DiscountFor(line.Product.Id) > 0m ? user.Id : null,
                AllowExpiredOverride: false)).ToList();

            PosCompleteSaleRequest request = new(
                number.Value.Number,
                EventId: Guid.CreateVersion7(),
                locationId,
                openShift.ShiftId,
                terminalSession.DeviceId,
                CustomerId: null,
                terminalSession.BusinessDate,
                CompletedAtUtc: DateTimeOffset.UtcNow,
                lines,
                [new PosPayment(Method: 1 /* Cash */, NetTotal, TenderedAmount, ProviderReference: null)]);

            ApiResult<PosCompletedSale> result = await Api.CompleteSaleAsync(request, CancellationToken.None);
            if (!result.IsSuccess || result.Value is null) { checkoutMessage = result.Error; return; }

            completedSale = new CompletedSaleState(number.Value.Number);
            showPayment = false;
            tendered = string.Empty;
            discounts.Clear();
            cart.Clear();
            results.Clear();
        }
        catch (HttpRequestException) { checkoutMessage = "The sale service is unavailable. Try again shortly."; }
        finally { completing = false; }
    }

    private void StartNextSale()
    {
        completedSale = null;
        checkoutMessage = null;
        tendered = string.Empty;
    }

    private void OnTenderedChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        tendered = e.Value?.ToString() ?? string.Empty;
    }

    private void SetDiscount(PosCartLine line, string? value)
    {
        if (!decimal.TryParse(value, System.Globalization.NumberStyles.Currency, CultureInfo.InvariantCulture, out decimal discount))
        {
            discounts.Remove(line.Product.Id);
            return;
        }

        discounts[line.Product.Id] = Math.Clamp(discount, 0m, line.Total);
    }

    private decimal RoundToIncrement(decimal amount)
    {
        decimal increment = terminalSession?.CashRoundingIncrement > 0m ? terminalSession.CashRoundingIncrement : 0.01m;
        return decimal.Round(amount / increment, 0, MidpointRounding.AwayFromZero) * increment;
    }

    private static string MoneyPlain(decimal value)
        => value.ToString("0.##", CultureInfo.InvariantCulture);

    private async Task SearchAsync()
    {
        results.Clear();
        message = null;
        busy = true;
        try
        {
            string query = Uri.EscapeDataString(search.Trim());
            ApiResult<List<PosProduct>> response = await Api.GetAsync<List<PosProduct>>(
                $"/api/v1/catalog/products?q={query}&limit=24",
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { message = response.Error; return; }
            results.AddRange(response.Value);
            if (results.Count == 0) { message = "No active products matched that search."; }
        }
        catch (HttpRequestException) { message = "The catalogue is unavailable. Try again shortly."; }
        finally { busy = false; }
    }

    private async Task ScanAsync()
    {
        message = null;
        busy = true;
        try
        {
            string value = Uri.EscapeDataString(barcode.Trim());
            ApiResult<PosProduct> response = await Api.GetAsync<PosProduct>(
                $"/api/v1/catalog/products/by-barcode/{value}",
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { message = response.Error; return; }
            await AddProductAsync(response.Value);
            barcode = string.Empty;
        }
        catch (HttpRequestException) { message = "The catalogue is unavailable. Try again shortly."; }
        finally { busy = false; }
    }

    private async Task AddProductAsync(PosProduct product)
    {
        if (selectedLocationId is null) { message = "Select the store before adding products."; return; }
        PosCartLine? existing = cart.FirstOrDefault(line => line.Product.Id == product.Id);
        if (existing is not null) { ChangeQuantity(existing, 1m); message = null; return; }

        busy = true;
        try
        {
            ApiResult<List<PosProductPrice>> response = await Api.GetAsync<List<PosProductPrice>>(
                $"/api/v1/catalog/products/{product.Id:D}/prices",
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null) { message = response.Error; return; }
            PosProductPrice? price = response.Value.FirstOrDefault(row => row.IsCurrent && row.LocationId == selectedLocationId)
                ?? response.Value.FirstOrDefault(row => row.IsCurrent && row.LocationId is null);
            if (price is null) { message = $"{product.Name} has no current price for this store."; return; }
            cart.Add(new PosCartLine(product, price.Amount));
            message = null;
        }
        catch (HttpRequestException) { message = "Pricing is unavailable. Try again shortly."; }
        finally { busy = false; }
    }

    private static string Monogram(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private static string Money(decimal value) => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));
    private void ChangeQuantity(PosCartLine line, decimal delta) => line.Quantity = Math.Clamp(line.Quantity + delta, 1m, 999m);
    private void Remove(PosCartLine line) { cart.Remove(line); discounts.Remove(line.Product.Id); }
    private void ClearCart() { cart.Clear(); discounts.Clear(); results.Clear(); message = null; }

    private sealed record CompletedSaleState(string Number);
}