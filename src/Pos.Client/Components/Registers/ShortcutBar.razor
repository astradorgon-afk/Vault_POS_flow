<footer class="till-footer" aria-label="Keyboard shortcuts">
    @if (PaymentMode)
    {
        <button type="button" class="till-footer-key till-footer-left" @onclick='() => Press("Escape")'><kbd>Esc</kbd> Back to cart</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F10")'><kbd>F10</kbd> Complete sale</button>
    }
    else if (HeldPanelOpen)
    {
        <button type="button" class="till-footer-key till-footer-right" @onclick='() => Press("Escape")'><kbd>Esc</kbd> Close held sales</button>
    }
    else if (MoreOpen)
    {
        <button type="button" class="till-footer-key till-footer-right" @onclick='() => Press("Escape")'><kbd>Esc</kbd> Close menu</button>
    }
    else
    {
        <button type="button" class="till-footer-key" @onclick='() => Press("F2")'><kbd>F2</kbd> Search</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F3")' disabled="@(!HasItems)"><kbd>F3</kbd> Quantity</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F4")'><kbd>F4</kbd> Discount</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F6")' disabled="@(!HasItems)"><kbd>F6</kbd> Hold</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F7")'><kbd>F7</kbd> Recall</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F8")' disabled="@(!HasItems)"><kbd>F8</kbd> Void line</button>
        <button type="button" class="till-footer-key" @onclick='() => Press("F9")' disabled="@(!HasItems)"><kbd>F9</kbd> Pay</button>
        <button type="button" class="till-footer-key till-footer-right" @onclick='() => Press("Escape")'><kbd>Esc</kbd> Cancel</button>
    }
</footer>

@code {
    /// <summary>When true, shows the payment shortcuts rather than the sale shortcuts.</summary>
    [Parameter]
    public bool PaymentMode { get; set; }

    /// <summary>When true, shows shortcuts for the held-sales panel.</summary>
    [Parameter]
    public bool HeldPanelOpen { get; set; }

    /// <summary>When true, shows shortcuts for the More menu.</summary>
    [Parameter]
    public bool MoreOpen { get; set; }

    /// <summary>Whether the sale has lines, so line and payment keys can act.</summary>
    [Parameter]
    public bool HasItems { get; set; }

    /// <summary>
    /// Raised with the key name when a shortcut is clicked, so a mouse or touch
    /// press does exactly what the keyboard shortcut does.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnShortcut { get; set; }

    private Task Press(string key) => OnShortcut.InvokeAsync(key);
}
