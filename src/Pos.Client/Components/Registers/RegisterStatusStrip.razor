@using Pos.Client.Services

@* A healthy register says so in the header; the strip only takes a row when
   the cashier needs to know something (offline, sign-in expiring, blocked). *@
@if (StateClass != "vf-statusstrip-ready")
{
    <div class="vf-statusstrip @StateClass" role="status" aria-live="polite">
        <span class="vf-statusstrip-lamp" aria-hidden="true"></span>
        <strong class="vf-statusstrip-headline">@Headline</strong>
        @if (Detail is { Length: > 0 } detail)
        {
            <span class="vf-statusstrip-detail" title="@detail">@detail</span>
        }
        @if (SignedInOffline && OnReconnect.HasDelegate)
        {
            <button type="button" class="button-secondary vf-statusstrip-action" @onclick="OnReconnect">Reconnect</button>
        }
    </div>
}

@code {
    /// <summary>The register status to present.</summary>
    [Parameter]
    public DeviceStatusView? Status { get; set; }

    /// <summary>
    /// When the checkout context (shift / business date) could not be loaded, why.
    /// A register without its context cannot take payments at all.
    /// </summary>
    [Parameter]
    public string? ContextError { get; set; }

    /// <summary>True when the cashier signed in without head office.</summary>
    [Parameter]
    public bool SignedInOffline { get; set; }

    /// <summary>True when the till answered its shift and business date from its own store data.</summary>
    [Parameter]
    public bool TillOffline { get; set; }

    /// <summary>What is still waiting to reach head office, in words; empty when nothing is.</summary>
    [Parameter]
    public string? Backlog { get; set; }

    /// <summary>When an offline sign-in's cached authority runs out.</summary>
    [Parameter]
    public DateTimeOffset? OfflineAuthorityExpiresUtc { get; set; }

    /// <summary>Raised when the cashier asks to connect an offline sign-in to head office.</summary>
    [Parameter]
    public EventCallback OnReconnect { get; set; }

    private bool Offline => SignedInOffline
        || TillOffline
        || Status?.Connectivity == DeviceConnectivityState.Offline
        || ContextError is not null;

    private string StateClass => ContextError is not null || Status?.Severity == DeviceStatusSeverity.Blocked
        ? "vf-statusstrip-blocked"
        : Status?.Severity == DeviceStatusSeverity.Warning || Offline || Backlog is { Length: > 0 }
            ? "vf-statusstrip-warning"
            : "vf-statusstrip-ready";

    private string Headline
    {
        get
        {
            if (ContextError is not null)
            {
                return "Connection needed";
            }

            if (Status?.Concern is DeviceStatusConcern.AuthorityExpired)
            {
                return "Sign-in has expired";
            }

            if (SignedInOffline)
            {
                return "Signed in offline";
            }

            if (TillOffline)
            {
                return "Offline";
            }

            return Status?.Concern switch
            {
                DeviceStatusConcern.AuthorityExpiringSoon => "Sign-in expires soon",
                DeviceStatusConcern.WorkingOffline => "Offline",
                _ => Backlog is { Length: > 0 } ? "Waiting to send" : "Online",
            };
        }
    }

    private string Detail
    {
        get
        {
            string backlog = Backlog is { Length: > 0 } waiting ? " " + waiting : string.Empty;

            if (ContextError is { Length: > 0 } context)
            {
                return $"{context} {RegisterService.OfflineSaleMessaging}";
            }

            if (Status?.Concern == DeviceStatusConcern.AuthorityExpired)
            {
                return "Connect to head office to sign in again. Until then this register can only browse products.";
            }

            if (SignedInOffline)
            {
                string until = OfflineAuthorityExpiresUtc is { } expires
                    ? $" Your offline access here lasts until {expires.ToLocalTime():ddd HH:mm}."
                    : string.Empty;
                return RegisterService.OfflineSaleMessaging + backlog + until;
            }

            if (Offline)
            {
                return RegisterService.OfflineSaleMessaging + backlog;
            }

            if (Status?.Concern == DeviceStatusConcern.AuthorityExpiringSoon)
            {
                return $"Connect to head office before {Status.AuthorityExpiresUtc?.ToLocalTime():HH:mm}, or this register stops taking sales.";
            }

            if (Backlog is { Length: > 0 })
            {
                return Backlog;
            }

            string sync = Status?.LastSynchronisedUtc is { } received
                ? received.ToLocalTime().ToString("HH:mm")
                : "never";
            return $"store data synced {sync} · {Status?.UnsentEvents ?? 0} pending";
        }
    }
}
