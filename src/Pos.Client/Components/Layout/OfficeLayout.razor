@inherits LayoutComponentBase
@inject RegisterService Register
@inject NavigationManager Navigation

@if (_store is { } store)
{
    <div class="office-app">
        <header class="office-topbar">
            <div class="office-brand">
                <span class="office-brand-mark" aria-hidden="true">V</span>
                <div>
                    <div class="office-brand-word">VaultFlow</div>
                    <div class="office-brand-context">Office</div>
                </div>
            </div>

            <div class="office-operator">
                <div class="office-operator-who">
                    <span class="office-operator-store">@store.Name</span>
                    <span class="office-operator-name">Signed in as @Register.Current?.DisplayName</span>
                </div>
                @if (Api.HasPermission(PermissionsSaleCreate))
                {
                    <button type="button" class="button-primary office-till-button" @onclick="GoTill">Open till</button>
                }
                <button type="button" class="button-secondary" @onclick="SignOutAsync">Sign out</button>
            </div>
        </header>

        <div class="office-body">
            <nav class="office-nav" aria-label="Office">
                <button type="button" class="office-nav-link @NavClass("/office")" aria-current="@Current("/office")" @onclick="GoOffice">
                    <span class="office-nav-glyph" aria-hidden="true">⌂</span>
                    Overview
                </button>

                @if (Api.HasPermission(PermissionsInventoryView) || Api.HasPermission(PermissionsTransferView) || Api.HasPermission(PermissionsPurchasingView))
                {
                    <span class="office-nav-label">Stock</span>
                }
                @if (Api.HasPermission(PermissionsInventoryView))
                {
                    <button type="button" class="office-nav-link @InventoryNavClass" aria-current="@(InventoryNavClass.Length > 0 ? "page" : null)" @onclick="GoInventory">
                        <span class="office-nav-glyph" aria-hidden="true">▦</span>
                        Inventory
                    </button>
                }
                @if (Api.HasPermission(PermissionsInventoryView))
                {
                    <button type="button" class="office-nav-link @NavClass("/inventory/counts")" aria-current="@Current("/inventory/counts")" @onclick="GoCounts">
                        <span class="office-nav-glyph" aria-hidden="true">≡</span>
                        Stock counts
                    </button>
                }
                @if (Api.HasPermission(PermissionsTransferView))
                {
                    <button type="button" class="office-nav-link @NavClass("/transfers")" aria-current="@Current("/transfers")" @onclick="GoTransfers">
                        <span class="office-nav-glyph" aria-hidden="true">⇄</span>
                        Transfers
                    </button>
                }
                @if (Api.HasPermission(PermissionsPurchasingView))
                {
                    <button type="button" class="office-nav-link @NavClass("/purchasing/orders")" aria-current="@Current("/purchasing/orders")" @onclick="GoReceiving">
                        <span class="office-nav-glyph" aria-hidden="true">▣</span>
                        Goods receiving
                    </button>
                }
                <span class="office-nav-label">Devices</span>
                <button type="button" class="office-nav-link @NavClass("/scanner")" aria-current="@Current("/scanner")" @onclick="GoScanner">
                    <span class="office-nav-glyph" aria-hidden="true">▥</span>
                    Scanner test
                </button>

                @if (Api.HasPermission(PermissionsReportsView))
                {
                    <span class="office-nav-label">Sales</span>
                    <button type="button" class="office-nav-link @NavClass("/reports")" aria-current="@Current("/reports")" @onclick="GoReports">
                        <span class="office-nav-glyph" aria-hidden="true">▤</span>
                        Daily reports
                    </button>
                }
            </nav>

            <main class="office-main">
                @if (Register.IsOffline)
                {
                    <div class="office-error" role="status">
                        This account is signed in with saved offline access. Office data needs a live sign-in. Sign out, then sign in again while connected.
                        <button type="button" class="button-secondary" @onclick="SignOutAsync">Sign out and sign in again</button>
                    </div>
                }
                @if (Place is { } place)
                {
                    <nav class="office-trail" aria-label="Breadcrumb">
                        <a class="office-trail-back" href="@place.ParentHref" aria-label="Back to @place.ParentLabel">
                            <span aria-hidden="true">←</span> Back
                        </a>
                        <ol>
                            <li><a href="/office">Office</a></li>
                            @if (place.ParentHref != "/office")
                            {
                                <li><a href="@place.ParentHref">@place.ParentLabel</a></li>
                            }
                            <li aria-current="page">@place.Title</li>
                        </ol>
                    </nav>
                }
                @if (!Register.IsOffline)
                {
                    @Body
                }
            </main>
        </div>

        <nav class="office-mobile-nav" aria-label="Mobile office">
            <button type="button" class="office-mobile-nav-link @NavClass("/office")" aria-current="@Current("/office")" @onclick="GoOffice">
                <span aria-hidden="true">⌂</span>
                <small>Overview</small>
            </button>
            @if (Api.HasPermission(PermissionsInventoryView))
            {
                <button type="button" class="office-mobile-nav-link @InventoryNavClass" aria-current="@(InventoryNavClass.Length > 0 ? "page" : null)" @onclick="GoInventory">
                    <span aria-hidden="true">▦</span>
                    <small>Inventory</small>
                </button>
                <button type="button" class="office-mobile-nav-link @NavClass("/inventory/counts")" aria-current="@Current("/inventory/counts")" @onclick="GoCounts">
                    <span aria-hidden="true">≡</span>
                    <small>Counts</small>
                </button>
            }
            @if (Api.HasPermission(PermissionsTransferView))
            {
                <button type="button" class="office-mobile-nav-link @NavClass("/transfers")" aria-current="@Current("/transfers")" @onclick="GoTransfers">
                    <span aria-hidden="true">⇄</span>
                    <small>Transfers</small>
                </button>
            }
            <button type="button" class="office-mobile-nav-link @(mobileMoreOpen ? "active" : string.Empty)" aria-expanded="@mobileMoreOpen" @onclick="ToggleMobileMore">
                <span aria-hidden="true">•••</span>
                <small>More</small>
            </button>
        </nav>

        @if (mobileMoreOpen)
        {
            <div class="office-mobile-more-backdrop" @onclick="CloseMobileMore"></div>
            <section class="office-mobile-more" role="dialog" aria-modal="true" aria-label="More office tools">
                <header>
                    <strong>More tools</strong>
                    <button type="button" aria-label="Close more tools" @onclick="CloseMobileMore">×</button>
                </header>
                @if (Api.HasPermission(PermissionsSaleCreate))
                {
                    <button type="button" @onclick="GoTill"><span>▣</span>Open till</button>
                }
                @if (Api.HasPermission(PermissionsPurchasingView))
                {
                    <button type="button" @onclick="GoReceiving"><span>□</span>Goods receiving</button>
                }
                @if (Api.HasPermission(PermissionsReportsView))
                {
                    <button type="button" @onclick="GoReports"><span>▤</span>Daily reports</button>
                }
                <button type="button" @onclick="GoScanner"><span>▥</span>Scanner test</button>
                <button type="button" class="office-mobile-more-danger" @onclick="SignOutAsync"><span>↪</span>Sign out</button>
            </section>
        }
    </div>
}
else if (!_booted)
{
    <main class="office-app">
        <div class="office-loading">Opening the office console…</div>
    </main>
}

@code {
    private const string PermissionsSaleCreate = "sale.create";
    private const string PermissionsInventoryView = "inventory.view";
    private const string PermissionsTransferView = "transfer.view";
    private const string PermissionsPurchasingView = "purchase.view";
    private const string PermissionsReportsView = "report.view";

    [Inject] private BackOfficeService Api { get; set; } = default!;

    private (string Name, string TillCode)? _store;
    private bool _booted;
    private bool mobileMoreOpen;

    protected override async Task OnInitializedAsync()
    {
        if (Register.Current is null)
        {
            Navigation.NavigateTo("/");
            _booted = true;
            return;
        }

        try
        {
            _store = await Register.GetStoreIdentityAsync();
        }
        catch
        {
            _store = (RegisterService.DefaultServer.Host, string.Empty);
        }

        _booted = true;
    }

    private string NavClass(string path)
        => ("/" + Navigation.ToBaseRelativePath(Navigation.Uri)).StartsWith(path, StringComparison.Ordinal) ? "active" : string.Empty;

    private string? Current(string path) => NavClass(path).Length > 0 ? "page" : null;

    // Every page below a sidebar entry gets Back to that entry, in one place.
    // Sidebar pages themselves need none: the sidebar is how you reach them.
    private OfficePlace? Place
    {
        get
        {
            string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return path switch
            {
                "purchasing/orders/new" => new("Goods receiving", "/purchasing/orders", "New purchase order"),
                _ when path.StartsWith("purchasing/orders/", StringComparison.Ordinal) => new("Goods receiving", "/purchasing/orders", "Purchase order"),
                _ when path.StartsWith("inventory/counts/", StringComparison.Ordinal) => new("Stock counts", "/inventory/counts", "Count"),
                _ when path.StartsWith("transfers/", StringComparison.Ordinal) => new("Transfers", "/transfers", "Transfer"),
                _ when path.StartsWith("inventory/timeline/", StringComparison.Ordinal) => new("Overview", "/office", "Movement chain"),
                _ => null,
            };
        }
    }

    private sealed record OfficePlace(string ParentLabel, string ParentHref, string Title);

    private void Go(string path) => Navigation.NavigateTo(path);

    private void ToggleMobileMore() => mobileMoreOpen = !mobileMoreOpen;
    private void CloseMobileMore() => mobileMoreOpen = false;

    private async Task GoOffice() => Go("/office");
    private async Task GoTill() => Go("/register");
    private async Task GoCounts() => Go("/inventory/counts");
    private async Task GoTransfers() => Go("/transfers");
    private async Task GoReceiving() => Go("/purchasing/orders");
    private async Task GoReports() => Go("/reports");
    private void GoScanner() => Go("/scanner");
    private void GoInventory() => Go("/inventory");

    // "/inventory" is a prefix of "/inventory/counts", so match it exactly.
    private string InventoryNavClass
        => ("/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0]).TrimEnd('/') == "/inventory" ? "active" : string.Empty;

    private async Task SignOutAsync()
    {
        await Register.SignOutAsync();
        Navigation.NavigateTo("/", replace: true);
    }
}
