    {
        "Posted" => "status-chip sc-posted",
        "Voided" => "status-chip",
        "Reversed" => "status-chip",
        _ => "status-chip",
    };

    private static decimal ParseNonNegativeDecimal(object? value)
        => decimal.TryParse(value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal parsed)
            ? Math.Max(0m, parsed)
            : 0m;

    private static string ShortId(Guid value) => value.ToString("D", CultureInfo.InvariantCulture)[..8];

    private static string Quantity(decimal value)
        => value == 0m ? "—" : value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string SplitWords(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        return string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character)
                ? $" {char.ToLowerInvariant(character)}"
                : character.ToString()));
    }

    private static string Money(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));
