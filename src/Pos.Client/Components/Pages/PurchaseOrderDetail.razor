    private async Task LoadProductNamesAsync(IReadOnlyCollection<Guid> ids)
    {
        HashSet<Guid> wanted = [.. ids];
        foreach (Guid id in wanted)
        {
            _productNames[id] = (ShortId(id), "Product");
        }

        try
        {
            for (int offset = 0; offset < 2000 && wanted.Count > 0; offset += 200)
            {
                ApiResult<List<PosProductSummary>> response = await Api.GetProductsAsync(null, offset, 200, CancellationToken.None);
                if (!response.IsSuccess || response.Value is null || response.Value.Count == 0)
                {
                    break;
                }

                foreach (PosProductSummary product in response.Value)
                {
                    if (wanted.Remove(product.Id))
                    {
                        _productNames[product.Id] = (product.Sku, product.Name);
                    }
                }

                if (response.Value.Count < 200)
                {
                    break;
                }
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    private async Task LoadReceiptsAsync()
    {
        _receipts.Clear();
        ApiResult<List<GoodsReceiptSummary>> result = await Api.ListGoodsReceiptsAsync(OrderId, CancellationToken.None);
        if (!result.IsSuccess || result.Value is null)
        {
            return;
        }

        foreach (GoodsReceiptSummary summary in result.Value)
        {
            ApiResult<GoodsReceiptDetail> detail = await Api.GetGoodsReceiptAsync(OrderId, summary.Id, CancellationToken.None);
            if (detail.IsSuccess && detail.Value is not null)
            {
                _receipts.Add(detail.Value);
            }
        }
    }

    private void BuildReceivingLines()
    {
        _receivingLines.Clear();
        if (_order is null)
        {
            return;
        }

        foreach (PurchaseOrderLineSummary line in _order.Lines)
        {
            _receivingLines.Add(new ReceivingLine(
                line,
                ProductSku(line.ProductId),
                ProductDisplayName(line.ProductId),
                0m,
                0m,
                0m,
                0m,
                line.UnitCost,
                null,
                null,
                null));
        }
    }

    private void OnReceivedChanged(ReceivingLine line, ChangeEventArgs e) => UpdateQuantity(line, e, (receiving, value) => receiving with { Received = value });
    private void OnDamagedChanged(ReceivingLine line, ChangeEventArgs e) => UpdateQuantity(line, e, (receiving, value) => receiving with { Damaged = value });
    private void OnWrongItemChanged(ReceivingLine line, ChangeEventArgs e) => UpdateQuantity(line, e, (receiving, value) => receiving with { WrongItem = value });
    private void OnExpiredChanged(ReceivingLine line, ChangeEventArgs e) => UpdateQuantity(line, e, (receiving, value) => receiving with { Expired = value });

    private void UpdateQuantity(ReceivingLine line, ChangeEventArgs e, Func<ReceivingLine, decimal, ReceivingLine> update)
    {
        decimal value = ParseNonNegativeDecimal(e.Value);
        int index = _receivingLines.IndexOf(line);
        if (index >= 0)
        {
            _receivingLines[index] = update(_receivingLines[index], value);
        }
    }

    private void OnUnitCostChanged(ReceivingLine line, ChangeEventArgs e)
    {
        decimal value = ParseNonNegativeDecimal(e.Value);
        int index = _receivingLines.IndexOf(line);
        if (index >= 0)
        {
            _receivingLines[index] = _receivingLines[index] with { UnitCost = value };
        }
    }

    private void OnLotChanged(ReceivingLine line, ChangeEventArgs e)
    {
        string? value = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();
        int index = _receivingLines.IndexOf(line);
        if (index >= 0)
        {
            _receivingLines[index] = _receivingLines[index] with { Lot = value };
        }
    }

    private void OnManufacturedChanged(ReceivingLine line, ChangeEventArgs e) => UpdateDate(line, e, (receiving, date) => receiving with { ManufacturedOn = date });

    private void OnExpiresChanged(ReceivingLine line, ChangeEventArgs e) => UpdateDate(line, e, (receiving, date) => receiving with { ExpiresOn = date });

    private void UpdateDate(ReceivingLine line, ChangeEventArgs e, Func<ReceivingLine, DateOnly?, ReceivingLine> update)
    {
        DateOnly? date = DateOnly.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly parsed) ? parsed : null;
        int index = _receivingLines.IndexOf(line);
        if (index >= 0)
        {
            _receivingLines[index] = update(_receivingLines[index], date);
        }
    }

    private void ResetSheet()
    {
        _documentsMissing = false;
        _formError = null;
        for (int index = 0; index < _receivingLines.Count; index++)
        {
            _receivingLines[index] = _receivingLines[index] with
            {
                Received = 0m,
                Damaged = 0m,
                WrongItem = 0m,
                Expired = 0m,
                UnitCost = _receivingLines[index].Line.UnitCost,
                Lot = null,
                ManufacturedOn = null,
                ExpiresOn = null,
            };
        }
    }

    private async Task ScanAsync()
    {
        if (_scanning)
        {
            return;
        }

        string barcode = (_scanValue ?? string.Empty).Trim();
        _scanValue = string.Empty;
        _formError = null;
        _quarantineError = null;
        _scanMessage = null;
        if (barcode.Length == 0)
        {
            return;
        }

        _scanning = true;
        try
        {
            ApiResult<PosScannedProduct> lookup = await Api.GetProductByBarcodeAsync(barcode, CancellationToken.None);
            if (lookup.IsSuccess && lookup.Value is { } product)
            {
                int index = _receivingLines.FindIndex(line => line.Line.ProductId == product.Id);
                if (index >= 0)
                {
                    _receivingLines[index] = _receivingLines[index] with { Received = _receivingLines[index].Received + 1m };
                    _scanMessage = $"{product.Name} received — {Quantity(_receivingLines[index].Received)} counted.";
                    return;
                }

                AddQuarantineLine(barcode, product.Name);
                _scanMessage = $"{product.Name} is not on this order — queued for quarantine.";
                return;
            }

            if (lookup.ErrorCode is "catalog.barcode_unknown" or "catalog.barcode_retired")
            {
                AddQuarantineLine(barcode, null);
                _scanMessage = $"Barcode {barcode} is not catalogued — queued for quarantine.";
                return;
            }

            _scanMessage = lookup.Error ?? "The barcode could not be looked up.";
        }
        catch (HttpRequestException)
        {
            _scanMessage = "The catalogue service is unavailable. Try again shortly.";
        }
        finally
        {
            _scanning = false;
            await RefocusScanAsync();
        }
    }

    private void AddQuarantineLine(string barcode, string? productName)
    {
        int index = _quarantineLines.FindIndex(line => string.Equals(line.Barcode, barcode, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            _quarantineLines[index] = _quarantineLines[index] with { Quantity = _quarantineLines[index].Quantity + 1m };
            return;
        }

        _quarantineLines.Add(new QuarantineLine(barcode, productName, 1m));
    }

    private void OnQuarantineQuantityChanged(QuarantineLine quarantine, ChangeEventArgs e)
    {
        decimal value = ParseNonNegativeDecimal(e.Value);
        int index = _quarantineLines.IndexOf(quarantine);
        if (index >= 0)
        {
            _quarantineLines[index] = _quarantineLines[index] with { Quantity = value };
        }
    }

    private void RemoveQuarantineLine(QuarantineLine quarantine)
        => _quarantineLines.Remove(quarantine);

    private async Task RaiseQuarantineAsync()
    {
        if (_raisingQuarantine || _order is null || _quarantineLines.Count == 0)
        {
            return;
        }

        if (!CanRaiseQuarantine)
        {
            _quarantineError = "Your account cannot raise a quarantine incident. Ask an administrator for the quarantine.create permission.";
            return;
        }

        List<CreateQuarantineLineBody> lines = [.. _quarantineLines
            .Where(line => line.Quantity > 0m)
            .Select(line => new CreateQuarantineLineBody(
                line.Barcode,
                line.Quantity,
                ClaimedProductName: line.ProductName))];

        if (lines.Count == 0)
        {
            _quarantineError = "Enter a counted quantity on at least one quarantined line.";
            return;
        }

        _raisingQuarantine = true;
        _quarantineError = null;
        _notice = null;
        try
        {
            ApiResult<PosReference> result = await Api.CreateQuarantineIncidentAsync(
                _order.DestinationLocationId,
                lines,
                $"Found while receiving {_order.Number} at {LocationLabel(_order.DestinationLocationId)}.",
                CancellationToken.None);

            if (!result.IsSuccess || result.Value is null)
            {
                _quarantineError = result.Error;
                return;
            }

            _notice = $"Quarantine incident recorded for {lines.Count} product{(lines.Count == 1 ? "" : "s")}.";
            _scanMessage = null;
            _quarantineLines.Clear();
        }
        catch (HttpRequestException)
        {
            _quarantineError = "The quarantine service is unavailable. Try again shortly.";
        }
        finally
        {
            _raisingQuarantine = false;
        }
    }

    private async Task RefocusScanAsync()
    {
        if (_scanInput.Context is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("VaultFlowRegister.focusSelect", _scanInput);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task RecordReceiptAsync()
    {
        if (_submitting)
        {
            return;
        }

        List<ReceivingLine> counted = _receivingLines
            .Where(line => line.Received > 0m || line.Damaged > 0m || line.WrongItem > 0m || line.Expired > 0m)
            .ToList();

        if (counted.Count == 0)
        {
            _formError = "Enter a counted quantity on at least one line before recording the receipt.";
            return;
        }

        CreateGoodsReceiptBody body = new(
        [
            .. counted.Select(line => new CreateGoodsReceiptLineBody(
                line.Line.Id,
                line.Received,
                line.Damaged,
                line.WrongItem,
                line.Expired,
                line.UnitCost,
                string.IsNullOrWhiteSpace(line.Lot) ? null : line.Lot.Trim(),
                line.ManufacturedOn,
                line.ExpiresOn)),
        ],
        _documentsMissing);

        _submitting = true;
        _formError = null;
        _notice = null;
        try
        {
            ApiResult<PosReference> result = await Api.CreateGoodsReceiptAsync(OrderId, body, CancellationToken.None);
            if (!result.IsSuccess || result.Value is null)
            {
                _formError = result.Error;
                return;
            }

            _documentsMissing = false;
            _receivingLines.Clear();
            _notice = "Receipt recorded.";
            await LoadDetailAsync();
        }
        catch (HttpRequestException)
        {
            _formError = "The purchasing service is unavailable. Try again shortly.";
        }
        finally
        {
            _submitting = false;
        }
    }

