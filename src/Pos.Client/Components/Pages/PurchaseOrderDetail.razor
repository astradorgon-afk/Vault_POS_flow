    private static string LotLabel(GoodsReceiptLineSummary line)
        => string.IsNullOrWhiteSpace(line.LotNumber)
            ? "—"
            : line.ExpiresOn is { } expires
                ? $"{line.LotNumber} · exp {expires:yyyy-MM-dd}"
                : line.LotNumber;

    private string SupplierName(Guid supplierId)
        => _supplierNames.TryGetValue(supplierId, out string? name)
            ? name
            : ShortId(supplierId);

    private string LocationLabel(Guid locationId)
        => _locations.TryGetValue(locationId, out PosLocation? location)
            ? $"{location.Code} · {location.Name}"
            : ShortId(locationId);

    private string ProductDisplayName(Guid productId)
        => _productNames.TryGetValue(productId, out (string Sku, string Name) product)
            ? product.Name
            : $"Product {ShortId(productId)}";

    private string ProductSku(Guid productId)
        => _productNames.TryGetValue(productId, out (string Sku, string Name) product) && !string.IsNullOrWhiteSpace(product.Sku)
            ? product.Sku
            : "—";

    private static string VarianceTone(decimal percent)
