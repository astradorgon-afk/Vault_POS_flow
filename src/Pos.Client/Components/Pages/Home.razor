@page "/"
@inject DeviceDatabaseInitializer Database
@inject DeviceStatusProvider Status
@inject RegisterService Register

<section class="startup-card @(Register.Current is null ? string.Empty : "startup-card-wide")" aria-live="polite">
    <div class="eyebrow">VaultFlow device</div>

    @if (_error is not null)
    {
        <div class="status status-error">
            <span class="status-dot"></span>
            <div>
                <strong>Secure storage could not start</strong>
                <p>@_error</p>
            </div>
        </div>
    }
    else if (_status is null)
    {
        <div class="status">
            <span class="status-dot status-dot-working"></span>
            <div>
                <strong>Opening encrypted local storage</strong>
                <p>Applying device schema updates and checking the store.</p>
            </div>
        </div>
    }
    else
    {
        <DeviceStatusBanner Status="_status" />

        @if (_status.Enrolment == DeviceEnrolmentState.NotEnrolled)
        {
            <SetupPanel OnEnrolled="RefreshAsync" />
        }
        else if (Register.Current is null)
        {
            <SignInPanel OnSignedIn="RefreshAsync" />
        }
        else
        {
            <CataloguePanel OnSignedOut="RefreshAsync" OnRefreshed="RefreshAsync" />
        }
    }
</section>

@code {
    private DeviceStatusView? _status;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Database.InitializeAsync();
        }
        catch (Exception)
        {
            _error = "Restart the app. If the problem continues, re-enrol this device.";
            return;
        }

        await RefreshAsync();
    }

    // Read after the store is open and after every change of state, so the
    // banner reports the register as it is now rather than as it was.
    private async Task RefreshAsync() => _status = await Status.GetAsync(Register.Current?.UserId);
}
