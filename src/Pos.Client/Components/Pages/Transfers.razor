@page "/transfers"
@layout Layout.OfficeLayout
@using System.Globalization
@inject BackOfficeService Api
@inject NavigationManager Navigation

<PageTitle>Transfers · VaultFlow</PageTitle>

<div class="office-head">
    <div>
        <p class="office-kicker">Inventory command</p>
        <h1 class="office-title">Transfers</h1>
        <p class="office-lead">Move stock between your stores and the main warehouse, and record what arrives at the door.</p>
    </div>
    <div class="head-pickers">
        <label class="location-picker">
            <span>State</span>
            <select @bind="selectedStatus">
                <option value="">All states</option>
                @foreach (string statusName in StatusNames)
                {
                    <option value="@statusName">@SplitWords(statusName)</option>
                }
            </select>
        </label>
    </div>
</div>

@if (!CanViewTransfers)
{
    <section class="pos-blocked" role="alert">
        <span>Access required</span>
        <h2>This account cannot view transfers.</h2>
        <p>Ask an administrator for the <code>transfer.view</code> permission.</p>
    </section>
}
else
{
    <section class="search-strip">
        <span>@visibleTransfers.Count transfer@(visibleTransfers.Count == 1 ? "" : "s")@(searchedLabel.Length > 0 ? $" · {searchedLabel}" : "")</span>
        <span class="search-note">Available on the destination store once a dispatch leaves the source.</span>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="pos-message" role="status">@message</div>
    }

    @if (CanRequestTransfers)
    {
        <section class="open-count">
            <div class="open-count-title">
                <strong>Request a transfer</strong>
                <span>Choose the route, then add the lines. The transfer is created as a draft for someone to review.</span>
            </div>
            <div class="open-count-fields">
                <label class="location-picker">
                    <span>Source</span>
                    <select value="@(sourceLocationId?.ToString() ?? string.Empty)" @onchange="OnSourceLocationChangedAsync" disabled="@locationsLoading">
                        <option value="">Select a source</option>
                        @foreach (PosLocation location in externalLocations)
                        {
                            <option value="@location.Id">@location.Code · @location.Name</option>
                        }
                    </select>
                </label>
                <label class="location-picker">
                    <span>Destination</span>
                    <select value="@(destinationLocationId?.ToString() ?? string.Empty)" @onchange="OnDestinationLocationChangedAsync" disabled="@locationsLoading">
                        <option value="">Select a destination</option>
                        @foreach (PosLocation location in externalLocations)
                        {
                            <option value="@location.Id">@location.Code · @location.Name</option>
                        }
                    </select>
                </label>
                <label class="location-picker">
                    <span>Pre-approval token</span>
                    <input type="text" placeholder="Optional token id"
                           value="@preApprovalTokenId"
                           @onchange="OnTokenChangedAsync" />
                </label>
            </div>
            <div class="transfer-lines">
                @for (int index = 0; index < draftLines.Count; index++)
                {
                    // Handlers run after the loop ends; capture this row's index,
                    // not the loop variable (which would equal draftLines.Count).
                    int lineIndex = index;
                    <div class="transfer-line" @key="draftLines[lineIndex].Marker">
                        <select class="line-product"
                                value="@(draftLines[lineIndex].ProductId?.ToString() ?? string.Empty)"
                                @onchange="(e) => OnLineProductChangedAsync(lineIndex, e)">
                            <option value="">Select a product</option>
                            @foreach (PosProductSummary product in products)
                            {
                                <option value="@product.Id">@product.Sku · @product.Name</option>
                            }
                        </select>
                        <input class="line-quantity" type="number" min="0" step="1" placeholder="Qty"
                               value="@draftLines[lineIndex].Quantity"
                               @onchange="(e) => OnLineQuantityChanged(lineIndex, e)" />
                        @if (draftLines.Count > 1)
                        {
                            <button type="button" class="line-remove" @onclick="() => RemoveLine(lineIndex)">✕</button>
                        }
                    </div>
                }
                <button type="button" class="search-action line-add" @onclick="AddLine" disabled="@(products.Count == 0)">
                    + Add line
                </button>
            </div>
            <div class="open-count-actions">
                <button type="button" class="search-action" @onclick="CreateTransferAsync"
                        disabled="@(!CanCreateTransfer || creating)">
                    @(creating ? "Creating…" : "Create transfer")
                </button>
            </div>
        </section>
    }

    <section class="results-panel" aria-live="polite">
        @if (loading)
        {
            <div class="results-empty">Loading transfers…</div>
        }
        else if (visibleTransfers.Count == 0)
        {
            <div class="results-empty"><strong>No transfers yet.</strong><span>Request one, or wait for a dispatch to arrive at your store.</span></div>
        }
        else
        {
            <table class="sales-table counts-table">
                <thead>
                    <tr><th>NUMBER</th><th>Status</th><th>Route</th><th>Lines</th><th>Value</th><th>Created</th><th>Dispatched</th><th>Received</th></tr>
                </thead>
                <tbody>
                    @foreach (PosTransferSummary transfer in visibleTransfers)
                    {
                        <tr class="office-row-click" @key="transfer.Id" @onclick="() => OpenTransfer(transfer.Id)">
                            <td class="sale-number">@transfer.Number</td>
                            <td>
                                <span class="@StatusChipClass(transfer.Status)">@SplitWords(transfer.Status)</span>
                                @if (AwaitingReceive(transfer.Status) && CanReceive)
                                {
                                    <span class="status-chip sc-dispatched">awaiting receipt</span>
                                }
                            </td>
                            <td>@LocationLabel(transfer.SourceLocationId) → @LocationLabel(transfer.DestinationLocationId)</td>
                            <td>@transfer.LineCount</td>
                            <td>@Money(transfer.TotalValue)</td>
                            <td>@transfer.CreatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>@(transfer.DispatchedAtUtc?.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                            <td>@(transfer.ReceivedAtUtc?.ToLocalTime().ToString("MMM d, HH:mm", CultureInfo.InvariantCulture) ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private static readonly string[] StatusNames =
    [
        "Draft", "Submitted", "InReview", "Approved", "Picking", "Ready",
        "Dispatched", "PartiallyReceived", "Received", "Closed", "Cancelled",
        "PendingCentralReview",
    ];

    private sealed record DraftLine(long Marker, Guid? ProductId, decimal Quantity);

    private readonly List<PosLocation> locations = [];
    private readonly List<PosProductSummary> products = [];
    private readonly List<PosTransferSummary> transfers = [];
    private readonly List<DraftLine> draftLines = [];

    private Guid? sourceLocationId;
    private Guid? destinationLocationId;
    private string preApprovalTokenId = string.Empty;
    private string selectedStatus = string.Empty;
    private string searchedLabel = string.Empty;

    private bool locationsLoading = true;
    private bool loading;
    private bool creating;
    private string? message;
    private long nextMarker = 1;

    private bool CanViewTransfers => Api.HasPermission("transfer.view");
    private bool CanRequestTransfers => Api.HasPermission("transfer.request");
    private bool CanReceive => Api.HasPermission("transfer.receive");

    private List<PosTransferSummary> visibleTransfers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(selectedStatus))
            {
                return transfers;
            }

            return transfers.Where(t => string.Equals(t.Status, selectedStatus, StringComparison.Ordinal)).ToList();
        }
    }

    private List<PosLocation> externalLocations =>
        locations.Where(l => l.Kind is 0 or 1).OrderBy(l => l.Kind).ThenBy(l => l.Code).ToList();

    private bool CanCreateTransfer =>
        sourceLocationId is { } source &&
        destinationLocationId is { } destination &&
        source != destination &&
        draftLines.Count > 0 &&
        draftLines.All(line => line.ProductId is not null && line.Quantity > 0m);

    protected override async Task OnInitializedAsync()
    {
        if (!CanViewTransfers)
        {
            locationsLoading = false;
            return;
        }

        await LoadLocationsAsync();
        if (CanRequestTransfers)
        {
            await LoadProductsAsync();
            AddLine();
        }

        await LoadTransfersAsync();
    }

    private async Task LoadLocationsAsync()
    {
        ApiResult<List<PosLocation>> response = await Api.GetLocationsAsync(CancellationToken.None);
        locationsLoading = false;
        if (!response.IsSuccess || response.Value is null)
        {
            message = response.Error;
            return;
        }

        locations.AddRange(response.Value.Where(location => location.Kind == 1 && location.IsActive));
    }

    private async Task LoadProductsAsync()
    {
        const int pageSize = 200;
        const int maxPages = 10;

        for (int offset = 0; offset < maxPages * pageSize; offset += pageSize)
        {
            ApiResult<List<PosProductSummary>> response = await Api.GetProductsAsync(
                null, offset, pageSize, CancellationToken.None);
            if (!response.IsSuccess || response.Value is null || response.Value.Count == 0)
            {
                break;
            }

            products.AddRange(response.Value);
            if (response.Value.Count < pageSize)
            {
                break;
            }
        }

        products.Sort((left, right) =>
            string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase));
    }

    private async Task LoadTransfersAsync()
    {
        loading = true;
        message = null;
        try
        {
            ApiResult<List<PosTransferSummary>> response = await Api.GetTransfersAsync(CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            transfers.Clear();
            transfers.AddRange(response.Value);
            searchedLabel = string.IsNullOrWhiteSpace(selectedStatus)
                ? "all states"
                : SplitWords(selectedStatus);
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            loading = false;
        }
    }

    private void OnSourceLocationChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        sourceLocationId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
    }

    private void OnDestinationLocationChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        destinationLocationId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
    }

    private void OnTokenChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        preApprovalTokenId = e.Value?.ToString() ?? string.Empty;
    }

    private void OnLineProductChangedAsync(int index, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        Guid? productId = Guid.TryParse(e.Value?.ToString(), out Guid id) ? id : null;
        draftLines[index] = draftLines[index] with { ProductId = productId };
    }

    private void OnLineQuantityChanged(int index, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        decimal quantity = decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out decimal value)
            ? value
            : 0m;
        draftLines[index] = draftLines[index] with { Quantity = quantity };
    }

    private void AddLine() => draftLines.Add(new DraftLine(nextMarker++, null, 0m));

    private void RemoveLine(int index) => draftLines.RemoveAt(index);

    private async Task CreateTransferAsync()
    {
        if (sourceLocationId is not { } source || destinationLocationId is not { } destination)
        {
            message = "Pick the route before creating the transfer.";
            return;
        }

        List<PosTransferLineRequest> lines =
        [
            .. draftLines
                .Where(line => line.ProductId is not null && line.Quantity > 0m)
                .Select(line => new PosTransferLineRequest(line.ProductId!.Value, line.Quantity)),
        ];

        if (lines.Count == 0)
        {
            message = "Add at least one line with a quantity before creating the transfer.";
            return;
        }

        Guid? tokenId = Guid.TryParse(preApprovalTokenId, out Guid token) ? token : null;

        creating = true;
        message = null;
        try
        {
            ApiResult<PosReference> response = await Api.CreateTransferAsync(
                new PosCreateTransferRequest(source, destination, lines, tokenId),
                CancellationToken.None);
            if (!response.IsSuccess || response.Value is null)
            {
                message = response.Error;
                return;
            }

            preApprovalTokenId = string.Empty;
            sourceLocationId = null;
            destinationLocationId = null;
            draftLines.Clear();
            AddLine();
            Navigation.NavigateTo($"/transfers/{response.Value.Id:D}");
        }
        catch (HttpRequestException)
        {
            message = "The inventory service is unavailable. Try again shortly.";
        }
        finally
        {
            creating = false;
        }
    }

    private void OpenTransfer(Guid transferId) => Navigation.NavigateTo($"/transfers/{transferId:D}");

    private string LocationLabel(Guid locationId)
    {
        PosLocation? location = locations.FirstOrDefault(l => l.Id == locationId);
        return location?.Code ?? locationId.ToString("D", CultureInfo.InvariantCulture)[..8];
    }

    private static bool AwaitingReceive(string status)
        => status is "Dispatched" or "PartiallyReceived";

    private static string SplitWords(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        return string.Concat(value.Select((character, index) =>
            index > 0 && char.IsUpper(character)
                ? $" {char.ToLowerInvariant(character)}"
                : character.ToString()));
    }

    private static string Money(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));

    private static string StatusChipClass(string status) => status switch
    {
        "Draft" => "status-chip sc-draft",
        "Submitted" => "status-chip sc-submitted",
        "InReview" => "status-chip sc-in-review",
        "Approved" => "status-chip sc-approved",
        "Picking" => "status-chip sc-picking",
        "Ready" => "status-chip sc-ready",
        "Dispatched" => "status-chip sc-dispatched",
        "PartiallyReceived" => "status-chip sc-partially-received",
        "Received" => "status-chip sc-received",
        "Closed" => "status-chip sc-closed",
        "Cancelled" => "status-chip sc-cancelled",
        "PendingCentralReview" => "status-chip sc-pending-central-review",
        _ => "status-chip",
    };
}