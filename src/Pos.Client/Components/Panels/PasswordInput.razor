@* A password box with its own Show/Hide switch. The browser engine's reveal
   eye only appears while a field is first typed into, so after one failed
   sign-in there was no way to check what was entered. *@

<div class="password-field">
    <input type="@(_visible ? "text" : "password")"
           value="@Value"
           @oninput="OnInput"
           autocomplete="@AutoComplete"
           autocapitalize="off"
           spellcheck="false" />
    <button type="button"
            class="password-toggle @(_visible ? "is-visible" : null)"
            title="@(_visible ? "Hide password" : "Show password")"
            aria-pressed="@(_visible ? "true" : "false")"
            aria-label="@(_visible ? "Hide password" : "Show password")"
            @onclick="() => _visible = !_visible">
        <svg class="eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="eye-lid" d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12z" /><circle class="eye-pupil" cx="12" cy="12" r="2.8" /><line class="eye-slash" x1="4.5" y1="4.5" x2="19.5" y2="19.5" /></svg>
    </button>
</div>

@code {
    private bool _visible;

    /// <summary>Gets or sets the password typed so far.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>Raised as the password changes, for <c>@bind-Value</c>.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Gets or sets the autocomplete hint for the password manager.</summary>
    [Parameter]
    public string AutoComplete { get; set; } = "current-password";

    private Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}
