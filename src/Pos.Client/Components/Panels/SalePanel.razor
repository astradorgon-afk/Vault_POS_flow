@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using Pos.Client.Models
@using Pos.Domain.Sales
@implements IDisposable
@inject RegisterService Register
@inject NavigationManager Navigation

<div class="register-app cashier-app" @onkeydown="HandleKeyDownAsync">
    <RegisterHeader
        StoreName="@_storeName"
        TillCode="@_tillCode"
        CashierName="@Register.Current?.DisplayName"
        ShiftNumber="@_context?.OpenShift?.Number"
        BusinessDateText="@BusinessDateText"
        Online="_online"
        SyncTime="@SyncTime"
        Pending="Status?.UnsentEvents ?? 0"
        ShowOffice="CanOpenOffice"
        OnOffice="OpenOffice"
        OnMore="OpenMoreAsync"
        OnLock="SignOutAsync" />

    <RegisterStatusStrip
        Status="Status"
        ContextError="@_contextError"
        SignedInOffline="SignedInOffline"
        TillOffline="@(_context?.IsOffline == true)"
        Backlog="@BacklogText"
        OfflineAuthorityExpiresUtc="Register.Current?.OfflineAuthorityExpiresAtUtc"
        OnReconnect="OpenReconnect" />

    @if (_completionNoticeOpen && _lastSale is not null)
    {
        <section class="sale-complete-strip" aria-label="Completed sale">
            <span class="sale-complete-check" aria-hidden="true">✓</span>
            <div class="sale-complete-identity" role="status" aria-live="polite">
                <strong>Sale complete</strong>
                <span>@_lastSale.Number</span>
            </div>
            @if (_changeDue is { } changeDue)
            {
                <div class="sale-complete-change">
                    <span>Change due</span>
                    <strong>@PriceOf(changeDue)</strong>
                </div>
            }
            <span class="sale-complete-ready">
                @(_lastSale.IsOffline
                    ? "Kept on this register and sent to head office when connected · ready for the next scan"
                    : "Ready for the next scan")
            </span>
            <button type="button" class="button-secondary sale-complete-receipt" @onclick="OpenOriginalReceiptAsync">
                View receipt
            </button>
            <button type="button" class="sale-complete-dismiss" @onclick="DismissCompletionNotice" aria-label="Dismiss completed sale">×</button>
        </section>
    }

    @if (_screen == SaleScreen.Gate)
    {
        <div class="till-gate">
            <span class="eyebrow">Access required</span>
            <h3>This account cannot create sales.</h3>
            <p>Ask an administrator for the <code>sale.create</code> permission.</p>
        </div>
    }
    else if (_screen == SaleScreen.Loading)
    {
        <div class="till-loading"><span class="status-dot status-dot-working"></span> Preparing the till…</div>
    }
    else
    {
        <main class="till-workspace" aria-label="Register">
            <section class="till-pane till-pane-left @(PaymentShown ? "pane-dimmed" : string.Empty)">
                @if (_screen is SaleScreen.Selling or SaleScreen.NeedsShift or SaleScreen.OtherShift)
                {
                    <BarcodeEntry
                        Value="@_barcode"
                        ValueChanged="OnBarcodeChanged"
                        Message="@BarcodeError"
                        OnSubmit="AddFromBarcodeAsync"
                        Disabled="_busy"
                        FocusTicket="_scanTicket" />

                    <ProductBrowser
                        Items="_items"
                        OnAdd="AddProductToSale"
                        InSaleQuantity="InSaleQuantity"
                        Search="@_search"
                        SearchChanged="OnSearchChanged"
                        ActiveFamily="@_activeFamily"
                        ActiveFamilyChanged="OnFamilyChanged"
                        SearchFocusTicket="_searchTicket" />
                }
            </section>

            <aside class="till-pane till-pane-right @(PaymentShown ? "pane-payment" : string.Empty)">
                @if (_screen == SaleScreen.NeedsShift)
                {
                    <section class="shift-open-card">
                        <span class="eyebrow">Drawer closed</span>
                        <h3>Open the shift before the first sale.</h3>
                        <p>
                            @(_context is null
                                ? "Connect to head office so this register can load its business date and shift."
                                : $"Business date: {@_context.BusinessDate.ToString("ddd, MMM d yyyy", CultureInfo.InvariantCulture)}"
                                  + (_context.IsOffline ? " · working offline; the shift is sent to head office when connected." : string.Empty))
                        </p>
                        <button type="button" class="button-primary" @onclick="StartShiftOpen" disabled="@(_context is null || _busy)">
                            Open shift
                        </button>
                    </section>
                }
                else if (_screen == SaleScreen.OtherShift)
                {
                    <section class="shift-open-card">
                        <span class="eyebrow">Drawer opened by someone else</span>
                        <h3>Sell under your own shift only.</h3>
                        <p>
                            This drawer was opened by @(_context?.OpenShift?.CashierName ?? "another cashier").
                            Every sale is recorded against the cashier who opened the shift, so this register
                            can’t complete your sale into it.
                            @(CanCloseOtherShift
                                ? "You have the clearance to close their shift, then open your own."
                                : "Ask them to close it, or sign in with an account that can.")
                        </p>
                        @if (CanCloseOtherShift)
                        {
                            <button type="button" class="button-primary" @onclick="MoreCloseShiftAsync" disabled="@_closingShift">
                                Close their shift
                            </button>
                        }
                    </section>
                }
                else if (_screen == SaleScreen.Payment)
                {
                    @if (_error is not null)
                    {
                        <InlineRegisterAlert Variant="error" Message="@_error" />
                    }

                    <PaymentPanel
                        @ref="_payPanel"
                        Total="NetTotal"
                        CashRoundingIncrement="_context?.CashRoundingIncrement ?? 0.01m"
                        PaymentAllowed="PaymentAllowed"
                        PaymentBlockedMessage="@PaymentBlockedMessage"
                        PaymentBlockedDetail="@RegisterService.OfflineSaleMessaging"
                        CashOnly="WorkingOffline"
                        FocusTicket="_cashTicket"
                        Busy="_screen == SaleScreen.Completing"
                        OnComplete="CompleteSaleAsync"
                        OnBack="BackToCartAsync" />
                }
                else if (_receiptOpen)
                {
                    <section class="receipt-view">
                        <span class="eyebrow">Receipt — @(_lastSale?.Number ?? string.Empty)</span>

                        @if (_receiptAfterSale && _changeDue is { } changeDue)
                        {
                            <div class="receipt-change-due" role="status">
                                <span>Change due</span>
                                <strong>@PriceOf(changeDue)</strong>
                            </div>
                        }

                        @if (_receiptBusy)
                        {
                            <div class="receipt-fetch" aria-live="polite">
                                <span class="receipt-fetch-line"></span>
                                <span class="receipt-fetch-line"></span>
                                <span class="receipt-fetch-line short"></span>
                            </div>
                        }
                        else if (_receiptError is not null)
                        {
                            <InlineRegisterAlert
                                Variant="error"
                                Message="@_receiptError"
                                Details="@(_receiptAfterSale
                                    ? "The sale is safe. Try loading this customer copy again."
                                    : "Close and try the reprint again from the More menu.")" />
                        }
                        else
                        {
                            <div class="receipt-paper">
                                <textarea class="receipt-text" readonly aria-label="Receipt text">@_receiptText</textarea>
                            </div>
                        }

                        <div class="receipt-actions">
                            @if (_receiptError is not null)
                            {
                                <button type="button" class="button-secondary" @onclick="RetryReceiptAsync">Try again</button>
                            }
                            <button type="button" class="button-primary" @onclick="CloseReceipt">
                                Back to sale <kbd>Esc</kbd>
                            </button>
                        </div>
                    </section>
                }
                else
                {
                    @if (_discountOpen)
                    {
                        <InlineRegisterAlert
                            Variant="caution"
                            Message="Discounts are authorised at head office in this release — this register can’t change a price mid-sale. Alert a manager." />
                    }
                    @if (_error is not null)
                    {
                        <InlineRegisterAlert Variant="error" Message="@_error" />
                    }

                    <CartPanel
                        Lines="_cart"
                        SelectedProductId="_selectedProductId"
                        Customer="_customer"
                        ShowCustomerButton="CanViewCustomers"
                        OnCustomer="OpenCustomerAsync"
                        OnCustomerClear="ClearCustomer"
                        OnSelectLine="(id) => _selectedProductId = id"
                        OnIncrement="IncrementLine"
                        OnDecrement="DecrementLine"
                        OnEditQuantity="EditQuantity"
                        OnVoid="VoidSelected"
                        OnPay="BeginPayment"
                        OnHold="HoldSale"
                        OnDiscount="ToggleDiscount"
                        OnClear="ClearCart"
                        HeldCount="_heldSales.Count" />
                }
            </aside>
        </main>
    }

    @if (_shiftDialogOpen)
    {
        <ShiftOpenDialog
            BusinessDateText="@BusinessDateText"
            Busy="_openingShift"
            Error="@_shiftError"
            OnConfirm="OpenShiftAsync"
            OnDismiss="DismissShiftOpen" />
    }

    @if (_reconnectOpen && Register.Current is { } offlineUser)
    {
        <ReconnectDialog
            UserName="@offlineUser.DisplayName"
            Busy="_reconnecting"
            Error="@_reconnectError"
            OnConfirm="ReconnectAsync"
            OnDismiss="() => _reconnectOpen = false" />
    }

    @if (_heldPanelOpen)
    {
        <HeldSalesPanel Held="_heldSales" OnRecall="RecallHeldAsync" OnDismiss="() => _heldPanelOpen = false" />
    }

    @if (_shiftCloseOpen)
    {
        <ShiftCloseDialog
            Open="true"
            Summary="_shiftSummary"
            Busy="_closingShift"
            Error="@_shiftCloseError"
            OnConfirm="ConfirmShiftCloseAsync"
            OnDismiss="DismissShiftClose" />
    }

    @if (_returnsOpen)
    {
        <ReturnsPanel
            Open="true"
            BusinessDate="@(_context?.BusinessDate ?? default(DateOnly))"
            ShiftId="@(_context?.OpenShift?.ShiftId ?? Guid.Empty)"
            CanViewSales="CanViewSales"
            CanCreateReturn="CanReturn"
            CanRefund="CanRefund"
            SearchSales="@((from, to) => Register.SearchSalesAsync(from, to))"
            GetSaleDetail="LoadReturnSaleAsync"
            AcceptReturn="AcceptReturnAsync"
            RefundReturn="RefundReturnAsync"
            OnDismiss="DismissReturns" />
    }

    @if (_customerDialogOpen)
    {
        <CustomerDialog
            Open="true"
            CanCreate="CanCreateCustomer"
            SearchCustomers="@(query => Register.SearchCustomersAsync(query))"
            CreateCustomer="@((name, phone, email) => Register.CreateCustomerAsync(name, phone, email))"
            OnSelect="SelectCustomerAsync"
            OnDismiss="DismissCustomer" />
    }

    @if (_moreOpen)
    {
        <RegisterMoreMenu
            Open="true"
            HeldCount="_heldSales.Count"
            ShowReturns="CanReturn && !WorkingOffline && _context?.OpenShift is not null && !ShiftOpenedByOther"
            ShowCloseShift="(CanCloseShift || (ShiftOpenedByOther && CanCloseOtherShift)) && _context?.OpenShift is not null"
            ShowReprint="CanReprint"
            ReprintEnabled="_lastSale is not null"
            OnHeldSales="MoreHeldAsync"
            OnReturnItems="MoreReturnsAsync"
            OnRefreshStore="RefreshAsync"
            OnCloseShift="MoreCloseShiftAsync"
            OnReprint="MoreReprintAsync"
            OnLock="SignOutAsync"
            OnDismiss="CloseMore" />
    }

    @if (_qtyTarget is not null)
    {
        <QuantityDialog
            ProductName="@_qtyTarget.Item.Name"
            StartQuantity="_qtyTarget.Quantity"
            OnCommit="CommitQuantity"
            OnDismiss="() => _qtyTarget = null" />
    }

    <ShortcutBar
        PaymentMode="_screen == SaleScreen.Payment"
        HeldPanelOpen="_heldPanelOpen"
        MoreOpen="_moreOpen"
        HasItems="_cart.Count > 0"
        OnShortcut="PressShortcutAsync" />
</div>

@code {
    /// <summary>The one thing the register is doing, instead of a drawer-full of booleans.</summary>
    private enum SaleScreen
    {
        /// <summary>Store data is still loading.</summary>
        Loading,

        /// <summary>The account cannot create sales; nothing else is reachable.</summary>
        Gate,

        /// <summary>No shift is open; scanning works but paying does not.</summary>
        NeedsShift,

        /// <summary>A shift is open, but a different cashier opened it; selling into it is not allowed.</summary>
        OtherShift,

        /// <summary>Building a sale.</summary>
        Selling,

        /// <summary>The right pane is taking payment; the catalogue is dimmed.</summary>
        Payment,

        /// <summary>Head office is committing the sale.</summary>
        Completing,
    }

    private readonly List<CatalogueItem> _items = [];
    private readonly List<SaleCartLine> _cart = [];
    private readonly List<HeldSale> _heldSales = [];
    private RegisterCheckoutContext? _context;
    private string? _contextError;
    private decimal? _changeDue;
    private Guid? _selectedProductId;
    private SaleCartLine? _qtyTarget;
    private SaleScreen _screen = SaleScreen.Loading;
    private string _storeName = "VaultFlow";
    private string _tillCode = string.Empty;
    private string _search = string.Empty;
    private string _barcode = string.Empty;
    private string? BarcodeError { get; set; }
    private string? _activeFamily;
    private string? _error;
    private string? _shiftError;
    private bool _openingShift;
    private bool _refreshing;
    private bool _shiftDialogOpen;
    private bool _heldPanelOpen;
    private bool _moreOpen;
    private bool _discountOpen;
    private int _scanTicket;
    private int _searchTicket;
    private int _cashTicket;
    private PaymentPanel? _payPanel;
    private CompletedRegisterSale? _lastSale;
    private bool _returnsOpen;
    private Guid? _returnsSaleId;
    private bool _shiftCloseOpen;
    private RegisterShiftSummary? _shiftSummary;
    private bool _closingShift;
    private string? _shiftCloseError;
    private bool _receiptOpen;
    private bool _receiptAfterSale;
    private bool _completionNoticeOpen;
    private bool _receiptBusy;
    private string _receiptText = string.Empty;
    private string? _receiptError;
    private bool _customerDialogOpen;
    private RegisterCustomer? _customer;
    private bool _reconnectOpen;
    private bool _reconnecting;
    private string? _reconnectError;
    private readonly CancellationTokenSource _watch = new();

    /// <summary>The register's status, fed down for the strip and messaging.</summary>
    [Parameter]
    public DeviceStatusView? Status { get; set; }

    /// <summary>Raised when the register has been locked.</summary>
    [Parameter]
    public EventCallback OnSignedOut { get; set; }

    /// <summary>Raised after fresh store data has been downloaded.</summary>
    [Parameter]
    public EventCallback OnRefreshed { get; set; }

    private bool CanCreateSale => Register.Current?.Can("sale.create") == true;

    private bool CanReturn => Register.Current?.Can("sale.return") == true;

    private bool CanRefund => Register.Current?.Can("sale.refund") == true;

    private bool CanReprint => Register.Current?.Can("sale.reprint") == true;

    private bool CanCloseShift => Register.Current?.Can("shift.close") == true;

    /// <summary>Whether this account may close a shift opened by someone else.</summary>
    private bool CanCloseOtherShift => Register.Current?.Can("shift.close.other") == true;

    /// <summary>The cashier signed in without head office.</summary>
    private bool SignedInOffline => Register.Current?.IsOffline == true;

    /// <summary>
    /// The till is trading without head office: either nobody could sign in
    /// with it, or it stopped answering after they did.
    /// </summary>
    private bool WorkingOffline => SignedInOffline || _context?.IsOffline == true;

    private string? BacklogText =>
        Register.LastUpload is { } backlog
            ? RegisterService.DescribeBacklog(backlog)
              + (Register.LastUploadRefusal is { Length: > 0 } refusal ? " Head office refused them: " + refusal : string.Empty)
            : null;

    /// <summary>
    /// A shift is open on this device, but the signed-in cashier did not open it:
    /// sales are recorded against the shift's own cashier, so selling must be blocked.
    /// </summary>
    private bool ShiftOpenedByOther =>
        _context?.OpenShift is { } shift
        && shift.CashierUserId != Register.Current?.UserId.Value;

    private bool CanViewSales => Register.Current?.Can("sale.view") == true && !WorkingOffline;

    private bool CanViewCustomers => Register.Current?.Can("customer.view") == true && !WorkingOffline;

    // Same rule the sign-in uses to land an account on the office console. The
    // office is head office's, so it is not offered while working offline.
    private bool CanOpenOffice =>
        !WorkingOffline
        && Register.Current?.Permissions.Any(perm =>
            perm is "inventory.view" or "transfer.view" or "purchase.view" or "report.view") == true;

    private void OpenOffice()
    {
        // Leaving the till drops the open cart, so ask for it to be settled first.
        if (_cart.Count > 0)
        {
            _error = "Hold or finish this sale before opening the office.";
            return;
        }

        Navigation.NavigateTo("/office");
    }

    // A click on the shortcut bar behaves exactly like the key it shows.
    private Task PressShortcutAsync(string key) => HandleKeyDownAsync(new KeyboardEventArgs { Key = key });

    private bool CanCreateCustomer => Register.Current?.Can("customer.manage") == true && !WorkingOffline;

    private bool _busy => _refreshing || _openingShift || _screen is SaleScreen.Completing or SaleScreen.Loading;

    private bool PaymentShown => _screen == SaleScreen.Payment;

    private decimal NetTotal => decimal.Round(_cart.Sum(line => line.Total), 4, MidpointRounding.ToEven);

    private bool _online => !WorkingOffline && _contextError is null;

    // Offline, the register takes cash on the cached authority; once that has
    // expired it takes nothing until someone signs in with head office.
    private bool PaymentAllowed =>
        _context?.OpenShift is not null && !(WorkingOffline && Status?.Authority == DeviceAuthorityState.Expired);

    private string? PaymentBlockedMessage
        => WorkingOffline && Status?.Authority == DeviceAuthorityState.Expired
            ? "Your offline access on this register has expired. Connect to head office to complete sales."
            : null;

    private string BusinessDateText =>
        _context?.BusinessDate is { } date
            ? date.ToString("ddd, MMM d yyyy", CultureInfo.InvariantCulture)
            : "—";

    private string SyncTime => MoneyFormat.Time(Status?.LastSynchronisedUtc);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadTillAsync();
        }
        catch (HeadOfficeException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (_screen == SaleScreen.Loading)
            {
                _screen = ApplyPostLoadScreen();
            }
        }

        _ = WatchForHeadOfficeAsync(_watch.Token);
    }

    /// <summary>
    /// While a connected cashier's till is working offline because head office
    /// stopped answering, asks again every so often. When it answers, the till
    /// sends what it kept and goes back to trading through head office.
    /// </summary>
    private async Task WatchForHeadOfficeAsync(CancellationToken token)
    {
        using PeriodicTimer timer = new(TimeSpan.FromSeconds(45));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(TryReturnOnlineAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // The till was closed.
        }
        catch (ObjectDisposedException)
        {
            // The till closed between ticks.
        }
    }

    private async Task TryReturnOnlineAsync()
    {
        if (SignedInOffline
            || _context?.IsOffline != true
            || _busy
            || _screen is SaleScreen.Payment or SaleScreen.Completing)
        {
            return;
        }

        try
        {
            RegisterCheckoutContext context = await Register.GetCheckoutContextAsync();
            if (context.IsOffline)
            {
                return;
            }

            _context = context;
            _contextError = null;
            if (_screen is SaleScreen.NeedsShift or SaleScreen.OtherShift or SaleScreen.Selling)
            {
                _screen = ShiftScreenForContext();
            }

            await OnRefreshed.InvokeAsync();
            StateHasChanged();
        }
        catch (HeadOfficeException)
        {
            // Still unreachable, or refusing; the till keeps working offline.
        }
    }

    /// <summary>Stops watching for head office when the till closes.</summary>
    public void Dispose()
    {
        _watch.Cancel();
        _watch.Dispose();
    }

    private void OpenReconnect()
    {
        _moreOpen = false;
        _reconnectError = null;
        _reconnectOpen = true;
    }

    private async Task ReconnectAsync(string password)
    {
        if (_reconnecting)
        {
            return;
        }

        _reconnecting = true;
        _reconnectError = null;
        try
        {
            await Register.ReconnectAsync(password);
            _reconnectOpen = false;
            await LoadTillAsync();
            if (_screen is SaleScreen.NeedsShift or SaleScreen.OtherShift or SaleScreen.Selling)
            {
                _screen = ShiftScreenForContext();
            }

            await OnRefreshed.InvokeAsync();
        }
        catch (HeadOfficeException ex)
        {
            _reconnectError = ex.Message;
        }
        finally
        {
            _reconnecting = false;
        }
    }

    private SaleScreen ApplyPostLoadScreen()
    {
        if (!CanCreateSale)
        {
            return SaleScreen.Gate;
        }

        if (_context?.OpenShift is null)
        {
            // Only offer to open the dialog once per load; the cashier decides when.
            _shiftDialogOpen = _context is not null;
            return SaleScreen.NeedsShift;
        }

        if (ShiftOpenedByOther)
        {
            return SaleScreen.OtherShift;
        }

        _scanTicket++;
        return SaleScreen.Selling;
    }

    /// <summary>
    /// Maps the current checkout context to a till screen: a missing shift means
    /// <see cref="SaleScreen.NeedsShift"/>, someone else's shift means
    /// <see cref="SaleScreen.OtherShift"/>, otherwise the till is selling.
    /// </summary>
    private SaleScreen ShiftScreenForContext()
    {
        if (_context?.OpenShift is null)
        {
            return SaleScreen.NeedsShift;
        }

        return ShiftOpenedByOther ? SaleScreen.OtherShift : SaleScreen.Selling;
    }

    private async Task LoadTillAsync()
    {
        (string name, string tillCode) identity = await Register.GetStoreIdentityAsync();
        _storeName = identity.name;
        _tillCode = identity.tillCode;
        _items.Clear();
        _items.AddRange(await Register.GetCatalogueAsync());

        if (CanCreateSale)
        {
            try
            {
                _context = await Register.GetCheckoutContextAsync();
                _contextError = null;
            }
            catch (HeadOfficeException ex)
            {
                // The catalogue is local and still works; night shifts should still
                // be able to look at products. Payments and shifts stay blocked.
                _context = null;
                _contextError = ex.Message;
            }
        }
        else
        {
            _context = null;
        }
    }

    private async Task RefreshAsync()
    {
        if (_busy)
        {
            return;
        }

        if (SignedInOffline)
        {
            // Store data comes from head office; connect this session first.
            OpenReconnect();
            return;
        }

        _refreshing = true;
        _error = null;
        try
        {
            await Register.RefreshStoreDataAsync();
            await LoadTillAsync();
            if (_screen == SaleScreen.NeedsShift && _context?.OpenShift is not null)
            {
                _screen = ShiftScreenForContext();
                _scanTicket++;
            }

            await OnRefreshed.InvokeAsync();
        }
        catch (HeadOfficeException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _refreshing = false;
            _moreOpen = false;
        }
    }

    private void StartShiftOpen()
    {
        if (_context is null)
        {
            _error = RegisterService.ContextUnavailableMessaging;
            return;
        }

        _shiftError = null;
        _shiftDialogOpen = true;
    }

    private void DismissShiftOpen()
    {
        if (!_openingShift)
        {
            _shiftDialogOpen = false;
        }
    }

    private async Task OpenShiftAsync(decimal openingFloat)
    {
        if (_context is null || _openingShift)
        {
            return;
        }

        _openingShift = true;
        _shiftError = null;
        try
        {
            _context = await Register.OpenShiftAsync(openingFloat, _context.BusinessDate);
            _contextError = null;
            _shiftDialogOpen = false;
            _screen = SaleScreen.Selling;
            _scanTicket++;
        }
        catch (HeadOfficeException ex)
        {
            _shiftError = ex.Message;
        }
        finally
        {
            _openingShift = false;
        }
    }

    private bool AddProduct(CatalogueItem item, bool silent = false)
    {
        if (item.Price is null || item.BaseUnitOfMeasureId is null)
        {
            if (!silent)
            {
                _error = "This product is missing a price or sale unit and cannot be added.";
            }

            return false;
        }

        SaleCartLine? existing = _cart.FirstOrDefault(line => line.Item.ProductId == item.ProductId);
        if (existing is null)
        {
            _cart.Add(new SaleCartLine(item));
        }
        else
        {
            existing.Quantity++;
        }

        DismissCompletionForNewBasket();
        _error = null;
        _heldPanelOpen = false;
        return true;
    }

    // The product browser's tile click. A void wrapper because EventCallback
    // bindings need Action/Func<Task> shapes, not a bool-returning method.
    private void AddProductToSale(CatalogueItem item) => AddProduct(item);

    private async Task AddFromBarcodeAsync()
    {
        string code = _barcode.Trim();
        if (code.Length == 0)
        {
            return;
        }

        CatalogueItem? match = _items.FirstOrDefault(item => string.Equals(item.Barcode, code, StringComparison.Ordinal));
        if (match is null)
        {
            BarcodeError = "No active product matches that barcode.";
        }
        else
        {
            BarcodeError = null;
            AddProduct(match);
            _barcode = string.Empty;
        }

        _scanTicket++;
        await Task.CompletedTask;
    }

    private void OnBarcodeChanged(string value) => _barcode = value;

    private int InSaleQuantity(Guid productId) => _cart.Sum(line => line.Item.ProductId == productId ? line.Quantity : 0);

    private void OnSearchChanged(string value) => _search = value;

    private void OnFamilyChanged(string? family)
    {
        _activeFamily = family;
        _search = string.Empty;
    }

    private void IncrementLine(Guid productId)
    {
        SaleCartLine? line = _cart.FirstOrDefault(l => l.Item.ProductId == productId);
        if (line is not null)
        {
            line.Quantity++;
            _selectedProductId = productId;
        }
    }

    private void DecrementLine(Guid productId)
    {
        SaleCartLine? line = _cart.FirstOrDefault(l => l.Item.ProductId == productId);
        if (line is null)
        {
            return;
        }

        line.Quantity--;
        if (line.Quantity <= 0)
        {
            RemoveLine(productId);
        }
        else
        {
            _selectedProductId = productId;
        }
    }

    private void EditQuantity(Guid productId)
    {
        SaleCartLine? line = _cart.FirstOrDefault(l => l.Item.ProductId == productId);
        if (line is not null)
        {
            _selectedProductId = productId;
            _qtyTarget = line;
        }
    }

    private void CommitQuantity(int quantity)
    {
        if (_qtyTarget is null)
        {
            return;
        }

        _qtyTarget.Quantity = quantity;
        _qtyTarget = null;
        _error = null;
        _scanTicket++;
    }

    private void VoidSelected(Guid productId)
    {
        if (_cart.Count == 0)
        {
            _error = "Nothing to void — the till is empty.";
            return;
        }

        SaleCartLine? line = _cart.FirstOrDefault(l => l.Item.ProductId == productId);
        if (line is null)
        {
            _error = "That line is gone — select the line you want to void.";
            return;
        }

        RemoveLine(productId);
        _error = null;
    }

    private void RemoveLine(Guid productId)
    {
        _cart.RemoveAll(line => line.Item.ProductId == productId);
        if (_selectedProductId == productId)
        {
            _selectedProductId = null;
        }

        if (_qtyTarget?.Item.ProductId == productId)
        {
            _qtyTarget = null;
        }
    }

    private void ClearCart()
    {
        _cart.Clear();
        _selectedProductId = null;
        _qtyTarget = null;
        _error = null;
        _scanTicket++;
    }

    private void HoldSale()
    {
        if (_cart.Count == 0)
        {
            _error = "Hold an item first — the till has nothing to hold.";
            return;
        }

        string id = $"#H{(_heldSales.Count + 1):000}";
        _heldSales.Insert(
            0,
            new HeldSale(
                id,
                DateTimeOffset.UtcNow,
                [.. _cart.Select(line => new SaleCartLine(line.Item, line.Quantity))]));

        _cart.Clear();
        _selectedProductId = null;
        _qtyTarget = null;
        _error = null;
        _scanTicket++;
    }

    private async Task OpenHeldAsync()
    {
        if (_heldSales.Count == 0)
        {
            _error = "Nothing held yet. Hold a sale first with F6.";
            return;
        }

        if (_cart.Count > 0)
        {
            _error = "Clear the current sale before recalling a held one.";
            return;
        }

        _heldPanelOpen = true;
        _error = null;
        await Task.CompletedTask;
    }

    private async Task RecallHeldAsync(HeldSale held)
    {
        _cart.AddRange(held.Lines.Select(line => new SaleCartLine(line.Item, line.Quantity)));
        _heldSales.Remove(held);
        _heldPanelOpen = false;
        _error = null;
        _scanTicket++;
        await Task.CompletedTask;
    }

    private void ToggleDiscount() => _discountOpen = !_discountOpen;

    private void BeginPayment()
    {
        if (_cart.Count == 0)
        {
            return;
        }

        if (_context?.OpenShift is null)
        {
            _error = "Open a shift before taking payment.";
            return;
        }

        _cashTicket++;
        _screen = SaleScreen.Payment;
        _error = null;
    }

    private async Task BackToCartAsync()
    {
        _screen = SaleScreen.Selling;
        _error = null;
        _scanTicket++;
        await Task.CompletedTask;
    }

    private async Task CompleteSaleAsync(RegisterPaymentInput payment)
    {
        if (_context?.OpenShift is not { } shift || _screen != SaleScreen.Payment)
        {
            return;
        }

        _screen = SaleScreen.Completing;
        _error = null;
        try
        {
            List<RegisterSaleLine> lines = [.. _cart.Select(line => new RegisterSaleLine(
                line.Item.ProductId,
                line.Item.BaseUnitOfMeasureId!.Value,
                line.Item.Barcode,
                line.Quantity,
                line.Item.Sku,
                line.Item.Name,
                line.Item.Price!.Value))];

            List<RegisterSalePayment> payments =
            [
                new RegisterSalePayment(payment.Method, payment.Amount, payment.Tendered, payment.ProviderReference),
            ];

            _lastSale = await Register.CompleteSaleAsync(
                shift.ShiftId,
                shift.BusinessDate,
                _customer?.Id,
                lines,
                payments,
                _customer?.DisplayName);

            _changeDue = payment.Method == PaymentMethod.Cash && payment.Tendered is { } tendered && tendered > NetTotal
                ? RoundToIncrement(tendered - NetTotal)
                : null;

            decimal? completedSaleChange = _changeDue;

            // Return directly to a fresh basket. The slim completion strip keeps
            // the sale number and change visible without replacing the cart.
            StartNextSale();
            _changeDue = completedSaleChange;
            _completionNoticeOpen = true;

            if (_context?.IsOffline == true && !_lastSale.IsOffline)
            {
                // Head office answered again: send what was kept offline and
                // trade through it from here on.
                await TryReturnOnlineAsync();
            }
            else if (_context is { IsOffline: false } && _lastSale.IsOffline)
            {
                // Head office stopped answering mid-sale: show the till as
                // offline, which also starts the check for its return.
                try
                {
                    _context = await Register.GetCheckoutContextAsync();
                }
                catch (HeadOfficeException)
                {
                    // Keep the context the sale was made under.
                }
            }

            await OnRefreshed.InvokeAsync();
        }
        catch (HeadOfficeException ex)
        {
            _error = ex.Message;
            _screen = SaleScreen.Payment;
        }
    }

    private void StartNextSale()
    {
        _cart.Clear();
        _selectedProductId = null;
        _qtyTarget = null;
        _discountOpen = false;
        _customer = null;
        _search = string.Empty;
        _activeFamily = null;
        _barcode = string.Empty;
        BarcodeError = null;
        _error = null;
        _changeDue = null;
        _receiptOpen = false;
        _receiptAfterSale = false;
        _completionNoticeOpen = false;
        _screen = ShiftScreenForContext();
        _scanTicket++;
    }

    private async Task SignOutAsync()
    {
        await Register.SignOutAsync();
        await OnSignedOut.InvokeAsync();
    }

    private void OpenMoreAsync()
    {
        _moreOpen = !_moreOpen;
        _error = null;
    }

    private void CloseMore() => _moreOpen = false;

    private async Task MoreHeldAsync()
    {
        _moreOpen = false;
        await OpenHeldAsync();
    }

    private async Task MoreReturnsAsync()
    {
        _moreOpen = false;
        if (!CanReturn || _context?.OpenShift is null)
        {
            return;
        }

        _returnsOpen = true;
        _error = null;
        await Task.CompletedTask;
    }

    private void DismissReturns() => _returnsOpen = false;

    private async Task MoreCloseShiftAsync()
    {
        _moreOpen = false;
        if (_context?.OpenShift is not { } shift || (!CanCloseShift && !CanCloseOtherShift) || _closingShift)
        {
            return;
        }

        _closingShift = true;
        _shiftCloseError = null;
        try
        {
            _shiftSummary = await Register.GetShiftSummaryAsync(shift.ShiftId);
            _shiftCloseOpen = true;
        }
        catch (HeadOfficeException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _closingShift = false;
        }
    }

    private void DismissShiftClose()
    {
        if (!_closingShift)
        {
            _shiftCloseOpen = false;
            _shiftSummary = null;
            _shiftCloseError = null;
        }
    }

    private async Task ConfirmShiftCloseAsync((decimal Declared, decimal Counted) drawer)
    {
        if (_context?.OpenShift is not { } shift || _closingShift)
        {
            return;
        }

        _closingShift = true;
        _shiftCloseError = null;
        try
        {
            await Register.CloseShiftAsync(shift.ShiftId, drawer.Declared, drawer.Counted);
            _shiftCloseOpen = false;
            _shiftSummary = null;
            _cart.Clear();
            _selectedProductId = null;
            _qtyTarget = null;
            _customer = null;
            _error = null;
            _context = await Register.GetCheckoutContextAsync();
            _contextError = null;
            _screen = ShiftScreenForContext();
        }
        catch (HeadOfficeException ex)
        {
            _shiftCloseError = ex.Message;
        }
        finally
        {
            _closingShift = false;
        }
    }

    private async Task MoreReprintAsync()
    {
        _moreOpen = false;
        await ShowReceiptAsync(afterSale: false);
    }

    private Task OpenOriginalReceiptAsync() => ShowReceiptAsync(afterSale: true);

    /// <summary>Fetches the last completed sale's receipt and shows it in the right pane.</summary>
    private async Task ShowReceiptAsync(bool afterSale)
    {
        if (_lastSale is null || (!afterSale && !CanReprint))
        {
            // The receipt of the sale just completed is the cashier's own and is
            // always shown; reprinting an older sale from the menu needs the permission.
            return;
        }

        _receiptAfterSale = afterSale;
        _receiptOpen = true;
        _receiptBusy = true;
        _receiptError = null;
        _receiptText = string.Empty;
        await InvokeAsync(StateHasChanged);
        try
        {
            _receiptText = afterSale
                ? await Register.GetOriginalReceiptTextAsync(_lastSale)
                : await Register.ReprintReceiptTextAsync(_lastSale, "Reprinted from the register menu");
        }
        catch (HeadOfficeException ex)
        {
            _receiptError = ex.Message;
        }
        finally
        {
            _receiptBusy = false;
        }
    }

    private Task RetryReceiptAsync() => ShowReceiptAsync(_receiptAfterSale);

    private void CloseReceipt()
    {
        _receiptOpen = false;
        _receiptAfterSale = false;
    }

    private void DismissCompletionNotice()
    {
        _completionNoticeOpen = false;
        _changeDue = null;

        if (_receiptAfterSale)
        {
            CloseReceipt();
        }
    }

    /// <summary>
    /// The first item is the cashier's intent to move on. Retire the previous
    /// sale's confirmation and any receipt preview so the live cart is visible.
    /// </summary>
    private void DismissCompletionForNewBasket()
    {
        _completionNoticeOpen = false;
        _changeDue = null;

        if (_receiptOpen)
        {
            CloseReceipt();
        }
    }

