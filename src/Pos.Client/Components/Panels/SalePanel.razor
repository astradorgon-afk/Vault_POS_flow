    private Task<AcceptedRegisterReturn> AcceptReturnAsync(Guid saleId, IReadOnlyList<RegisterReturnLine> lines)
    {
        if (_context?.OpenShift is not { } shift || _context is null)
        {
            return Task.FromException<AcceptedRegisterReturn>(new HeadOfficeException("Open a shift before returning items."));
        }

