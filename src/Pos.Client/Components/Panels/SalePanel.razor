    private Task<Guid> RefundReturnAsync(Guid returnId, PaymentMethod method, decimal amount, decimal? tendered, string? providerReference)
    {
        if (_context?.OpenShift is not { } shift || _context is null)
        {
            return Task.FromException<Guid>(new HeadOfficeException("Open a shift before refunding."));
        }

        return Register.RefundReturnAsync(returnId, _returnsSaleId, shift.ShiftId, method, amount, tendered, providerReference);
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (_screen == SaleScreen.Gate || _screen == SaleScreen.Loading)
        {
            return;
        }

        switch (args.Key)
        {
            case "F2":
                if (_screen == SaleScreen.Selling && !_heldPanelOpen && !_moreOpen)
                {
                    _searchTicket++;
                }

                break;
            case "F3":
                if (_screen == SaleScreen.Selling && !_heldPanelOpen && !_moreOpen)
                {
                    var target = _selectedProductId is { } id
                        ? _cart.FirstOrDefault(line => line.Item.ProductId == id)
                        : null;
                    target ??= _cart.LastOrDefault();
                    if (target is not null)
                    {
                        _qtyTarget = target;
                    }
                }

                break;
            case "F4":
                if (_screen == SaleScreen.Selling)
                {
                    ToggleDiscount();
                }

                break;
            case "F6":
                if (_screen == SaleScreen.Selling)
                {
                    HoldSale();
                }

                break;
            case "F7":
                if (_screen == SaleScreen.Selling)
                {
                    await OpenHeldAsync();
                }

                break;
            case "F8":
                if (_screen == SaleScreen.Selling)
                {
                    if (_selectedProductId is { } selectedId)
                    {
                        VoidSelected(selectedId);
                    }
                    else if (_cart.Count > 0)
                    {
                        VoidSelected(_cart[^1].Item.ProductId);
                    }
                }

                break;
            case "F9":
                if (_screen == SaleScreen.Selling && _cart.Count > 0)
                {
                    BeginPayment();
                }

                break;
            case "F10":
                if (_screen == SaleScreen.Payment && _payPanel is not null)
                {
                    await _payPanel.TryCompleteAsync();
                }

                break;
            case "Escape":
                HandleEscape();
                break;
        }
    }

    private void HandleEscape()
    {
        if (_reconnectOpen)
        {
            if (!_reconnecting)
            {
                _reconnectOpen = false;
            }

            return;
        }

        if (_screen == SaleScreen.Payment)
        {
            _screen = SaleScreen.Selling;
            _error = null;
            _scanTicket++;
            return;
        }

        if (_heldPanelOpen)
        {
            _heldPanelOpen = false;
            return;
        }

        if (_moreOpen)
        {
            _moreOpen = false;
            return;
        }

        if (_shiftDialogOpen)
        {
            DismissShiftOpen();
            return;
        }

        if (_shiftCloseOpen)
        {
            DismissShiftClose();
            return;
        }

        if (_returnsOpen)
        {
            _returnsOpen = false;
            return;
        }

        if (_receiptOpen)
        {
            CloseReceipt();
            return;
        }

        if (_completionNoticeOpen)
        {
            DismissCompletionNotice();
            return;
        }

        if (_customerDialogOpen)
        {
            _customerDialogOpen = false;
            return;
        }

        if (_qtyTarget is not null)
        {
            _qtyTarget = null;
            return;
        }

        if (_discountOpen)
        {
            _discountOpen = false;
            return;
        }

        if (_screen == SaleScreen.NeedsShift)
        {
            return;
        }

        _error = null;
    }

    private decimal RoundToIncrement(decimal amount)
    {
        decimal increment = _context?.CashRoundingIncrement ?? 0.01m;
        increment = increment > 0m ? increment : 0.01m;
        return decimal.Round(amount / increment, 0, MidpointRounding.AwayFromZero) * increment;
    }

    private static string PriceOf(decimal value)
        => value.ToString("C", CultureInfo.GetCultureInfo("en-PH"));
}
