{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
      // Optional: Structured logging sinks (uncomment and configure as needed)
      // Seq: https://getseq.net/ (centralized structured logging)
      // {
      //   "Name": "Seq",
      //   "Args": {
      //     "serverUrl": "https://seq.internal:5341",
      //     "apiKey": "" // Pass via environment: Serilog__WriteTo__1__Args__apiKey
      //   }
      // }
      // Splunk HTTP Event Collector
      // {
      //   "Name": "Http",
      //   "Args": {
      //     "requestUri": "https://splunk.internal:8088/services/collector",
      //     "headers": { "Authorization": "Splunk YOUR_TOKEN" }
      //   }
      // }
      // ELK Stack (via Serilog.Sinks.Elasticsearch)
      // {
      //   "Name": "Elasticsearch",
      //   "Args": {
      //     "nodeUris": [ "https://elasticsearch:9200" ],
      //     "indexFormat": "vaultflow-{0:yyyy.MM.dd}"
      //   }
      // }
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Seeding": {
    "EnableDevelopmentAccounts": false
  },
  "Jwt": {
    "Issuer": "https://vaultflow",
    "Audience": "vaultflow-api"
  },
  "BootstrapOwner": {
    "Enabled": false
  },
  "Security": {
    "RequireTwoFactorForAdmins": true
  },
  "AllowedHosts": "*"
}
