{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Seeding": {
    "EnableDevelopmentAccounts": false
  },
  "Jwt": {
    "Issuer": "https://vaultflow.local",
    "Audience": "vaultflow-api",
    "SigningKeyPem": "",
    "PreviousSigningKeyPem": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 30,
    "PinRefreshTokenHours": 12,
    "ClockSkewSeconds": 30
  },
  "Security": {
    "PasswordHashIterations": 600000,
    "MinimumPasswordLength": 12,
    "MinimumPinLength": 6,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "MaxPinAttemptsPerDevice": 5,
    "PinAttemptWindowMinutes": 5,
    "RequireTwoFactorForAdmins": true,
    "DeviceEnrolmentCodeMinutes": 15,
    "PermissionSnapshotHours": 72
  },
  "Organization": {
    "Name": "VaultFlow",
    "TimeZoneId": "Asia/Manila",
    "CurrencyCode": "PHP",
    "CashRoundingIncrement": 0.01,
    "ApprovalLimits": {
      "Tier1": 5000,
      "Tier2": 50000,
      "Tier3": 250000,
      "SelfApprovalLimit": 0
    }
  },
  "BootstrapOwner": {
    "Enabled": false,
    "UserName": "",
    "Email": "",
    "DisplayName": "Owner",
    "Password": ""
  },
  "RateLimits": {
    "LoginPermitLimit": 10,
    "LoginWindowMinutes": 5,
    "RefreshPermitLimit": 30,
    "RefreshWindowMinutes": 60,
    "SyncPushPermitLimit": 60,
    "GlobalPermitLimit": 300
  },
  "Reconciliation": {
    "Enabled": true,
    "IntervalHours": 24,
    "RunOnStartup": false
  },
  "ShiftForceClose": {
    "Enabled": true,
    "IntervalHours": 1,
    "RunOnStartup": true
  },
  "Maintenance": {
    "AllowBalanceRebuild": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
