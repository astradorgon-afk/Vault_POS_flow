{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Organization": {
    "TimeZoneId": "Asia/Manila",
    "CurrencyCode": "PHP",
    "CashRoundingIncrement": 0.01
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
